<UserControl x:Class="ZeroMix.Wallpapers.WallpapersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ZeroMix.Wallpapers"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <!--  Premium Palette -->
        <Color x:Key="NeonAccentColor">#00FFA3</Color> <!-- Vibrant Mint/Neon -->
        <Color x:Key="DeepBg">#050507</Color>
        <Color x:Key="GlassBg">#1A1A1E</Color>
        <Color x:Key="CardOverlay">#33000000</Color>
        
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource NeonAccentColor}"/>
        <SolidColorBrush x:Key="DeepBrush" Color="{StaticResource DeepBg}"/>
        <SolidColorBrush x:Key="GlassBrush" Color="{StaticResource GlassBg}"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#8E8E93"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>

        <!-- Custom ScrollBar Styling -->
        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" 
                                     Maximum="{TemplateBinding ScrollableHeight}" 
                                     Value="{TemplateBinding VerticalOffset}" 
                                     ViewportSize="{TemplateBinding ViewportHeight}" 
                                     Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                     Width="2" Margin="0,5,2,5">
                                <ScrollBar.Template>
                                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                                        <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent" Opacity="0.3">
                                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                                <Track.Thumb>
                                                    <Thumb x:Name="Thumb">
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                                <Border Background="{StaticResource AccentBrush}" CornerRadius="2"/>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ScrollBar.Template>
                            </ScrollBar>    
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Premium Button Styles -->
        <Style x:Key="SleekBtn" TargetType="Button">
            <Setter Property="Background" Value="#121214"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A2A2E"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1A1E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ApplyBtn" BasedOn="{StaticResource SleekBtn}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#050507"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterChip" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="chip" Background="Transparent" CornerRadius="15" Padding="15,6" BorderThickness="1" BorderBrush="#2A2A2E" Margin="0,0,8,0">
                            <TextBlock x:Name="txt" Text="{TemplateBinding Content}" Foreground="{StaticResource SubTextBrush}" FontSize="12" FontWeight="Medium"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#1A00FFA3"/>
                                <Setter TargetName="chip" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="txt" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="0" Background="Transparent" BorderThickness="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: Glassy & Dynamic -->
            <Border Grid.Row="0" Padding="0,15,0,25" Background="Transparent">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="PERSONALIZATION" FontWeight="Black" Foreground="{StaticResource AccentBrush}" FontSize="10" Padding="2" Margin="0,0,0,8"/>
                        <TextBlock Text="Vault Art Nexus" FontSize="26" FontWeight="ExtraBold" Foreground="White" />
                        
                        <Grid Margin="0,25,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Premium Filter Chips -->
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Everything" x:Name="FilterAll" IsChecked="True" Style="{StaticResource FilterChip}" Click="Filter_Click"/>
                                <RadioButton Content="Static Visuals" x:Name="FilterImages" Style="{StaticResource FilterChip}" Click="Filter_Click"/>
                                <RadioButton Content="Motion Canvas" x:Name="FilterVideos" Style="{StaticResource FilterChip}" Click="Filter_Click"/>
                            </StackPanel>

                            <!-- Modern Search Bar -->
                            <Border Grid.Column="1" Background="#1A1A1E" CornerRadius="15" Padding="12,0" Width="220" BorderBrush="#2A2A2E" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
                                    <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" 
                                             VerticalAlignment="Center" FontSize="12" CaretBrush="{StaticResource AccentBrush}"
                                             TextChanged="SearchBox_TextChanged"/>
                                    <TextBlock Text="Search art..." Grid.Column="1" Foreground="#4A5568" IsHitTestVisible="False" VerticalAlignment="Center" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock x:Name="CountLabel" Text="0 Assets" VerticalAlignment="Center" Margin="0,0,0,0" Foreground="{StaticResource SubTextBrush}" FontSize="11" FontWeight="Bold"/>
                        <!-- Removed Close/Minimize buttons as they are not needed in UserControl -->
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Gallery Area -->
            <ScrollViewer Grid.Row="1" Padding="5,5,15,5">
                <ItemsControl x:Name="WallpaperListPanel">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="15">
                                <Border x:Name="CardBorder" CornerRadius="15" Background="#121214" BorderBrush="#2A2A2E" BorderThickness="1" ClipToBounds="True" MouseLeftButtonUp="WallpaperBorder_MouseLeftButtonUp">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1" CenterX="120" CenterY="67.5"/>
                                    </Border.RenderTransform>
                                    <Grid>
                                        <!-- Thumbnail with hover blur effect -->
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Width="240" Height="135">
                                                <Image.Effect>
                                                    <BlurEffect Radius="0" x:Name="ImgBlur"/>
                                                </Image.Effect>
                                            </Image>
                                            <Border x:Name="HoverOverlay" Background="#99000000" Opacity="0">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="PREVIEW" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Bottom Name Tag -->
                                        <Border VerticalAlignment="Bottom" Padding="15,10" Background="#CC121214">
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        </Border>

                                        <!-- Selected Badge -->
                                        <Border x:Name="SelectionFrame" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2.5" CornerRadius="15" Visibility="Collapsed"/>
                                        <Border x:Name="SelectionIndicator" Width="10" Height="10" Background="{StaticResource AccentBrush}" CornerRadius="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Visibility="Collapsed">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="{StaticResource NeonAccentColor}"/>
                                            </Border.Effect>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="SelectionFrame" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.04" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.04" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="CardBorder" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- Bottom Console Footer -->
            <Border Grid.Row="2" Padding="0,30,0,0" Background="Transparent" BorderThickness="0,1,0,0" BorderBrush="#1F1F23">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SYSTEM STATUS" Foreground="{StaticResource SubTextBrush}" FontSize="9" FontWeight="Black" Padding="1"/>
                        <TextBlock x:Name="StatusLabel" Text="Nexus core synchronized. Waiting for user input." Foreground="White" FontSize="13" Margin="0,4,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BrowseButton" Content="IMPORT ART" Click="BrowseButton_Click" Style="{StaticResource SleekBtn}" Width="150" Margin="0,0,15,0"/>
                        <Button x:Name="SetWallpaperButton" Content="APPLY TO DESKTOP" Click="SetWallpaperButton_Click" Style="{StaticResource ApplyBtn}" Width="180"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
