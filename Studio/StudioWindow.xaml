<Window x:Class="ZeroMix.Studio.StudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeroMix Studio"
        Height="700"
        Width="1200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowState="Normal"
        WindowStartupLocation="CenterScreen"
        MinWidth="900" 
        MinHeight="600"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Plugins/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Local Color Palette Override/Mapping -->
            <SolidColorBrush x:Key="BgBrush" Color="#0B0E14"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#00FFA3"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#2D333F"/>

            <!-- Local Local Styles Removed -->
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>   <!-- Content -->
                <RowDefinition Height="5"/>    <!-- Splitter -->
                <RowDefinition Height="200" MinHeight="100" MaxHeight="500"/> <!-- Timeline/Controls -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Background="#05080A"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                            Margin="15,0"
                            VerticalAlignment="Center">
                        <Ellipse Width="6"
                                Height="6"
                                Fill="{StaticResource AccentBrush}"
                                Margin="0,0,10,0"/>
                        <TextBlock Text="ZEROMIX STUDIO"
                                FontSize="10"
                                FontWeight="Black"
                                Foreground="White"
                                Opacity="0.6"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                        <Button x:Name="FullscreenBtn"
                                Content="⛶"
                                Style="{StaticResource TitleBtn}"
                                Click="Fullscreen_Click"/>
                        <Button Content="−"
                                Style="{StaticResource TitleBtn}"
                                Click="Minimize_Click"/>
                        <Button Content="✕"
                                Style="{StaticResource TitleBtn}"
                                Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="SplitterColumn" Width="0"/>
                    <ColumnDefinition x:Name="SidebarColumn" Width="0"/>
                    <ColumnDefinition x:Name="PropertySidebarColumn" Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Video Queue -->
                <Border Grid.Column="0"
                        Background="#151921"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0"
                                Background="#0F172A"
                                Padding="12,10">
                            <TextBlock Text="VIDEO CLIPS"
                                    FontSize="9"
                                    FontWeight="Black"
                                    Foreground="{StaticResource AccentBrush}"/>
                        </Border>

                        <!-- Video Queue List -->
                        <ListBox x:Name="VideoQueueList"
                                Grid.Row="1"
                                Background="Transparent"
                                BorderThickness="0"
                                 Foreground="White"
                                Padding="8"
                                HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="VideoQueueList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E293B"
                                            CornerRadius="4"
                                            Margin="0,0,0,8"
                                            Padding="2"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1">
                                        <Grid Height="60">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Background="#0F172A"
                                                    CornerRadius="3"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="🎬"
                                                            FontSize="20"
                                                            HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                            Opacity="0.2"/>
                                                    <Image Source="{Binding Thumbnail}"
                                                            Stretch="UniformToFill"
                                                            Opacity="0.8"/>
                                                    <Border Background="#AA000000"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            Padding="3,1"
                                                            Margin="3">
                                                        <TextBlock Text="{Binding DurationStr}"
                                                                FontSize="7"
                                                                Foreground="White"
                                                                   FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0">
                                                <TextBlock Text="{Binding FileName}"
                                                        FontSize="10"
                                                        FontWeight="Bold"
                                                           Foreground="White"
                                                        TextTrimming="CharacterEllipsis"/>
                                                <Button Content="Remove"
                                                        Foreground="#FF6B6B"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        FontSize="8"
                                                        HorizontalAlignment="Left"
                                                        Click="RemoveFromQueue_Click"
                                                        Tag="{Binding}"
                                                        Cursor="Hand"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Add Media Button -->
                        <Border Grid.Row="2"
                                Padding="8"
                                Background="#0F172A">
                            <Button Content="+ ADD VIDEO"
                                    Style="{StaticResource PrimaryBtn}"
                                    Click="ImportVideo_Click"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="Black" ClipToBounds="True">
                    <Grid x:Name="PreviewContainer">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="PreviewScale" ScaleX="1.0" ScaleY="1.0"/>
                        </Grid.LayoutTransform>
                        <MediaElement x:Name="VideoPreview"
                                LoadedBehavior="Manual"
                                ScrubbingEnabled="True"
                                Volume="0.5"
                                Stretch="Uniform"
                                MediaEnded="VideoPreview_MediaEnded"/>
                        <!-- Hidden Audio Player for Background Music -->
                        <MediaElement x:Name="MusicPreview"
                                LoadedBehavior="Manual"
                                Volume="0.5"
                                Visibility="Collapsed"/>
                        <MediaElement x:Name="PixabayPreviewInternal"
                                LoadedBehavior="Manual"
                                Volume="0.5"
                                Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- Sidebar Splitter (untuk resize horizontal Pixabay) -->
                <GridSplitter x:Name="SidebarSplitter" Grid.Column="2" Width="5" Background="#1A1F2B" 
                              HorizontalAlignment="Center" VerticalAlignment="Stretch" Cursor="SizeWE"
                              Visibility="Collapsed"/>

                <!-- Pixabay Sidebar -->
                <Border x:Name="PixabaySidebar" Grid.Column="3" 
                        Background="#12161F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="🌐" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="PIXABAY MUSIC" FontWeight="Black" FontSize="9" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PixabaySearchBox" Height="28" Padding="8,0" VerticalContentAlignment="Center" Background="#0B0E14" Foreground="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" KeyDown="PixabaySearchBox_KeyDown"/>
                            <Button Grid.Column="1" Content="🔍" Width="32" Height="28" Margin="4,0,0,0" Style="{StaticResource CasualBtn}" Click="PixabaySearch_Click"/>
                        </Grid>
                        
                        <!-- Pixabay Categories -->
                        <StackPanel Grid.Row="1" Margin="0,40,0,0">
                            <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,4">
                                <Button Content="Lo-fi" Padding="6,3" Margin="2" FontSize="8" Style="{StaticResource CasualBtn}" Click="PixabayCategory_Click" Tag="lofi chill"/>
                                <Button Content="Ambient" Padding="6,3" Margin="2" FontSize="8" Style="{StaticResource CasualBtn}" Click="PixabayCategory_Click" Tag="ambient"/>
                                <Button Content="Cinematic" Padding="6,3" Margin="2" FontSize="8" Style="{StaticResource CasualBtn}" Click="PixabayCategory_Click" Tag="cinematic"/>
                                <Button Content="Electronic" Padding="6,3" Margin="2" FontSize="8" Style="{StaticResource CasualBtn}" Click="PixabayCategory_Click" Tag="electronic"/>
                                <Button Content="Chill" Padding="6,3" Margin="2" FontSize="8" Style="{StaticResource CasualBtn}" Click="PixabayCategory_Click" Tag="chill relax"/>
                            </WrapPanel>
                            <WrapPanel HorizontalAlignment="Center">
                                <Button Content="Jazz" Padding="6,3" Margin="2" FontSize="8" Style="{StaticResource CasualBtn}" Click="PixabayCategory_Click" Tag="jazz"/>
                                <Button Content="Rock" Padding="6,3" Margin="2" FontSize="8" Style="{StaticResource CasualBtn}" Click="JazzRock_Click" Tag="rock"/>
                                <Button Content="Nature" Padding="6,3" Margin="2" FontSize="8" Style="{StaticResource CasualBtn}" Click="PixabayCategory_Click" Tag="nature"/>
                                <Button Content="Happy" Padding="6,3" Margin="2" FontSize="8" Style="{StaticResource CasualBtn}" Click="PixabayCategory_Click" Tag="happy upbeat"/>
                                <Button Content="Sad" Padding="6,3" Margin="2" FontSize="8" Style="{StaticResource CasualBtn}" Click="PixabayCategory_Click" Tag="sad emotional"/>
                            </WrapPanel>
                        </StackPanel>

                        <ListBox x:Name="PixabayResultsList" Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A1F2B" CornerRadius="6" Margin="0,0,0,8" Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Content="▶" Width="24" Height="24" Style="{StaticResource CasualBtn}" Margin="0,0,8,0" Click="PixabayPreview_Click" Tag="{Binding}"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding User}" FontSize="8" Opacity="0.5"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button x:Name="PixabayAddBtn" Grid.Row="3" Content="ADD SELECTED" Height="32" Margin="0,10,0,0" Style="{StaticResource PrimaryBtn}" Click="PixabayAdd_Click"/>
                    </Grid>
                </Border>

                <!-- Clip Properties Sidebar (NEW) -->
                <Border x:Name="PropertySidebar" Grid.Column="4" Background="#12161F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="CLIP SETTINGS" FontWeight="Black" FontSize="9" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,20"/>
                        
                        <StackPanel Grid.Row="1" x:Name="ClipSettingsPanel" Visibility="Collapsed">
                            <TextBlock Text="FADE EFFECTS" FontSize="8" Opacity="0.5" Margin="0,0,0,10"/>
                            <CheckBox x:Name="FadeInCheck" Content="Fade In (1s)" Foreground="White" Margin="0,0,0,8" Checked="ClipSetting_Changed" Unchecked="ClipSetting_Changed"/>
                            <CheckBox x:Name="FadeOutCheck" Content="Fade Out (1s)" Foreground="White" Margin="0,0,0,8" Checked="ClipSetting_Changed" Unchecked="ClipSetting_Changed"/>
                            
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,15"/>
                            <TextBlock Text="INFO" FontSize="8" Opacity="0.5" Margin="0,0,0,5"/>
                            <TextBlock x:Name="ClipInfoText" Text="No clip selected" FontSize="9" Foreground="#888" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Splitter (Atas-Bawah) -->
            <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#1A1F2B" ResizeDirection="Rows" ShowsPreview="True"/>

            <!-- Bottom Control Bar -->
            <Border Grid.Row="3"
                    Background="#0A0D14"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Timeline (TimeLamps) -->
                    <Border Grid.Row="0" Margin="0,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Background="#0F172A" Width="60">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="VIDEO" FontSize="7" FontWeight="Black" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,5"/>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Opacity="0.3" Margin="5,0"/>
                                    <TextBlock Text="AUDIO" FontSize="7" FontWeight="Black" Foreground="#FF9F0A" HorizontalAlignment="Center" Margin="0,5"/>
                                </StackPanel>
                            </Grid>
                            <ScrollViewer x:Name="TimelineScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Vertical" Margin="10,5">
                                    <ItemsControl x:Name="TimelineList" Margin="0,0,0,5">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="TimelineItem" Width="100" Height="50" Margin="0,0,10,0" Background="#1E293B" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Cursor="Hand" MouseLeftButtonDown="TimelineItem_MouseLeftButtonDown">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="🗑️ Hapus Video" Click="RemoveVideo_ContextMenu" Tag="{Binding}"/>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Grid>
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Opacity="0.5"/>
                                                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Orientation="Horizontal" Margin="2">
                                                            <Button Content="◀" Width="15" Height="15" FontSize="6" Padding="0" Margin="0,0,2,0" Style="{StaticResource CasualBtn}" Click="MoveClipLeft_Click" Tag="{Binding}"/>
                                                            <Button Content="▶" Width="15" Height="15" FontSize="6" Padding="0" Style="{StaticResource CasualBtn}" Click="MoveClipRight_Click" Tag="{Binding}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding DurationStr}" FontSize="7" FontWeight="Bold" Foreground="White" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="3"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    
                                    <!-- Audio Track -->
                                    <Border x:Name="MusicTimelineBar" Height="15" Background="#2A1F1F" CornerRadius="2" BorderBrush="#FF9F0A" BorderThickness="1" Visibility="Collapsed" HorizontalAlignment="Left">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="🗑️ Hapus Musik" Click="RemoveMusic_ContextMenu"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <TextBlock x:Name="MusicTimelineLabel" Text="♫ Selected Music" FontSize="8" Foreground="#FF9F0A" VerticalAlignment="Center" Margin="10,0"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Playback Controls -->
                    <Border Grid.Row="1"
                            Padding="12,8"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Playback & Edit Controls (Updated with your icons) -->
                            <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                                <Button Content="✂️" Width="30" Height="30" Style="{StaticResource CasualBtn}" Click="Cut_Click" Margin="0,0,4,0" ToolTip="Cut/Split"/>
                                <Button Content="📋" Width="30" Height="30" Style="{StaticResource CasualBtn}" Click="Copy_Click" Margin="0,0,4,0" ToolTip="Copy"/>
                                <Button Content="🗑️" Width="30" Height="30" Style="{StaticResource CasualBtn}" Click="RemoveFromIcons_Click" Margin="0,0,4,0" ToolTip="Delete"/>
                                <Button x:Name="QuickMuteBtn" Content="🔇" Width="30" Height="30" Style="{StaticResource CasualBtn}" Click="Mute_Click" Margin="0,0,10,0"/>
                                
                                <Button Content="⏮"
                                        Width="30"
                                        Height="30"
                                        Style="{StaticResource CasualBtn}"
                                        Click="JumpStart_Click"
                                        Margin="0,0,4,0"/>
                                <Button x:Name="PlayToggleBtn"
                                        Content="▶"
                                        Width="35"
                                        Height="30"
                                        Style="{StaticResource PrimaryBtn}"
                                        Click="TogglePlay_Click"
                                        Margin="0,0,4,0"/>
                                <Button Content="⏭"
                                        Width="30"
                                        Height="30"
                                        Style="{StaticResource CasualBtn}"
                                        Click="JumpEnd_Click"/>
                            </StackPanel>

                            <!-- Zoom & Duration Display -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                                <TextBlock Text="00:00 / 00:00" x:Name="DurationText" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                <Border Width="1" Height="20" Background="{StaticResource BorderBrush}" Margin="15,0"/>
                                <TextBlock Text="🔍" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Slider x:Name="ZoomSlider" Width="80" Minimum="0.5" Maximum="2.0" Value="1.0" VerticalAlignment="Center" ValueChanged="ZoomSlider_ValueChanged"/>
                                <Border Width="1" Height="20" Background="{StaticResource BorderBrush}" Margin="15,0"/>
                                <TextBlock Text="✨" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="FilterCombo" Width="80" FontSize="9" SelectedIndex="0" VerticalAlignment="Center" SelectionChanged="FilterCombo_SelectionChanged">
                                    <ComboBoxItem Content="No Filter" Tag=""/>
                                    <ComboBoxItem Content="Black &amp; White" Tag="grayscale"/>
                                    <ComboBoxItem Content="Sepia" Tag="sepia"/>
                                    <ComboBoxItem Content="Cine" Tag="cine"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Music Section -->
                            <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,15,0">
                                <TextBlock x:Name="MusicInfoLabel"
                                        Text="♫ No music"
                                        FontSize="9"
                                            Foreground="#888"
                                        VerticalAlignment="Center"/>
                                <Button Content="🎵 LOCAL"
                                        Style="{StaticResource CasualBtn}"
                                        Click="SelectMusic_Click"
                                        Margin="8,0,0,0"
                                        Padding="8,4"
                                        FontSize="8"/>
                                <Button Content="🌐 PIXABAY"
                                        Style="{StaticResource CasualBtn}"
                                        Click="SelectPixabayMusic_Click"
                                        Margin="4,0,0,0"
                                        Padding="8,4"
                                        FontSize="8"
                                        Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>

                            <!-- Volume Control -->
                            <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                                <Button x:Name="MuteBtn"
                                        Content="🔊"
                                        FontSize="11"
                                        Style="{StaticResource CasualBtn}"
                                        BorderThickness="0"
                                        Padding="0"
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0"
                                        Click="Mute_Click"/>
                                <Slider x:Name="VolumeSlider"
                                        Width="60"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="50"
                                        VerticalAlignment="Center"
                                        ValueChanged="Volume_Changed"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Export Section -->
                    <Border Grid.Row="2"
                            Padding="12,8"
                            Background="#0F172A">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                                <StackPanel x:Name="ExportProgressPanel"
                                        Visibility="Collapsed"
                                        Orientation="Horizontal">
                                    <ProgressBar x:Name="ExportProgressBar"
                                            Width="150"
                                            Height="3"
                                                  Foreground="{StaticResource AccentBrush}"
                                            Background="#1A1F2B"
                                                  BorderThickness="0"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"/>
                                    <TextBlock x:Name="ExportStatusText"
                                            Text="Processing..."
                                            FontSize="8"
                                               Foreground="#888"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <Button x:Name="ExportButton"
                                    Grid.Column="1"
                                    Content="EXPORT"
                                    Style="{StaticResource PrimaryBtn}"
                                    Width="120"
                                    Height="32"
                                    Click="ExportButton_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
