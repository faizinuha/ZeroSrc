<Window x:Class="ZeroMix.StudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
         Title="ZeroMix Studio" Height="650" Width="1000" 
         WindowStyle="None" AllowsTransparency="True" Background="Transparent"
         ResizeMode="NoResize" 
         WindowState="Normal"
         WindowStartupLocation="CenterScreen" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- Elegant Dark Palette (Premium & Light on Resources) -->
        <SolidColorBrush x:Key="BgBrush" Color="#0B0E14"/>        <!-- Deepest black/blue -->
        <SolidColorBrush x:Key="SidebarBrush" Color="#151921"/>   <!-- Subtle panel color -->
        <SolidColorBrush x:Key="AccentBrush" Color="#00FFA3"/>    <!-- Neon green accent -->
        <SolidColorBrush x:Key="BorderBrush" Color="#2D333F"/>    <!-- Elegant separator -->
        <SolidColorBrush x:Key="TextBrush" Color="#3384d4ff"/>      <!-- Crisp white -->
        <SolidColorBrush x:Key="SubTextBrush" Color="#94A3B8"/>   <!-- Soft grey for hierarchy -->

        <!-- High Contrast ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1F2B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1A1F2B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StudioBtn" TargetType="Button">
            <Setter Property="Tag" Value="4"/>
            <Setter Property="Background" Value="#1A1F2B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="{TemplateBinding Tag}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252B3B"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExportBtn" BasedOn="{StaticResource StudioBtn}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseBtn" BasedOn="{StaticResource TitleBarBtn}" TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A1F2B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>    <!-- Title Bar -->
                <RowDefinition Height="*"/>     <!-- Main Content (Sidebar, Assets, Preview) -->
                <RowDefinition Height="Auto"/>   <!-- Spacer/Border -->
                <RowDefinition Height="180"/>   <!-- Bottom: Timeline & Properties -->
            </Grid.RowDefinitions>

            <!-- 0. CUSTOM TITLE BAR -->
            <Border Grid.Row="0" Background="#05080A" CornerRadius="8,8,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="15,0">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="ZEROMIX STUDIO" VerticalAlignment="Center" 
                                   FontSize="9" FontWeight="Black" Foreground="White" Opacity="0.5"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="" FontFamily="Segoe MDL2 Assets" FontSize="10" Style="{StaticResource TitleBarBtn}" Click="Minimize_Click"/>
                        <Button Content="" FontFamily="Segoe MDL2 Assets" FontSize="10" Style="{StaticResource CloseBtn}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1. MAIN CONTENT AREA (Sidebar + Assets + Preview) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65"/>  <!-- Left Sidebar (Icons) -->
                    <ColumnDefinition Width="320"/> <!-- Asset / Library Panel -->
                    <ColumnDefinition Width="*"/>   <!-- Large Preview -->
                </Grid.ColumnDefinitions>

                <!-- 1a. LEFT SIDEBAR (Icon Based) -->
                <Border Grid.Column="0" Background="#0A0D14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <StackPanel Margin="0,20">
                        <Button x:Name="MediaTabBtn" Content="📂" FontSize="18" Padding="0,15" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentBrush}" Opacity="0.9" Click="Sidebar_Click" Tag="Media"/>
                        <Button x:Name="LibraryTabBtn" Content="🎵" FontSize="18" Padding="0,15" Background="Transparent" BorderThickness="0" Foreground="White" Opacity="0.7" Click="Sidebar_Click" Tag="Stock"/>
                        <Button x:Name="EffectsTabBtn" Content="🪄" FontSize="18" Padding="0,15" Background="Transparent" BorderThickness="0" Foreground="White" Opacity="0.7" Click="Sidebar_Click" Tag="Effects"/>
                        <Button Content="📝" FontSize="18" Padding="0,15" Background="Transparent" BorderThickness="0" Foreground="White" Opacity="0.7" ToolTip="Subtitles"/>
                    </StackPanel>
                </Border>

                <!-- 1b. ASSET / LIBRARY PANEL (Grouped) -->
                <Border Grid.Column="1" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Tab Header Style -->
                        <Border Grid.Row="0" Background="#141B26" Padding="15,12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ASSETS" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Black" Margin="0,0,15,0"/>
                                <TextBlock Text="STOCK" Foreground="White" Opacity="0.4" FontSize="10" FontWeight="Black"/>
                            </StackPanel>
                        </Border>

                        <!-- Storyboard & Music Results -->
                        <Grid Grid.Row="1">
                            <!-- Storyboard View (Default) -->
                            <Grid x:Name="StoryboardView">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ListBox x:Name="VideoQueueList" Background="Transparent" BorderThickness="0" 
                                         Foreground="White" Padding="10" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="VideoQueueList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1E293B" CornerRadius="6" Margin="0,0,0,10" Padding="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                <Grid Height="70">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <Border Grid.Column="0" Background="#0F172A" CornerRadius="4" ClipToBounds="True">
                                                        <Grid>
                                                            <TextBlock Text="🎬" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.2"/>
                                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Opacity="0.8"/>
                                                            <Border Background="#AA000000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="4,1" Margin="4">
                                                                <TextBlock Text="{Binding DurationStr}" FontSize="8" Foreground="White" FontWeight="Bold"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                                        <TextBlock Text="{Binding FileName}" FontSize="11" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                        <Button Content="Remove" Foreground="#FF6B6B" Background="Transparent" BorderThickness="0" FontSize="9" HorizontalAlignment="Left" Click="RemoveFromQueue_Click" Tag="{Binding}" Cursor="Hand"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Grid.Row="1" Padding="15" Background="#0F172A">
                                    <Button Content="+ ADD MEDIA" Style="{StaticResource ExportBtn}" Height="38" Click="ImportVideo_Click"/>
                                </Border>
                            </Grid>

                            <!-- Stock Music View (Hidden by Default) -->
                            <Grid x:Name="LibraryPanel" Visibility="Collapsed" Background="{StaticResource SidebarBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="15,10">
                                    <TextBlock Text="SEARCH STOCK MUSIC" FontSize="8" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="MusicSearchTxt" Height="28" FontSize="11" Padding="5,2" VerticalContentAlignment="Center" KeyDown="MusicSearchTxt_KeyDown"/>
                                        <Button Grid.Column="1" Content="🔍" Width="30" Height="28" Style="{StaticResource StudioBtn}" Click="MusicSearch_Click" Margin="5,0,0,0"/>
                                    </Grid>
                                    
                                    <TextBlock Text="QUICK FILTERS" FontSize="8" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <Button Content="Lofi" Style="{StaticResource StudioBtn}" Padding="10,4" FontSize="9" Margin="0,0,5,5" Click="SearchPixabay_Click" Tag="lofi hip hop"/>
                                        <Button Content="Chill" Style="{StaticResource StudioBtn}" Padding="10,4" FontSize="9" Margin="0,0,5,5" Click="SearchPixabay_Click" Tag="ambient chill"/>
                                        <Button Content="Epic" Style="{StaticResource StudioBtn}" Padding="10,4" FontSize="9" Margin="0,0,5,5" Click="SearchPixabay_Click" Tag="cinematic"/>
                                    </WrapPanel>
                                    <Button Content="✕ Close Library" Background="Transparent" Foreground="{StaticResource SubTextBrush}" BorderThickness="0" FontSize="9" Margin="0,5,0,0" HorizontalAlignment="Left" Click="ToggleLibrary_Click"/>
                                    <TextBlock x:Name="LibraryStatusText" Text="Ready" FontSize="8" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" Margin="0,-12,0,0" Opacity="0.5"/>
                                </StackPanel>
                                <ListBox x:Name="PixabayMusicList" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="10">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#141B26" CornerRadius="4" Margin="0,0,0,10" Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="40" Height="40" Background="#0F172A" CornerRadius="4">
                                                        <Grid>
                                                            <TextBlock Text="🎵" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3"/>
                                                            <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" Opacity="0.7"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Tags}" FontSize="10" FontWeight="Bold" Foreground="White" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding DurationStr}" FontSize="8" Foreground="{StaticResource SubTextBrush}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="+" Style="{StaticResource ExportBtn}" Width="30" Height="30" Click="ApplyPixabayMusic_Click" Tag="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <!-- Visual Effects View (Hidden by Default) -->
                            <Grid x:Name="EffectsPanel" Visibility="Collapsed" Background="{StaticResource SidebarBrush}">
                                <StackPanel Margin="15">
                                    <TextBlock Text="VISUAL EFFECTS" FontSize="8" FontWeight="Black" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,15"/>
                                    
                                    <TextBlock Text="Brightness" FontSize="10" Foreground="White" Margin="0,0,0,5"/>
                                    <Slider x:Name="BrightnessSlider" Minimum="-1" Maximum="1" Value="0" Margin="0,0,0,15" ValueChanged="RealTimeFilters_Changed"/>

                                    <TextBlock Text="Contrast" FontSize="10" Foreground="White" Margin="0,0,0,5"/>
                                    <Slider x:Name="ContrastSlider" Minimum="0" Maximum="2" Value="1" Margin="0,0,0,15" ValueChanged="RealTimeFilters_Changed"/>
                                    
                                    <TextBlock Text="Filters" FontSize="10" Foreground="White" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="FilterSelector" SelectedIndex="0" Height="28" SelectionChanged="RealTimeFilters_Changed">
                                        <ComboBoxItem Content="No Filter" Tag="None"/>
                                        <ComboBoxItem Content="B&amp;W" Tag="BW"/>
                                        <ComboBoxItem Content="Sepia" Tag="Sepia"/>
                                        <ComboBoxItem Content="Vivid" Tag="Vivid"/>
                                        <ComboBoxItem Content="Cold" Tag="Cold"/>
                                        <ComboBoxItem Content="Cyberpunk" Tag="Cyberpunk"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 1c. LARGE PREVIEW AREA -->
                <Border Grid.Column="2" Background="Black">
                    <Grid>
                        <Grid x:Name="VideoContainer">
                            <MediaElement x:Name="VideoPreview" LoadedBehavior="Manual" ScrubbingEnabled="True" 
                                          Volume="0.5" Stretch="Uniform" />
                            <Border x:Name="FilterOverlay" IsHitTestVisible="False" Opacity="0"/>
                            <Border x:Name="BrightnessOverlay" Background="White" IsHitTestVisible="False" Opacity="0"/>
                            <Border x:Name="ContrastOverlay" Background="Black" IsHitTestVisible="False" Opacity="0"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Spacer -->
            <Rectangle Grid.Row="2" Height="1" Fill="{StaticResource BorderBrush}" Margin="15,5"/>

            <!-- 3. PROFESSIONAL TIMELINE AREA (Like 123APPS) -->
            <Border Grid.Row="3" Background="#0A0D14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Playback Controls -->
                        <RowDefinition Height="*"/>    <!-- Visual Timeline -->
                        <RowDefinition Height="Auto"/> <!-- Export Bar -->
                    </Grid.RowDefinitions>

                    <!-- 3a. PLAYBACK CONTROLS (Top Bar) -->
                    <Border Grid.Row="0" Background="#0F1419" Padding="15,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Editing Tools -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Content="✂ Cut" Style="{StaticResource StudioBtn}" Width="70" Height="28" Margin="0,0,5,0" Click="CutClip_Click" ToolTip="Cut selected clip"/>
                                <Button Content="📋 Copy" Style="{StaticResource StudioBtn}" Width="70" Height="28" Margin="0,0,5,0" Click="CopyClip_Click" ToolTip="Duplicate clip"/>
                                <Button Content="🗑 Delete" Style="{StaticResource StudioBtn}" Width="70" Height="28" Click="DeleteClip_Click" ToolTip="Remove from timeline"/>
                                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="10,0"/>
                                <TextBlock x:Name="DurationText" Text="00:00 / 00:00" Foreground="White" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>

                            <!-- Center: Playback -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="⏮" FontSize="14" Width="35" Height="35" Style="{StaticResource StudioBtn}" Click="JumpStart_Click"/>
                                <Button x:Name="PlayToggleBtn" Content="▶" FontSize="18" Width="45" Height="35" Style="{StaticResource ExportBtn}" Click="TogglePlay_Click" Margin="8,0"/>
                                <Button Content="⏭" FontSize="14" Width="35" Height="35" Style="{StaticResource StudioBtn}" Click="JumpEnd_Click"/>
                            </StackPanel>

                            <!-- Right: Volume & Settings -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="🔊" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <Slider x:Name="VolumeSlider" Width="80" Minimum="0" Maximum="100" Value="50" VerticalAlignment="Center" ValueChanged="Volume_Changed"/>
                                <TextBlock x:Name="VolumeText" Text="50%" FontSize="10" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 3b. VISUAL TIMELINE (Horizontal Scrollable) -->
                    <Border Grid.Row="1" Background="#141B26" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Timeline Ruler -->
                            <Border Grid.Row="0" Height="20" Background="#0F1419" Margin="0,0,0,5">
                                <Canvas x:Name="TimelineRuler">
                                    <!-- Time markers will be drawn here dynamically -->
                                </Canvas>
                            </Border>

                            <!-- Scrollable Clip Track -->
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="TimelineTrack" Background="#1A1F2B">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" MinHeight="80"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#2D3748" CornerRadius="4" Margin="2" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Width="120" Height="70" Cursor="Hand" MouseLeftButtonDown="TimelineClip_Click">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    
                                                    <!-- Thumbnail -->
                                                    <Border Grid.Row="0" Background="Black" ClipToBounds="True">
                                                        <Grid>
                                                            <TextBlock Text="🎬" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.2"/>
                                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Opacity="0.9"/>
                                                        </Grid>
                                                    </Border>
                                                    
                                                    <!-- Info Bar -->
                                                    <Border Grid.Row="1" Background="#1A202C" Padding="4,2">
                                                        <TextBlock Text="{Binding DurationStr}" FontSize="9" Foreground="White" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>


                    <!-- 3c. EXPORT BAR (Bottom) -->
                    <Border Grid.Row="2" Background="#0F1419" Padding="15,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock x:Name="MusicInfoLabel" Text="♫ No music" FontSize="10" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <ComboBox x:Name="ResSelector" SelectedIndex="0" Width="120" Height="28" Margin="0,0,10,0">
                                    <ComboBoxItem Content="High (Source)"/>
                                    <ComboBoxItem Content="Medium (720p)"/>
                                </ComboBox>
                                <StackPanel x:Name="ExportProgressPanel" Visibility="Collapsed" Orientation="Horizontal" Margin="10,0">
                                    <ProgressBar x:Name="ExportProgressBar" Width="150" Height="4" Foreground="{StaticResource AccentBrush}" Background="#1A1F2B" BorderThickness="0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ExportStatusText" Text="Processing..." FontSize="9" Foreground="{StaticResource SubTextBrush}" Margin="10,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <Button x:Name="ExportButton" Grid.Column="1" Content="EXPORT PROJECT" Style="{StaticResource ExportBtn}" Width="180" Height="35" Click="ExportButton_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
