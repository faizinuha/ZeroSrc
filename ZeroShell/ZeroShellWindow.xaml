<Window x:Class="ZeroMix.ZeroShell.ZeroShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zero Terminal" 
        Height="700" Width="1200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        MouseDown="Window_MouseDown">

    <Grid>
        <Border x:Name="MainBorder" CornerRadius="16" Margin="12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F5101820" Offset="0"/>
                    <GradientStop Color="#F5080E14" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="Black" Opacity="0.6" ShadowDepth="0"/>
            </Border.Effect>

            <Grid x:Name="RootLayout">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition x:Name="NeofetchRow" Height="Auto" MaxHeight="250"/>
                    <RowDefinition x:Name="StatusBarRow" Height="42"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="TerminalRow" Height="*"/>
                    <RowDefinition Height="48"/>
                </Grid.RowDefinitions>

                <!-- TITLE BAR -->
                <Grid Grid.Row="0" Background="#18FFFFFF">
                    <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="#FFFF5F56" Margin="0,0,8,0"/>
                        <Ellipse Width="12" Height="12" Fill="#FFFFBD2E" Margin="0,0,8,0"/>
                        <Ellipse Width="12" Height="12" Fill="#FF27C93F" Margin="0,0,20,0"/>
                        <TextBlock Text="zero@terminal: ~" Foreground="#88FFFFFF" FontFamily="Consolas" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                        <Button Content="─" Width="32" Height="28" Background="Transparent" BorderBrush="Transparent" Foreground="#88FFFFFF" Click="MinimizeButton_Click" FontSize="13"/>
                        <Button Content="✕" Width="32" Height="28" Background="Transparent" BorderBrush="Transparent" Foreground="#88FF5F56" Click="CloseButton_Click" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <!-- NEOFETCH AREA -->
                <Grid x:Name="NeofetchArea" Grid.Row="1" Margin="30,20,30,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="12" Margin="0,0,25,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#15FFFFFF" Offset="0"/>
                                <GradientStop Color="#05FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Image x:Name="AnimeCharImage" Stretch="UniformToFill" VerticalAlignment="Bottom" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="CharPlaceholder">
                                <TextBlock Text="零" FontSize="80" Foreground="#2500D4FF" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Text="ZERO" Foreground="#25FFFFFF" FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock FontFamily="Consolas" FontSize="13" Margin="0,3"><Run Text=" 🖥 " Foreground="#FFFF6B6B"/><Run x:Name="OsInfoText" Text="Windows" Foreground="#EEEEEE"/></TextBlock>
                            <TextBlock FontFamily="Consolas" FontSize="13" Margin="0,3"><Run Text=" 🔧 " Foreground="#FFFF6B6B"/><Run x:Name="KernelText" Text="NT" Foreground="#CCCCCC"/></TextBlock>
                            <TextBlock FontFamily="Consolas" FontSize="13" Margin="0,3"><Run Text=" ⏱ " Foreground="#FFFF6B6B"/><Run x:Name="UptimeText" Text="--" Foreground="#CCCCCC"/></TextBlock>
                            <TextBlock Text="● ● ● ● ● ● ● ● ● ●" Foreground="#FFFF6B6B" FontSize="10" Margin="5,5,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock FontFamily="Consolas" FontSize="13" Margin="0,3"><Run Text=" 📦 " Foreground="#FFCC6BFF"/><Run x:Name="ShellText" Text="PowerShell" Foreground="#EEEEEE"/></TextBlock>
                            <TextBlock FontFamily="Consolas" FontSize="13" Margin="0,3"><Run Text=" 🎨 " Foreground="#FFCC6BFF"/><Run Text="ZeroMix Terminal" Foreground="#CCCCCC"/></TextBlock>
                            <TextBlock Text="◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆ ◆" Foreground="#FFCC6BFF" FontSize="10" Margin="5,5,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock FontFamily="Consolas" FontSize="13" Margin="0,3"><Run Text=" 💻 " Foreground="#FFFFDA6B"/><Run x:Name="CpuInfoText" Text="Loading..." Foreground="#EEEEEE"/></TextBlock>
                            <TextBlock FontFamily="Consolas" FontSize="13" Margin="0,3"><Run Text=" 🎮 " Foreground="#FFFFDA6B"/><Run x:Name="GpuInfoText" Text="Loading..." Foreground="#CCCCCC"/></TextBlock>
                            <TextBlock FontFamily="Consolas" FontSize="13" Margin="0,3"><Run Text=" 🧠 " Foreground="#FFFFDA6B"/><Run x:Name="RamInfoText" Text="Loading..." Foreground="#CCCCCC"/></TextBlock>
                            <TextBlock Text="▲ ▲ ▲ ▲ ▲ ▲ ▲ ▲ ▲ ▲" Foreground="#FFFFDA6B" FontSize="10" Margin="5,5,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="5,10,0,0">
                            <Border Width="22" Height="22" CornerRadius="4" Background="#FFFF6B6B" Margin="0,0,5,0"/>
                            <Border Width="22" Height="22" CornerRadius="4" Background="#FFFF9F43" Margin="0,0,5,0"/>
                            <Border Width="22" Height="22" CornerRadius="4" Background="#FFFFDA6B" Margin="0,0,5,0"/>
                            <Border Width="22" Height="22" CornerRadius="4" Background="#FF27C93F" Margin="0,0,5,0"/>
                            <Border Width="22" Height="22" CornerRadius="4" Background="#FF6BDDFF" Margin="0,0,5,0"/>
                            <Border Width="22" Height="22" CornerRadius="4" Background="#FFCC6BFF" Margin="0,0,5,0"/>
                            <Border Width="22" Height="22" CornerRadius="4" Background="#FFFF6BCA" Margin="0,0,5,0"/>
                            <Border Width="22" Height="22" CornerRadius="4" Background="#FFFFFFFF" Margin="0,0,5,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- STATUS BAR -->
                <Border x:Name="StatusBar" Grid.Row="2" Background="#12FFFFFF" Margin="20,0" CornerRadius="6" Padding="15,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#FF27C93F" CornerRadius="4" Padding="10,4" Margin="0,0,2,0">
                                <TextBlock x:Name="UserNameText" Text=" zero " FontFamily="Consolas" FontSize="11" Foreground="#111111" FontWeight="Bold"/>
                            </Border>
                            <Border Background="#FF6BDDFF" CornerRadius="0,4,4,0" Padding="10,4" Margin="0,0,15,0">
                                <TextBlock Text=" ~/zero-terminal " FontFamily="Consolas" FontSize="11" Foreground="#111111"/>
                            </Border>
                            <TextBlock x:Name="DateTimeText" Text="--" Foreground="#66FFFFFF" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="!help" Foreground="#44FFFFFF" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- TAB BAR -->
                <Border Grid.Row="3" Margin="20,8,20,0" Padding="0">
                    <StackPanel x:Name="TabBar" Orientation="Horizontal"/>
                </Border>

                <!-- TERMINAL CONTENT AREA -->
                <Grid Grid.Row="4" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- TERMINALS -->
                    <Grid x:Name="TerminalsContainer" Grid.Column="0" Margin="20,5,20,5"/>

                    <!-- SELECTION OVERLAY -->
                    <!-- SELECTION OVERLAY -->
                    <Border x:Name="SelectionOverlay" Grid.Column="0" Visibility="Collapsed" 
                            Background="#F0101820" CornerRadius="16" Margin="60,20" Padding="50,30"
                            BorderBrush="#FF6BDDFF" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.8" ShadowDepth="0"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="SelectionTitle" Text="SETTING" Foreground="#FFFFDA6B" FontWeight="Bold" FontSize="20" Margin="0,0,0,25" HorizontalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="10" Color="#FFFFDA6B" Opacity="0.3" ShadowDepth="0"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock x:Name="SelectionItems" Text="Loading..." Foreground="#EEEEEE" FontFamily="Consolas" FontSize="16" LineHeight="32" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Text="[ ↑ ↓ Pilih  |  Enter OK  |  Esc Batal ]" Foreground="#55FFFFFF" FontSize="12" Margin="0,25,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- INPUT -->
                <Border Grid.Row="5" Background="#10FFFFFF" Margin="20,0,20,12" CornerRadius="8" Padding="5,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PromptText" Text=" ~/zero ❯ " Foreground="#FF27C93F" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox x:Name="TerminalInput" Grid.Column="1" Background="Transparent" BorderBrush="Transparent" 
                                 Foreground="#EEEEEE" FontFamily="Consolas" FontSize="13" CaretBrush="#FF27C93F" 
                                 KeyDown="TerminalInput_KeyDown" PreviewKeyDown="TerminalInput_PreviewKeyDown" Padding="5" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
