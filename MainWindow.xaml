<Window x:Class="ZeroMix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:local="clr-namespace:ZeroMix"
        xmlns:wallpapers="clr-namespace:ZeroMix.Wallpapers"
        xmlns:battery="clr-namespace:ZeroMix.Plugins.Battery"
        xmlns:weather="clr-namespace:ZeroMix.Plugins.Weather"
        xmlns:translate="clr-namespace:ZeroMix.Plugins.Translate"
        Title="ZeroMix"
        Icon="zeromix.ico"
        Height="750"
        Width="1150"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Background="Transparent"
        WindowStyle="None"
        KeyDown="Window_KeyDown"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        StateChanged="Window_StateChanged"
        ShowInTaskbar="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" 
                      ResizeBorderThickness="5" 
                      GlassFrameThickness="0" 
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Plugins/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global ComboBox -->
            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="#141922"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontSize" Value="12"/>
                <Style.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#141922"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F0F2F5"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource NeonBlueColor}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
                </Style.Resources>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Background" Value="#141922"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource NeonBlueBrush}"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource NeonBlueBrush}"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Navigation Button Style -->
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="20,11"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- Left accent bar (active indicator) -->
                                <Border x:Name="accent"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        CornerRadius="0,2,2,0"
                                        Background="{StaticResource NeonBlueBrush}"
                                        Opacity="0"/>
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}"
                                        CornerRadius="10"
                                        Margin="8,2,12,2">
                                    <ContentPresenter VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"/>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#141922"/>
                                    <Setter Property="Foreground" Value="#E0E4EA"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Quick Action Card Style -->
            <Style x:Key="QuickActionButton" TargetType="Button">
                <Setter Property="Background" Value="#111620"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Height" Value="120"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="14"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#161C28"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource NeonBlueBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#0D1117"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary Button -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource NeonBlueBrush}"/>
                <Setter Property="Foreground" Value="#0A0D13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="28,12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MainBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    
    <Window.Style>
        <Style TargetType="Window">
            <Style.Triggers>
                <Trigger Property="WindowState" Value="Maximized">
                    <Setter Property="BorderThickness" Value="0" />
                    <!-- This allows keeping taskbar visible when maximized in borderless windows -->
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <!-- Main Container with rounded corners -->
    <Border x:Name="RootBorder"
            Style="{StaticResource MainBorderStyle}"
            Background="{StaticResource DeepNavyBrush}"
            BorderThickness="1"
            BorderBrush="#1A2030"
            ClipToBounds="True">
        <Grid x:Name="MainLayoutGrid" Background="#01000000"> <!-- Nearly transparent to trap mouse events -->
            <!-- Main Layout -->
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Title Bar -->
                    <RowDefinition Height="44"/>
                    <!-- Content -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ═══════════════════════════════════ -->
                <!-- TITLE BAR                           -->
                <!-- ═══════════════════════════════════ -->
                <Grid Grid.Row="0" Background="#0D1118">
                    <!-- Invisible Drag Handle (Prevents interference with buttons) -->
                    <Border x:Name="TitleDragArea" Background="Transparent" MouseLeftButtonDown="MainWindow_MouseLeftButtonDown"/>
                    
                    <Grid x:Name="TitleBarContentGrid">
                        <!-- Brand (Not hit-testable so drag works through it) -->
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="20,0,0,0"
                                    IsHitTestVisible="False">
                            <Border Width="22" Height="22"
                                    CornerRadius="5"
                                    Background="{StaticResource NeonBlueBrush}"
                                    Margin="0,0,10,0">
                                <TextBlock Text="Z"
                                           Foreground="Black"
                                           FontSize="12"
                                           FontWeight="ExtraBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="ZeroMix"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#C0C8D8"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Window Controls -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0">
                            <Button Content="&#xE921;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="10"
                                    Style="{StaticResource TitleBtn}"
                                    Click="Minimize_Click"/>
                            <Button x:Name="MaximizeButton"
                                    Content="&#xE922;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="10"
                                    Style="{StaticResource TitleBtn}"
                                    Click="MaximizeRestore_Click"
                                    Margin="2,0,0,0"/>
                            <Button Content="&#xE8BB;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="10"
                                    Style="{StaticResource TitleBtn}"
                                    Click="Close_Click"
                                    Margin="2,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ═══════════════════════════════════ -->
                <!-- BODY (Sidebar + Content)            -->
                <!-- ═══════════════════════════════════ -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ──────────────── SIDEBAR ──────────────── -->
                    <Border Grid.Column="0"
                            Background="#0C1017"
                            BorderThickness="0,0,1,0"
                            BorderBrush="#161C28">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- App Logo -->
                            <StackPanel Grid.Row="0" Margin="24,28,20,32">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="38" Height="38"
                                            CornerRadius="10"
                                            Background="{StaticResource NeonBlueBrush}"
                                            Margin="0,0,12,0">
                                        <TextBlock Text="Z"
                                                   Foreground="Black"
                                                   FontSize="18"
                                                   FontWeight="ExtraBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="ZeroMix"
                                                   FontSize="18"
                                                   FontWeight="ExtraBold"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="v4.8.0"
                                                   FontSize="10"
                                                   Foreground="{StaticResource SubTextBrush}"
                                                   Opacity="0.7"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Navigation Items -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,0">
                                <!-- Section Label -->
                                <TextBlock Text="MENU"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="24,0,0,10"/>

                                <Button x:Name="HomeButton"
                                        Style="{StaticResource NavButtonStyle}"
                                        Click="HomeButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE80F;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Margin="0,0,14,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Home"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="WallpaperButton"
                                        Style="{StaticResource NavButtonStyle}"
                                        Click="NavWallpapers_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEB9F;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Margin="0,0,14,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Wallpapers"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PluginsButton"
                                        Style="{StaticResource NavButtonStyle}"
                                        Click="PluginsButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEA86;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Margin="0,0,14,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Plugins"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RecorderButton"
                                        Style="{StaticResource NavButtonStyle}"
                                        Click="RecorderButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE714;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Margin="0,0,14,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="ZeroRecord"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="AssistantButton"
                                        Style="{StaticResource NavButtonStyle}"
                                        Click="AssistantButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE77B;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Margin="0,0,14,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Assistant"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Separator -->
                                <Border Height="1" Background="#161C28" Margin="20,12"/>

                                <Button x:Name="AboutButton"
                                        Style="{StaticResource NavButtonStyle}"
                                        Click="AboutButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE946;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Margin="0,0,14,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="About"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Footer -->
                            <StackPanel Grid.Row="2" Margin="20,0,20,20">
                                <TextBlock x:Name="StatusLabel"
                                           Text="Systems Initialized"
                                           FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="4,0,0,12"
                                           TextWrapping="Wrap"/>

                                <!-- Language Switcher -->
                                <TextBlock Text="LANGUAGE"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Margin="4,0,0,6"/>
                                <ComboBox x:Name="LanguageComboBox"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectionChanged="LanguageComboBox_SelectionChanged"
                                          HorizontalContentAlignment="Left">
                                    <ComboBoxItem Content="English" Tag="en-US"/>
                                    <ComboBoxItem Content="Indonesia" Tag="id-ID"/>
                                    <ComboBoxItem Content="日本語" Tag="ja-JP"/>
                                    <ComboBoxItem Content="中文" Tag="zh-CN"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ──────────────── CONTENT AREA ──────────────── -->
                    <Grid Grid.Column="1" Margin="40,32,40,32">

                        <!-- ═══ HOME VIEW ═══ -->
                        <ScrollViewer x:Name="HomeContent"
                                      VerticalScrollBarVisibility="Hidden"
                                      BorderThickness="0">
                            <StackPanel>
                                <!-- Welcome Header -->
                                <StackPanel Margin="0,0,0,32">
                                    <TextBlock Text="Welcome back"
                                               FontSize="30"
                                               FontWeight="ExtraBold"
                                               Foreground="{StaticResource TextBrush}"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="Ready to optimize your experience today?"
                                               FontSize="14"
                                               Foreground="{StaticResource SubTextBrush}"/>
                                </StackPanel>

                                <!-- Quick Actions -->
                                <TextBlock Text="QUICK OPERATIONS"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,0,16"/>

                                <Grid Margin="0,0,0,32">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Row 0 -->
                                    <Button x:Name="EnableMonitoringBtn"
                                            Grid.Row="0" Grid.Column="0"
                                            Click="EnableMonitoringBtn_Click"
                                            Style="{StaticResource QuickActionButton}"
                                            Margin="0,0,8,10">
                                        <StackPanel>
                                            <TextBlock Text="&#xE9D9;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="28"
                                                       Foreground="{StaticResource NeonBlueBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,10"/>
                                            <TextBlock Text="System Health"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="OpenClockBtn"
                                            Grid.Row="0" Grid.Column="1"
                                            Click="OpenClockBtn_Click"
                                            Style="{StaticResource QuickActionButton}"
                                            Margin="4,0,4,10">
                                        <StackPanel>
                                            <TextBlock Text="&#xE823;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="28"
                                                       Foreground="{StaticResource NeonBlueBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,10"/>
                                            <TextBlock Text="Neural Clock"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="TaskbarToggleBtn"
                                            Grid.Row="0" Grid.Column="2"
                                            Click="TaskbarToggleBtn_Click"
                                            Style="{StaticResource QuickActionButton}"
                                            Margin="8,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="&#xE737;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="28"
                                                       Foreground="{StaticResource NeonBlueBrush}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,10"/>
                                            <TextBlock Text="Ghost Taskbar"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Row 1 -->
                                    <Button x:Name="HomeRecordBtn"
                                            Grid.Row="1" Grid.Column="0"
                                            Click="ZeroRecordBtn_Click"
                                            Style="{StaticResource QuickActionButton}"
                                            Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="&#xE7C8;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="28"
                                                       Foreground="#FF4D4D"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,10"/>
                                            <TextBlock x:Name="HomeRecordBtnText"
                                                       Text="ZeroRecord"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Monitoring Panel -->
                                <Border x:Name="MonitoringPanel"
                                        Style="{StaticResource CardBorder}"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,20">
                                            <TextBlock Text="Core Statistics"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextBrush}"/>
                                            <Button x:Name="DisableMonitoringBtn"
                                                    Content="&#xE711;"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    Click="DisableMonitoringBtn_Click"
                                                    Style="{StaticResource ActionButton}"
                                                    FontSize="12"
                                                    HorizontalAlignment="Right"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    Foreground="{StaticResource SubTextBrush}"/>
                                        </Grid>

                                        <!-- Stats Row -->
                                        <Grid Margin="0,0,0,24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- CPU -->
                                            <Border Grid.Column="0" Background="#111620" CornerRadius="12" Padding="16" Margin="0,0,6,0">
                                                <StackPanel>
                                                    <TextBlock Text="CPU"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,8"/>
                                                    <TextBlock x:Name="CpuPercentText"
                                                               Text="0.0 %"
                                                               FontSize="24"
                                                               FontWeight="Black"
                                                               Foreground="{StaticResource TextBrush}"
                                                               Margin="0,0,0,10"/>
                                                    <ProgressBar x:Name="CpuProgressBar"
                                                                 Height="5"
                                                                 Maximum="100"
                                                                 Foreground="{StaticResource NeonBlueBrush}"
                                                                 Background="#1A2030"
                                                                 BorderThickness="0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- RAM -->
                                            <Border Grid.Column="1" Background="#111620" CornerRadius="12" Padding="16" Margin="3,0">
                                                <StackPanel>
                                                    <TextBlock Text="MEMORY"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,8"/>
                                                    <TextBlock x:Name="RamPercentText"
                                                               Text="0.0 %"
                                                               FontSize="24"
                                                               FontWeight="Black"
                                                               Foreground="{StaticResource TextBrush}"
                                                               Margin="0,0,0,10"/>
                                                    <ProgressBar x:Name="RamProgressBar"
                                                                 Height="5"
                                                                 Maximum="100"
                                                                 Foreground="{StaticResource NeonBlueBrush}"
                                                                 Background="#1A2030"
                                                                 BorderThickness="0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Disk -->
                                            <Border Grid.Column="2" Background="#111620" CornerRadius="12" Padding="16" Margin="6,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="DISK"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,8"/>
                                                    <TextBlock x:Name="DiskPercentText"
                                                               Text="0.0 %"
                                                               FontSize="24"
                                                               FontWeight="Black"
                                                               Foreground="{StaticResource TextBrush}"
                                                               Margin="0,0,0,10"/>
                                                    <ProgressBar x:Name="DiskProgressBar"
                                                                 Height="5"
                                                                 Maximum="100"
                                                                 Foreground="{StaticResource NeonBlueBrush}"
                                                                 Background="#1A2030"
                                                                 BorderThickness="0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- System Info + Maintenance -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="SYSTEM INFO"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="10"
                                                           Margin="0,0,0,10"/>
                                                <Border Background="#111620" CornerRadius="12" Padding="14">
                                                    <StackPanel>
                                                        <TextBlock x:Name="OsVersionText" Text="OS: Loading..." Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,0,0,6"/>
                                                        <TextBlock x:Name="ProcessorText" Text="CPU: Architecture" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,0,0,6"/>
                                                        <TextBlock x:Name="TotalRamText" Text="RAM: Calculating" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,0,0,6"/>
                                                        <TextBlock x:Name="NetworkText" Text="Net: Scanning" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="MAINTENANCE"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="10"
                                                           Margin="0,0,0,10"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
