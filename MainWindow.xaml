<Window x:Class="ZeroMix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeroMix Dashboard"
        Icon="zeromix.ico"
        Height="500"
        Width="700"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Modern Light Color Palette -->
        <Color x:Key="BackgroundColor">#F0F0F0</Color>
        <Color x:Key="ForegroundColor">#1C1C1C</Color>
        <Color x:Key="BorderColor">#DCDCDC</Color>
        <Color x:Key="AccentColor">#0078D4</Color>
        <Color x:Key="ControlBackgroundColor">#FFFFFF</Color>
        <Color x:Key="ControlHoverColor">#E0E0E0</Color>
        <Color x:Key="NavSelectedColor">#E2E2E2</Color>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
        <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlBackgroundColor}" />
        <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHoverColor}" />
        <SolidColorBrush x:Key="NavSelectedBrush" Color="{StaticResource NavSelectedColor}" />

        <!-- Navigation Button Style -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Panel -->
        <Border Grid.Column="0" Background="{StaticResource ControlBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="10">
                <Button Name="HomeButton" Content="🏠 Home" Click="HomeButton_Click" Style="{StaticResource NavButton}"/>
                <Button Name="AboutButton" Content="ℹ️ About" Click="AboutButton_Click" Style="{StaticResource NavButton}" Margin="0,5,0,0"/>
                <Button Name="PrivacyButton" Content="🔒 Privacy" Click="PrivacyButton_Click" Style="{StaticResource NavButton}" Margin="0,5,0,0"/>
                <Button Name="WallpaperButton" Content="🖼️ Wallpapers" Click="WallpaperButton_Click" Style="{StaticResource NavButton}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Right Content Area -->
        <Grid Grid.Column="1" Name="ContentArea">
            
            <!-- Home Content -->
            <ScrollViewer Name="HomeContent">
                <StackPanel Margin="20">
                    <!-- Welcome Section -->
                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,20">
                        <TextBlock Text="ZeroMix" FontSize="32" FontWeight="Bold" Foreground="{StaticResource ForegroundBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Welcome to ZeroMix Dashboard" FontSize="16" Foreground="{StaticResource ForegroundBrush}" TextAlignment="Center"/>
                        <TextBlock Text="Press Alt+Space to open the overlay from anywhere." FontSize="14" Foreground="#888" TextAlignment="Center" Margin="0,16,0,0"/>
                    </StackPanel>

                    <Separator Margin="0,10,0,20"/>

                    <!-- Quick Tools Section -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Quick Features" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Button Name="EnableMonitoringBtn" Content="📊 Enable System Monitoring" Click="EnableMonitoringBtn_Click" Style="{StaticResource MainButton}" Width="200" HorizontalAlignment="Left"/>
                        <Button Name="OpenClockBtn" Content="⏰ Open Clock Widget" Click="OpenClockBtn_Click" Style="{StaticResource MainButton}" Width="200" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        <Button Name="TaskbarToggleBtn" Content="📌 Enable Transparent Taskbar" Click="TaskbarToggleBtn_Click" Style="{StaticResource MainButton}" Width="200" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Monitoring Dashboard (Hidden by default) -->
                    <Border Name="MonitoringPanel" Visibility="Collapsed" Background="{StaticResource ControlBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="System Monitoring" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Name="DisableMonitoringBtn" Content="✕ Hide" Click="DisableMonitoringBtn_Click" Style="{StaticResource MainButton}" Padding="8,4" Height="28" Grid.Column="1"/>
                            </Grid>

                            <!-- Quick Stats Row -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- CPU Card -->
                                <Border Grid.Column="0" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="CPU" Foreground="#888" FontSize="11" Margin="0,0,0,6"/>
                                        <TextBlock Name="CpuPercentText" Text="-- %" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        <ProgressBar Name="CpuProgressBar" Height="4" Margin="0,8,0,0" Maximum="100" Foreground="{StaticResource AccentBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- RAM Card -->
                                <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Memory" Foreground="#888" FontSize="11" Margin="0,0,0,6"/>
                                        <TextBlock Name="RamPercentText" Text="-- %" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        <ProgressBar Name="RamProgressBar" Height="4" Margin="0,8,0,0" Maximum="100" Foreground="{StaticResource AccentBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Disk Card -->
                                <Border Grid.Column="2" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="Disk" Foreground="#888" FontSize="11" Margin="0,0,0,6"/>
                                        <TextBlock Name="DiskPercentText" Text="-- %" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                        <ProgressBar Name="DiskProgressBar" Height="4" Margin="0,8,0,0" Maximum="100" Foreground="{StaticResource AccentBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- System Info Card -->
                                <Border Grid.Column="3" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="OS" Foreground="#888" FontSize="11" Margin="0,0,0,6"/>
                                        <TextBlock Name="OsVersionText" Text="Windows --" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- System Details -->
                            <GroupBox Header="System Details" FontWeight="SemiBold" Margin="0,0,0,15">
                                <StackPanel Margin="8">
                                    <TextBlock Name="ProcessorText" Text="Processor: --" FontSize="12" Margin="0,0,0,6"/>
                                    <TextBlock Name="TotalRamText" Text="RAM: --" FontSize="12" Margin="0,0,0,6"/>
                                    <TextBlock Name="NetworkText" Text="Network: --" FontSize="12"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Maintenance Tools -->
                            <StackPanel>
                                <TextBlock Text="Maintenance" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <Button Name="ClearCacheButton" Content="🗑️ Clear Cache" Click="ClearCacheButton_Click" Style="{StaticResource MainButton}" Height="28" Margin="0,0,0,6"/>
                                <Button Name="RefreshProcessesBtn" Content="🔄 Refresh" Click="RefreshProcessesBtn_Click" Style="{StaticResource MainButton}" Height="28" Margin="0,0,0,6"/>
                                <TextBlock Name="CacheStatusText" Text="" Foreground="#555" FontSize="11" FontStyle="Italic"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Dashboard Content (Removed - now integrated in Home) -->
            <ScrollViewer Name="DashboardContent" Visibility="Collapsed">
            </ScrollViewer>

            <!-- About Content (Initially Hidden) -->
            <ScrollViewer Name="AboutContent" Visibility="Collapsed" Margin="20">
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="SemiBold" Margin="0,0,0,15">About ZeroMix</TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22" Margin="0,0,0,15">
                        <Run FontWeight="Bold">ZeroMix</Run> is a smart launcher designed to speed up your workflow. With a clean and modern interface, it allows you to quickly search and launch applications, files, and even perform web searches directly from your desktop.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="22">
                        Our browser extension brings the same functionality to your browser, providing a consistent experience wherever you work.
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <!-- Privacy Content (Initially Hidden) -->
            <ScrollViewer Name="PrivacyContent" Visibility="Collapsed" Margin="20">
                <StackPanel>
                    <!-- Peringatan Penggunaan -->
                    <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10">Peringatan Penggunaan</TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
                        ZeroMix adalah aplikasi pribadi yang <Run FontWeight="Bold">tidak dipublikasikan secara massal</Run> di platform resmi.
                        Jika Anda tetap ingin menginstal aplikasi ini, silakan klik <Run FontWeight="Bold">"More info"</Run> lalu pilih <Run FontWeight="Bold">"Run anyway"</Run> saat muncul peringatan dari sistem.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontStyle="Italic" Foreground="#555">
                        Gunakan aplikasi ini dengan kesadaran penuh. Segala risiko penggunaan berada di tangan pengguna.
                    </TextBlock>

                    <Separator Margin="0,15,0,15"/>

                    <!-- Terima Kasih -->
                    <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10">Terima Kasih Telah Menggunakan ZeroMix</TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        ZeroMix adalah aplikasi yang dibuat dengan tujuan untuk memudahkan akses ke aplikasi web dan desktop favorit Anda.
                        Dengan ZeroMix, Anda bisa membuka aplikasi-aplikasi pilihan Anda dengan <Run FontWeight="Bold">lebih cepat, praktis, dan efisien</Run>.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        Kami sangat menghargai Anda yang telah meluangkan waktu untuk membaca ini.
                        Semoga aplikasi ini dapat memberikan pengalaman yang menyenangkan dan bermanfaat bagi Anda.
                    </TextBlock>

                    <Separator Margin="0,15,0,15"/>

                    <!-- Kebijakan Privasi -->
                    <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10">Kebijakan Privasi</TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,15">
                        Kami berkomitmen untuk menjaga privasi Anda dan memastikan bahwa data pribadi yang dikumpulkan digunakan dengan cara yang transparan dan sesuai dengan hukum yang berlaku.
                    </TextBlock>

                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,5">Apa yang Kami Kumpulkan:</TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="15,0,0,10">• Informasi yang diperlukan untuk meningkatkan layanan seperti preferensi aplikasi dan pengaturan pengguna.</TextBlock>

                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,5">Bagaimana Kami Menggunakan Data:</TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="15,0,0,2">• Untuk meningkatkan pengalaman pengguna.</TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="15,0,0,2">• Untuk memperbaiki bug dan menambahkan fitur baru.</TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="15,0,0,10">• Untuk memahami kebutuhan pengguna secara lebih baik.</TextBlock>

                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,5">Kami TIDAK akan:</TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="15,0,0,10">• Membagikan data Anda kepada pihak ketiga tanpa izin Anda, kecuali diwajibkan oleh hukum.</TextBlock>

                    <TextBlock FontWeight="SemiBold" Margin="0,0,0,5">Keamanan Data:</TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="15,0,0,10">• Kami menggunakan enkripsi dan praktik keamanan terbaik untuk melindungi data Anda.</TextBlock>

                    <Separator Margin="0,15,0,15"/>

                    <!-- Penutup -->
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                        Terima kasih telah membaca kebijakan privasi kami.
                        Kami menghargai kepercayaan Anda dan berkomitmen untuk menjaga keamanan data pribadi Anda.
                        Semoga ZeroMix bisa membantu Anda mengakses aplikasi dengan lebih nyaman dan cepat.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
                        Salam hangat,
                        <LineBreak/>
                        Tim ZeroMix 💻✨
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>