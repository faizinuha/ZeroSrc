<Window x:Class="ZeroMix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ZeroMix Dashboard"
        Icon="zeromix.ico"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Background="#1A1A1A">

    <Window.Resources>
        <!-- Modern Dark Theme Colors -->
        <Color x:Key="PrimaryColor">#0A84FF</Color>
        <Color x:Key="PrimaryHoverColor">#0070E0</Color>
        <Color x:Key="SidebarColor">#1E2A35</Color>
        <Color x:Key="ContentBackgroundColor">#1A1A1A</Color>
        <Color x:Key="TextColor">#FFFFFF</Color>
        <Color x:Key="SubTextColor">#8E8E93</Color>
        <Color x:Key="BorderColor">#0A84FF</Color>
        <Color x:Key="CardBackgroundColor">#252525</Color>
        <Color x:Key="HoverColor">#2C3E50</Color>

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="{StaticResource SubTextColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="NavSelectedBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>

        <!-- Animations -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,20,0,0" To="0" Duration="0:0:0.4" DecelerationRatio="0.9"/>
        </Storyboard>

        <!-- Navigation Button Style (Modern) -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8" Margin="10,2">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2C3E50"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Action Card Button Style -->
        <Style x:Key="QuickActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252525"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0A84FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2C3E50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#3A3A3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A3A3C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#48484A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="#3A3A3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Header -->
                <StackPanel Grid.Row="0" Margin="20,30,20,40">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="⚡" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <StackPanel>
                            <TextBlock Text="ZeroMix" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Dashboard" FontSize="11" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1" Margin="0,0,0,0">
                    <Button x:Name="HomeButton" Style="{StaticResource NavButtonStyle}" Click="HomeButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏠" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Home" FontSize="14"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="WallpaperButton" Style="{StaticResource NavButtonStyle}" Click="NavWallpapers_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖼️" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Wallpapers" FontSize="14"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AboutButton" Style="{StaticResource NavButtonStyle}" Click="AboutButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ️" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="About" FontSize="14"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="PrivacyButton" Style="{StaticResource NavButtonStyle}" Click="PrivacyButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔒" FontSize="16" Margin="0,0,12,0"/>
                            <TextBlock Text="Privacy" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Footer -->
                <TextBlock Grid.Row="2" Text="v1.0.0" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#666" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Column="1" Margin="40,40,40,20">
            
            <!-- Home View -->
            <ScrollViewer x:Name="HomeContent" VerticalScrollBarVisibility="Auto" BorderThickness="0">
                <StackPanel>
                    <StackPanel.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
                        </EventTrigger>
                    </StackPanel.Triggers>

                    <TextBlock Text="Welcome back!" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Manage your system and customize your desktop efficiently" FontSize="15" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,35"/>

                    <!-- Quick Actions -->
                    <TextBlock Text="Quick Actions" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="EnableMonitoringBtn" Grid.Column="0" Click="EnableMonitoringBtn_Click" Style="{StaticResource QuickActionButton}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="📊" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="System Monitor" FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="OpenClockBtn" Grid.Column="1" Click="OpenClockBtn_Click" Style="{StaticResource QuickActionButton}" Margin="5,0,5,0">
                            <StackPanel>
                                <TextBlock Text="⏰" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Clock Widget" FontSize="13" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="TaskbarToggleBtn" Grid.Column="2" Click="TaskbarToggleBtn_Click" Style="{StaticResource QuickActionButton}" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="📌" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Transparent Taskbar" FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Monitoring Panel -->
                    <Border x:Name="MonitoringPanel" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                        <StackPanel>
                            <Grid Margin="0,0,0,20">
                                <TextBlock Text="System Status" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                <Button x:Name="DisableMonitoringBtn" Content="✕" Click="DisableMonitoringBtn_Click" Style="{StaticResource ActionButton}" Padding="10,6" HorizontalAlignment="Right" BorderThickness="0" Background="Transparent" Foreground="#999"/>
                            </Grid>

                            <Grid Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- CPU -->
                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="CPU Usage" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="CpuPercentText" Text="0%" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                                    <ProgressBar x:Name="CpuProgressBar" Height="8" Maximum="100" Foreground="{StaticResource PrimaryBrush}" Background="#2C2C2E" BorderThickness="0"/>
                                </StackPanel>

                                <!-- RAM -->
                                <StackPanel Grid.Column="1" Margin="15,0">
                                    <TextBlock Text="Memory" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="RamPercentText" Text="0%" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                                    <ProgressBar x:Name="RamProgressBar" Height="8" Maximum="100" Foreground="{StaticResource PrimaryBrush}" Background="#2C2C2E" BorderThickness="0"/>
                                </StackPanel>

                                <!-- Disk -->
                                <StackPanel Grid.Column="2" Margin="15,0,0,0">
                                    <TextBlock Text="Disk" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="DiskPercentText" Text="0%" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                                    <ProgressBar x:Name="DiskProgressBar" Height="8" Maximum="100" Foreground="{StaticResource PrimaryBrush}" Background="#2C2C2E" BorderThickness="0"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Details" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="0,0,0,12"/>
                                    <TextBlock x:Name="OsVersionText" Text="OS: Windows" Foreground="{StaticResource SubTextBrush}" FontSize="13" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="ProcessorText" Text="CPU: --" Foreground="{StaticResource SubTextBrush}" FontSize="13" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TotalRamText" Text="RAM: --" Foreground="{StaticResource SubTextBrush}" FontSize="13" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="NetworkText" Text="Net: --" Foreground="{StaticResource SubTextBrush}" FontSize="13"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Maintenance" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button x:Name="ClearCacheButton" Content="Clean Cache" Click="ClearCacheButton_Click" Style="{StaticResource ActionButton}" Padding="12,8" FontSize="12"/>
                                        <Button x:Name="RefreshProcessesBtn" Content="Refresh" Click="RefreshProcessesBtn_Click" Style="{StaticResource ActionButton}" Padding="12,8" FontSize="12" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="CacheStatusText" Text="" FontSize="11" FontStyle="Italic" Foreground="{StaticResource SubTextBrush}"/>
                                    
                                    <!-- Process List -->
                                    <ListBox x:Name="ProcessList" Height="100" Margin="0,12,0,0" BorderThickness="1" BorderBrush="#2C2C2E" Background="#1C1C1E" Foreground="{StaticResource TextBrush}" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Wallpapers View -->
            <Grid x:Name="WallpapersContent" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🖼️" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="Wallpaper Gallery" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Browse and apply beautiful wallpapers to your desktop" Foreground="{StaticResource SubTextBrush}" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                    <Button x:Name="LaunchWallpaperBtn" Content="Open Wallpaper Manager" Click="WallpaperButton_Click" Style="{StaticResource PrimaryButton}" Padding="24,14" FontSize="14"/>
                </StackPanel>
            </Grid>

            <!-- About View -->
            <ScrollViewer x:Name="AboutContent" Visibility="Collapsed" BorderThickness="0">
                <StackPanel MaxWidth="650" HorizontalAlignment="Left">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="About ZeroMix" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,20"/>
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="26" Foreground="{StaticResource TextBrush}">
                                <Run FontWeight="SemiBold">ZeroMix</Run> adalah aplikasi produktivitas ultimate untuk Windows. Dirancang dengan fokus pada kecepatan dan kesederhanaan, membantu Anda mengelola workspace dengan mudah.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="26" Foreground="{StaticResource SubTextBrush}" Margin="0,12,0,0">
                                Baik Anda perlu memantau performa sistem, meluncurkan aplikasi dengan cepat, atau menyesuaikan desktop dengan wallpaper yang menakjubkan, ZeroMix siap membantu Anda.
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="26" Foreground="{StaticResource SubTextBrush}" Margin="0,12,0,0">
                                Fitur termasuk monitoring sistem real-time, manajemen wallpaper dengan dukungan video, transparent taskbar, dan interface dark yang indah terinspirasi dari macOS Spotlight.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Privacy View -->
            <ScrollViewer x:Name="PrivacyContent" Visibility="Collapsed" BorderThickness="0">
                <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="Privacy Policy &amp; Usage" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,20"/>
                            
                            <TextBlock Text="Pemberitahuan Penting" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" FontSize="16" Margin="0,0,0,10"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" FontSize="14" LineHeight="24" Margin="0,0,0,20">
                                ZeroMix adalah proyek personal. Aplikasi ini tidak ditandatangani secara digital oleh publisher besar. Anda mungkin melihat peringatan "Windows protected your PC". Ini normal untuk software independen. Klik "More info" > "Run anyway" untuk melanjutkan.
                            </TextBlock>

                            <Rectangle Height="1" Fill="#3A3A3C" Margin="0,10,0,20"/>

                            <TextBlock Text="Pengumpulan Data" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" FontSize="16" Margin="0,0,0,10"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" FontSize="14" LineHeight="24" Margin="0,0,0,8">
                                Kami menghormati privasi Anda. ZeroMix beroperasi secara lokal di mesin Anda.
                            </TextBlock>
                            <StackPanel Margin="15,0,0,20">
                                <TextBlock Text="• Tidak ada data personal yang dikirim ke server eksternal" Foreground="{StaticResource SubTextBrush}" FontSize="14" Margin="0,4"/>
                                <TextBlock Text="• Metrik sistem hanya dibaca untuk tujuan tampilan" Foreground="{StaticResource SubTextBrush}" FontSize="14" Margin="0,4"/>
                                <TextBlock Text="• Pengaturan disimpan secara lokal di perangkat Anda" Foreground="{StaticResource SubTextBrush}" FontSize="14" Margin="0,4"/>
                                <TextBlock Text="• FFmpeg dibundel secara lokal untuk pemrosesan video" Foreground="{StaticResource SubTextBrush}" FontSize="14" Margin="0,4"/>
                            </StackPanel>

                            <TextBlock Text="Terima kasih telah menggunakan ZeroMix!" FontStyle="Italic" Foreground="{StaticResource PrimaryBrush}" FontSize="14" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Window>