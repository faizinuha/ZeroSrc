<Window x:Class="ZeroSrc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeroSrc"
        Height="200"
        Width="400">
    <Grid Background="#000">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="16">
            <TextBlock Text="ZeroSrc"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>
            <Button Width="220"
                    Height="40"
                    Click="OpenOverlay_Click">Open Overlay</Button>
            <TextBlock Text="Press Alt+Space to open the overlay from anywhere."
                       FontSize="12"
                       Foreground="#fff"
                       TextAlignment="Center"
                       Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</Window>
