<Window x:Class="ZeroMix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeroMix"
        Icon="zeromix.ico"
        Height="400"
        Width="600"
        Background="#1e1e1e">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Panel -->
        <StackPanel Grid.Column="0" Background="#2a2a2a">
            <Button Content="Home" 
                    Click="Home_Click" 
                    Margin="10" 
                    Padding="10,5"
                    Background="#3c3c3c"
                    Foreground="White"
                    BorderThickness="0"/>
            <Button Content="Custom" 
                    Name="CustomButton"
                    Click="CustomButton_Click" 
                    Margin="10,0,10,10" 
                    Padding="10,5"
                    Background="#3c3c3c"
                    Foreground="White"
                    BorderThickness="0"/>
        </StackPanel>

        <!-- Right Content Area -->
        <Grid Grid.Column="1" Name="ContentArea">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="16">
                <TextBlock Text="ZeroMix"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <Button Width="220"
                        Height="40"
                        Click="OpenOverlay_Click"
                        Background="#007acc"
                        Foreground="White"
                        BorderThickness="0">Open Overlay</Button>
                <TextBlock Text="Press Alt+Space to open the overlay from anywhere."
                           FontSize="14"
                           Foreground="#ccc"
                           TextAlignment="Center"
                           Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
