<UserControl x:Class="ZeroMix.Plugins.ChargerNotif.ChargerNotifUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="160" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary Source="../Styles.xaml"/>
    </UserControl.Resources>

    <StackPanel>
        <!-- ── Plugin Card ── -->
        <Border Style="{StaticResource CompactCardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10"
                        Background="#141922" Margin="0,0,14,0">
                    <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Charger Notif" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBlock Text="Notifikasi + animasi + suara saat charger dicolok / dicabut / penuh."
                               Foreground="{StaticResource SubTextBrush}" FontSize="11"/>
                    <TextBlock Text="Low &amp; Critical ditangani oleh Battery Assistant."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SettingsBtn" Content="&#xE713;" FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource ActionButton}" Padding="10" FontSize="14"
                            Margin="0,0,10,0" Click="SettingsBtn_Click"/>
                    <CheckBox x:Name="ToggleSwitch" Style="{StaticResource ModernCheckBox}"
                              VerticalAlignment="Center" Click="ToggleSwitch_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Settings Panel ── -->
        <Border x:Name="SettingsPanel" Style="{StaticResource CardBorder}" Visibility="Collapsed">
            <StackPanel>

                <!-- Pesan -->
                <TextBlock Text="PESAN NOTIFIKASI"
                           FontWeight="Bold" Foreground="{StaticResource NeonBlueBrush}"
                           FontSize="10" Margin="0,0,0,12"/>

                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="⚡ Saat charger dicolok" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtCharging" Background="#141922" Foreground="White"
                             Padding="10,8" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                    </TextBox>
                </StackPanel>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="🔌 Saat charger dicabut" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtUnplugged" Background="#141922" Foreground="White"
                             Padding="10,8" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                    </TextBox>
                </StackPanel>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="🎉 Saat baterai penuh (100%)" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtFull" Background="#141922" Foreground="White"
                             Padding="10,8" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <!-- Custom Sound -->
                <TextBlock Text="CUSTOM SOUND (OPSIONAL)"
                           FontWeight="Bold" Foreground="{StaticResource NeonBlueBrush}"
                           FontSize="10" Margin="0,0,0,6"/>
                <TextBlock Text="Pilih file .wav sendiri. Kosongkan = pakai suara bawaan."
                           Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,0,0,12"/>

                <!-- Row: Charging -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⚡ Dicolok" Foreground="{StaticResource SubTextBrush}"
                               FontSize="11" VerticalAlignment="Center"/>
                    <TextBox x:Name="SndCharging" Grid.Column="1" IsReadOnly="True"
                             Background="#141922" Foreground="{StaticResource SubTextBrush}"
                             Padding="8,6" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                             FontSize="11" VerticalContentAlignment="Center">
                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                    </TextBox>
                    <Button Grid.Column="2" Content="Browse" Tag="Charging"
                            Style="{StaticResource ActionButton}" Padding="8,6" Margin="6,0,0,0"
                            FontSize="11" Click="BrowseSound_Click"/>
                    <Button Grid.Column="3" Content="▶" Tag="Charging"
                            Style="{StaticResource ActionButton}" Padding="0" Margin="4,0,0,0"
                            FontSize="12" Click="PreviewSound_Click"/>
                    <Button Grid.Column="4" Content="✕" Tag="Charging"
                            Style="{StaticResource CasualBtn}" Padding="0" Margin="4,0,0,0"
                            FontSize="11" Foreground="#FF5555" Click="ResetSound_Click"/>
                </Grid>

                <!-- Row: Unplug -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔌 Dicabut" Foreground="{StaticResource SubTextBrush}"
                               FontSize="11" VerticalAlignment="Center"/>
                    <TextBox x:Name="SndUnplug" Grid.Column="1" IsReadOnly="True"
                             Background="#141922" Foreground="{StaticResource SubTextBrush}"
                             Padding="8,6" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                             FontSize="11" VerticalContentAlignment="Center">
                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                    </TextBox>
                    <Button Grid.Column="2" Content="Browse" Tag="Unplug"
                            Style="{StaticResource ActionButton}" Padding="8,6" Margin="6,0,0,0"
                            FontSize="11" Click="BrowseSound_Click"/>
                    <Button Grid.Column="3" Content="▶" Tag="Unplug"
                            Style="{StaticResource ActionButton}" Padding="0" Margin="4,0,0,0"
                            FontSize="12" Click="PreviewSound_Click"/>
                    <Button Grid.Column="4" Content="✕" Tag="Unplug"
                            Style="{StaticResource CasualBtn}" Padding="0" Margin="4,0,0,0"
                            FontSize="11" Foreground="#FF5555" Click="ResetSound_Click"/>
                </Grid>

                <!-- Row: Full -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="34"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🎉 Penuh" Foreground="{StaticResource SubTextBrush}"
                               FontSize="11" VerticalAlignment="Center"/>
                    <TextBox x:Name="SndFull" Grid.Column="1" IsReadOnly="True"
                             Background="#141922" Foreground="{StaticResource SubTextBrush}"
                             Padding="8,6" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                             FontSize="11" VerticalContentAlignment="Center">
                        <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                    </TextBox>
                    <Button Grid.Column="2" Content="Browse" Tag="Full"
                            Style="{StaticResource ActionButton}" Padding="8,6" Margin="6,0,0,0"
                            FontSize="11" Click="BrowseSound_Click"/>
                    <Button Grid.Column="3" Content="▶" Tag="Full"
                            Style="{StaticResource ActionButton}" Padding="0" Margin="4,0,0,0"
                            FontSize="12" Click="PreviewSound_Click"/>
                    <Button Grid.Column="4" Content="✕" Tag="Full"
                            Style="{StaticResource CasualBtn}" Padding="0" Margin="4,0,0,0"
                            FontSize="11" Foreground="#FF5555" Click="ResetSound_Click"/>
                </Grid>

                <!-- Tombol aksi -->
                <StackPanel Orientation="Horizontal">
                    <Button Content="Simpan" Style="{StaticResource ActionButton}"
                            Padding="24,10" Click="SaveBtn_Click"/>
                    <Button Content="▶ Test Notif" Style="{StaticResource ActionButton}"
                            Padding="16,10" Margin="10,0,0,0" Click="TestBtn_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
