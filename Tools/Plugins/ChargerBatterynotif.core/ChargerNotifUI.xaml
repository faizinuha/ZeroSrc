<UserControl x:Class="ZeroMix.Plugins.ChargerNotif.ChargerNotifUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="160" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary Source="../Styles.xaml"/>
    </UserControl.Resources>

    <StackPanel>
        <!-- ── Plugin Card ── -->
        <Border Style="{StaticResource CompactCardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Gradient Icon -->
                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="11"
                        Margin="0,0,14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1A2D1A" Offset="0"/>
                            <GradientStop Color="#0D1A2E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="⚡" FontSize="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Charger Notif" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,2"/>
                    <TextBlock Text="Smart notifications when charger is connected, removed, or battery is full."
                               Foreground="{StaticResource SubTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="Low &amp; Critical handled by Battery Assistant."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SettingsBtn"
                            Width="30" Height="30" Cursor="Hand"
                            Margin="0,0,10,0" Click="SettingsBtn_Click"
                            Background="#111620" BorderThickness="1" BorderBrush="#1E2633">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#1A2233"/>
                                        <Setter TargetName="b" Property="BorderBrush" Value="#00BFA5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{StaticResource SubTextBrush}"/>
                    </Button>
                    <CheckBox x:Name="ToggleSwitch" Style="{StaticResource ModernCheckBox}"
                              VerticalAlignment="Center" Click="ToggleSwitch_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Settings Panel ── -->
        <Border x:Name="SettingsPanel" Visibility="Collapsed"
                Background="#0B0E14" CornerRadius="0,0,12,12"
                BorderThickness="1,0,1,1" BorderBrush="#161C2A"
                Padding="20,16,20,20" Margin="0,-2,0,0">

            <StackPanel>

                <!-- Section: Notification Messages -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00D68F" Offset="0"/>
                                <GradientStop Color="#0066FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="NOTIFICATION MESSAGES"
                                   Foreground="#00BFA5" FontSize="10" FontWeight="Bold"
                                   Padding="1" Margin="0,0,0,2"/>
                        <TextBlock Text="Customize text shown in each event notification."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                    </StackPanel>
                </Grid>

                <!-- Message Rows -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6"
                            Background="#1A2D1A" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Charger Connected" Foreground="{StaticResource SubTextBrush}"
                                   FontSize="10" Margin="0,0,0,4"/>
                        <Border Background="#111620" CornerRadius="8" BorderThickness="1" BorderBrush="#1E2633">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFocused, ElementName=TxtCharging}" Value="True">
                                            <Setter Property="BorderBrush" Value="#00BFA5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBox x:Name="TxtCharging" Background="Transparent"
                                     Foreground="White" BorderThickness="0"
                                     Padding="12,8" FontSize="12"
                                     CaretBrush="White"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6"
                            Background="#2D1A0A" VerticalAlignment="Center">
                        <TextBlock Text="🔌" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Charger Disconnected" Foreground="{StaticResource SubTextBrush}"
                                   FontSize="10" Margin="0,0,0,4"/>
                        <Border Background="#111620" CornerRadius="8" BorderThickness="1" BorderBrush="#1E2633">
                            <TextBox x:Name="TxtUnplugged" Background="Transparent"
                                     Foreground="White" BorderThickness="0"
                                     Padding="12,8" FontSize="12"
                                     CaretBrush="White"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6"
                            Background="#1A1A2D" VerticalAlignment="Center">
                        <TextBlock Text="🎉" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Battery Full (100%)" Foreground="{StaticResource SubTextBrush}"
                                   FontSize="10" Margin="0,0,0,4"/>
                        <Border Background="#111620" CornerRadius="8" BorderThickness="1" BorderBrush="#1E2633">
                            <TextBox x:Name="TxtFull" Background="Transparent"
                                     Foreground="White" BorderThickness="0"
                                     Padding="12,8" FontSize="12"
                                     CaretBrush="White"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Divider -->
                <Border Height="1" Background="#161C2A" Margin="0,0,0,16"/>

                <!-- Section: Custom Sound -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#9B59B6" Offset="0"/>
                                <GradientStop Color="#3498DB" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="CUSTOM SOUND" Foreground="#9B59B6" FontSize="10" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBlock Text="Optional .wav file. Leave empty to use built-in sounds."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                    </StackPanel>
                </Grid>

                <!-- Sound Rows Template -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Connected" Foreground="{StaticResource SubTextBrush}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#111620" CornerRadius="7"
                            BorderThickness="1" BorderBrush="#1E2633" Margin="0,0,6,0">
                        <TextBox x:Name="SndCharging" IsReadOnly="True"
                                 Background="Transparent" Foreground="{StaticResource SubTextBrush}"
                                 BorderThickness="0" Padding="10,6" FontSize="10"
                                 VerticalContentAlignment="Center"/>
                    </Border>
                    <Button Grid.Column="2" Content="Browse" Tag="Charging"
                            Height="30" FontSize="11" Cursor="Hand"
                            Background="#151E2D" Foreground="#8899AA"
                            BorderThickness="1" BorderBrush="#1E2633"
                            Click="BrowseSound_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="7">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#1E2A40"/>
                                        <Setter TargetName="b" Property="BorderBrush" Value="#00BFA5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="3" Tag="Charging" Width="28" Height="28"
                            Cursor="Hand" Margin="4,0,0,0"
                            Background="#151E2D" BorderThickness="1" BorderBrush="#1E2633"
                            Click="PreviewSound_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="7">
                                    <TextBlock Text="▶" FontSize="10" Foreground="#00BFA5"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#1A2D1A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="4" Tag="Charging" Width="28" Height="28"
                            Cursor="Hand" Margin="4,0,0,0"
                            Background="#1A1010" BorderThickness="1" BorderBrush="#2D1515"
                            Click="ResetSound_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="7">
                                    <TextBlock Text="✕" FontSize="10" Foreground="#FF5555"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#2D1A1A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔌" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Removed" Foreground="{StaticResource SubTextBrush}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#111620" CornerRadius="7"
                            BorderThickness="1" BorderBrush="#1E2633" Margin="0,0,6,0">
                        <TextBox x:Name="SndUnplug" IsReadOnly="True"
                                 Background="Transparent" Foreground="{StaticResource SubTextBrush}"
                                 BorderThickness="0" Padding="10,6" FontSize="10"
                                 VerticalContentAlignment="Center"/>
                    </Border>
                    <Button Grid.Column="2" Content="Browse" Tag="Unplug"
                            Height="30" FontSize="11" Cursor="Hand"
                            Background="#151E2D" Foreground="#8899AA"
                            BorderThickness="1" BorderBrush="#1E2633"
                            Click="BrowseSound_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="7">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#1E2A40"/>
                                        <Setter TargetName="b" Property="BorderBrush" Value="#00BFA5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="3" Tag="Unplug" Width="28" Height="28"
                            Cursor="Hand" Margin="4,0,0,0"
                            Background="#151E2D" BorderThickness="1" BorderBrush="#1E2633"
                            Click="PreviewSound_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="7">
                                    <TextBlock Text="▶" FontSize="10" Foreground="#00BFA5"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#1A2D1A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="4" Tag="Unplug" Width="28" Height="28"
                            Cursor="Hand" Margin="4,0,0,0"
                            Background="#1A1010" BorderThickness="1" BorderBrush="#2D1515"
                            Click="ResetSound_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="7">
                                    <TextBlock Text="✕" FontSize="10" Foreground="#FF5555"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#2D1A1A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎉" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Full" Foreground="{StaticResource SubTextBrush}"
                                   FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#111620" CornerRadius="7"
                            BorderThickness="1" BorderBrush="#1E2633" Margin="0,0,6,0">
                        <TextBox x:Name="SndFull" IsReadOnly="True"
                                 Background="Transparent" Foreground="{StaticResource SubTextBrush}"
                                 BorderThickness="0" Padding="10,6" FontSize="10"
                                 VerticalContentAlignment="Center"/>
                    </Border>
                    <Button Grid.Column="2" Content="Browse" Tag="Full"
                            Height="30" FontSize="11" Cursor="Hand"
                            Background="#151E2D" Foreground="#8899AA"
                            BorderThickness="1" BorderBrush="#1E2633"
                            Click="BrowseSound_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="7">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#1E2A40"/>
                                        <Setter TargetName="b" Property="BorderBrush" Value="#00BFA5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="3" Tag="Full" Width="28" Height="28"
                            Cursor="Hand" Margin="4,0,0,0"
                            Background="#151E2D" BorderThickness="1" BorderBrush="#1E2633"
                            Click="PreviewSound_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="7">
                                    <TextBlock Text="▶" FontSize="10" Foreground="#00BFA5"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#1A2D1A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="4" Tag="Full" Width="28" Height="28"
                            Cursor="Hand" Margin="4,0,0,0"
                            Background="#1A1010" BorderThickness="1" BorderBrush="#2D1515"
                            Click="ResetSound_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="7">
                                    <TextBlock Text="✕" FontSize="10" Foreground="#FF5555"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#2D1A1A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Action Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"/>

                    <!-- Save Button -->
                    <Button Grid.Column="1" Height="36" Padding="24,0"
                            Cursor="Hand" Click="SaveBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="9">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00A37A" Offset="0"/>
                                            <GradientStop Color="#0066CC" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Save" Foreground="White" FontSize="12"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Test Notif Button -->
                    <Button Grid.Column="3" Height="36" Padding="18,0"
                            Cursor="Hand" Click="TestBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="9"
                                        Background="#151E2D"
                                        BorderThickness="1" BorderBrush="#1E2D45">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="▶" FontSize="11" Foreground="#00BFA5"
                                                   Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Test Notif" Foreground="#8899AA" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="BorderBrush" Value="#00BFA5"/>
                                        <Setter TargetName="b" Property="Background" Value="#1A2A3A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
