<Window x:Class="ZeroMix.Plugins.ChargerNotif.BatteryNotifWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif"
        Title="Battery Notif"
        Height="130" Width="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Window.Resources>
        <!-- Slide-in from bottom-right -->
        <Storyboard x:Key="SlideIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.35"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="40" To="0" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <!-- Slide-out -->
        <Storyboard x:Key="SlideOut" Completed="SlideOut_Completed">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="0" To="30" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>

    <Window.RenderTransform>
        <TranslateTransform Y="0"/>
    </Window.RenderTransform>

    <!-- Card -->
    <Border x:Name="Card"
            CornerRadius="14"
            Margin="6,6,6,6"
            ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1A1F2E" Offset="0"/>
                <GradientStop Color="#0D1117" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop x:Name="BorderColor1" Color="#00D68F" Offset="0"/>
                <GradientStop x:Name="BorderColor2" Color="#0066FF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.BorderThickness>1.5</Border.BorderThickness>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="28"/>
            </Grid.ColumnDefinitions>

            <!-- Visual Panel: Lottie (utama) atau PNG maskot (fallback) -->
            <Border Grid.Column="0"
                    Background="#0A0D13"
                    BorderBrush="#1A2030"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <!-- Animated GIF (Welcome.gif / Loader cat.gif) -->
                    <Image x:Name="GifImage"
                           Width="90" Height="90"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           gif:ImageBehavior.RepeatBehavior="Forever"/>
                    <!-- PNG maskot fallback jika GIF tidak ada -->
                    <Image x:Name="MaskotImage"
                           Stretch="Uniform"
                           Width="80" Height="80"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Text Content -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="16,10,8,10">
                <!-- Status badge -->
                <Border x:Name="StatusBadge"
                        Background="#1A2030"
                        CornerRadius="4"
                        Padding="7,2"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,6">
                    <TextBlock x:Name="StatusLabel"
                               Text="CHARGING"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="#00D68F"/>
                </Border>

                <TextBlock x:Name="TitleText"
                           Text="Charger Connected"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,0,0,4"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock x:Name="BodyText"
                           Text="Battery is now charging..."
                           FontSize="11"
                           Foreground="#8899AA"
                           TextWrapping="Wrap"
                           MaxHeight="36"/>

                <!-- Battery bar -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Height="4"
                            CornerRadius="2"
                            Background="#1A2030"
                            VerticalAlignment="Center">
                        <Border x:Name="BatteryFill"
                                Height="4"
                                CornerRadius="2"
                                HorizontalAlignment="Left"
                                Width="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop x:Name="BarColor1" Color="#00D68F" Offset="0"/>
                                    <GradientStop x:Name="BarColor2" Color="#00AAFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                    <TextBlock x:Name="PercentText"
                               Grid.Column="1"
                               Text="0%"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#00D68F"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <!-- Close button -->
            <Button Grid.Column="2"
                    Content="✕"
                    Click="Close_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#445566"
                    FontSize="11"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0"
                    Cursor="Hand"/>
        </Grid>
    </Border>
</Window>
