<UserControl x:Class="zeromix.SnapLayout.SnapLayoutUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="200"
             d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Storyboard x:Key="ExpandAnim">
                <DoubleAnimation Storyboard.TargetName="SettingsPanel"
                                 Storyboard.TargetProperty="MaxHeight"
                                 From="0" To="1200" Duration="0:0:0.25">
                    <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="SettingsPanel"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.25"/>
            </Storyboard>
            <Storyboard x:Key="CollapseAnim">
                <DoubleAnimation Storyboard.TargetName="SettingsPanel"
                                 Storyboard.TargetProperty="MaxHeight"
                                 From="1200" To="0" Duration="0:0:0.2">
                    <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="SettingsPanel"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" Duration="0:0:0.2"/>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- ── Plugin Card ── -->
        <Border x:Name="SnapCard"
                Style="{StaticResource CompactCardBorder}"
                MouseDown="SnapCard_MouseDown"
                Cursor="Hand">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="11"
                        Margin="0,0,14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#001A2E" Offset="0"/>
                            <GradientStop Color="#000A1A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="⊞" FontSize="22"
                               Foreground="#00D4FF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Snap Layout" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,2"/>
                    <TextBlock Text="FancyZones-style window snapping"
                               Foreground="{StaticResource SubTextBrush}" FontSize="11"/>
                    <TextBlock x:Name="StatusText" Text="Inactive"
                               Foreground="{StaticResource SubTextBrush}" FontSize="10"
                               Margin="0,3,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <CheckBox x:Name="SnapPluginToggle"
                              VerticalAlignment="Center"
                              Click="SnapPluginToggle_Click"
                              Style="{StaticResource ModernCheckBox}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Settings Panel (collapsible) ── -->
        <Border x:Name="SettingsPanel"
                Visibility="Collapsed"
                Background="#0B0E14" CornerRadius="0,0,12,12"
                BorderThickness="1,0,1,1" BorderBrush="#161C2A"
                Padding="20,16,20,20" Margin="0,-2,0,0">
            <StackPanel>

                <!-- Section header -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00D4FF" Offset="0"/>
                                <GradientStop Color="#007A9E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="SNAP LAYOUT SETTINGS"
                                   Foreground="#00D4FF" FontSize="10" FontWeight="Bold"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="Configure triggers, layout preset, and hotkey."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                    </StackPanel>
                </Grid>

                <!-- Layout Preset Selector -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Layout"
                               Foreground="{StaticResource SubTextBrush}" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox x:Name="LayoutCombo" Grid.Column="1"
                              Style="{StaticResource ModernComboBox}"
                              SelectionChanged="LayoutCombo_SelectionChanged">
                        <ComboBoxItem Content="Two Columns (50/50)" Tag="TwoColumns" IsSelected="True"/>
                        <ComboBoxItem Content="Three Columns (33/33/33)" Tag="ThreeColumns"/>
                        <ComboBoxItem Content="Two + One (67/33)" Tag="TwoPlusOne"/>
                        <ComboBoxItem Content="One + Two (33/67)" Tag="OnePlusTwo"/>
                        <ComboBoxItem Content="Two by Two (2×2)" Tag="TwoByTwo"/>
                        <ComboBoxItem Content="Top / Bottom (50/50)" Tag="TopBottom"/>
                    </ComboBox>
                </Grid>

                <!-- Divider -->
                <Border Height="1" Background="#161C2A" Margin="0,0,0,12"/>

                <!-- Trigger Toggles (2x1 Grid) -->
                <TextBlock Text="TRIGGERS" Foreground="{StaticResource TextMutedBrush}"
                           FontSize="9" FontWeight="Bold" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Drag to Zone -->
                    <Border Grid.Column="0" Background="#111620" CornerRadius="8"
                            Padding="10,8" Margin="0,0,5,0"
                            BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="↗️" FontSize="14" Margin="0,0,0,3"/>
                                <TextBlock Text="Drag to Zone" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="Auto-detect window drag" Foreground="{StaticResource SubTextBrush}" FontSize="9"/>
                            </StackPanel>
                            <CheckBox x:Name="DragModeToggle" Grid.Column="1"
                                      VerticalAlignment="Top" Margin="0,2,0,0"
                                      Style="{StaticResource ModernCheckBox}"
                                      Checked="DragModeToggle_Changed" Unchecked="DragModeToggle_Changed"/>
                        </Grid>
                    </Border>

                    <!-- Keybind -->
                    <Border Grid.Column="1" Background="#111620" CornerRadius="8"
                            Padding="10,8" Margin="5,0,0,0"
                            BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="⌨️" FontSize="14" Margin="0,0,0,3"/>
                                <TextBlock Text="Keybind" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="Ctrl+Win+Z overlay" Foreground="{StaticResource SubTextBrush}" FontSize="9"/>
                            </StackPanel>
                            <CheckBox x:Name="KeybindToggle" Grid.Column="1"
                                      VerticalAlignment="Top" Margin="0,2,0,0"
                                      Style="{StaticResource ModernCheckBox}"
                                      Checked="KeybindToggle_Changed" Unchecked="KeybindToggle_Changed"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Hotkey Display -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Hotkey"
                               Foreground="{StaticResource SubTextBrush}" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Border Grid.Column="1" Background="#0D1117" CornerRadius="6"
                            BorderThickness="1" BorderBrush="#1E2633"
                            Padding="10,6">
                        <TextBlock x:Name="HotkeyDisplay" Text="Ctrl+Win+Z"
                                   Foreground="#00D4FF" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <Button Grid.Column="2" Content="Change"
                            Click="ChangeHotkey_Click"
                            Padding="10,6" Margin="8,0,0,0"
                            Background="#1A2233" Foreground="#00D4FF"
                            BorderBrush="#00D4FF" BorderThickness="1"
                            FontSize="11" Cursor="Hand"
                            Style="{StaticResource CasualBtn}"/>
                </Grid>

                <!-- Divider -->
                <Border Height="1" Background="#161C2A" Margin="0,0,0,12"/>

                <!-- Snap History -->
                <Border Background="#0D1117" CornerRadius="8" Padding="10,8"
                        BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="SNAP HISTORY" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="9" FontWeight="Bold"/>
                            <TextBlock x:Name="SnapCountDisplay" Text="Today: 0 snaps"
                                       Foreground="{StaticResource NeonBlueBrush}" FontSize="9"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock x:Name="LiveLog"
                                   Text="[SYSTEM] Snap Layout ready.&#x0a;"
                                   Foreground="#00C878" FontSize="10" FontFamily="Consolas"
                                   TextWrapping="Wrap" MaxHeight="60"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
