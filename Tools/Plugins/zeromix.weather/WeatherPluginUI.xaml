<UserControl x:Class="ZeroMix.Plugins.Weather.WeatherPluginUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary Source="../Styles.xaml"/>
    </UserControl.Resources>
    
    <StackPanel>
        <Border x:Name="WeatherCard" Style="{StaticResource CompactCardBorder}" MouseDown="WeatherCard_MouseDown" Cursor="Hand">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="#141922" Margin="0,0,14,0">
                    <TextBlock Text="&#xE9CA;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="{StaticResource NeonBlueBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Dynamic Weather" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBlock Text="Sync desktop with real-time weather conditions." Foreground="{StaticResource SubTextBrush}" FontSize="11"/>

                    <!-- Progress -->
                    <StackPanel x:Name="PluginProgressPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock x:Name="PluginStatusText" Text="Processing Plugin... 0%" Foreground="{StaticResource NeonBlueBrush}" FontSize="11" Margin="0,0,0,5"/>
                        <ProgressBar x:Name="PluginProgressBar" Height="4" Maximum="100" Foreground="{StaticResource NeonBlueBrush}" Background="#141922" BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="WeatherPluginToggle" VerticalAlignment="Center" Click="WeatherPluginToggle_Click"
                              Style="{StaticResource ModernCheckBox}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Weather Config (Expandable) -->
        <Border x:Name="WeatherConfigBorder" Style="{StaticResource CardBorder}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="CONFIGURATION" FontWeight="Bold" Foreground="{StaticResource NeonBlueBrush}" FontSize="10" Margin="0,0,0,16"/>

                <TextBlock Text="City" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="WeatherCityInput" Background="#141922" Foreground="White"
                             BorderBrush="{StaticResource BorderBrush}" Padding="14,10" VerticalContentAlignment="Center">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <Button Grid.Column="1" Content="Save" Style="{StaticResource ActionButton}" Padding="24,10" Margin="10,0,0,0" Click="UpdateWeatherLocation_Click"/>
                </Grid>

                <TextBlock Text="Weather Assets" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,0,0,10"/>
                <UniformGrid Columns="3" Margin="0,0,0,4">
                    <Border Background="#141922" CornerRadius="10" Padding="10" Margin="0,0,6,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="☀️" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Sunny" Foreground="{StaticResource SubTextBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Auto" Foreground="{StaticResource NeonBlueBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#141922" CornerRadius="10" Padding="10" Margin="3,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="🌧️" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Rainy" Foreground="{StaticResource SubTextBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Auto" Foreground="{StaticResource NeonBlueBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#141922" CornerRadius="10" Padding="10" Margin="6,0,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="☁️" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Cloudy" Foreground="{StaticResource SubTextBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Auto" Foreground="{StaticResource NeonBlueBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
