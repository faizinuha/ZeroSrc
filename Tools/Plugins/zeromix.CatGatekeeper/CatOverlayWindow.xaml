<Window x:Class="zeromix.CatGatekeeper.CatOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cat Gatekeeper"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Grid x:Name="RootGrid" Background="#CC000000">

        <!-- Cat Video (mp4 — WPF MediaElement native support) -->
        <MediaElement x:Name="CatVideo"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Stretch="Uniform"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      MediaEnded="CatVideo_MediaEnded">
            <MediaElement.RenderTransform>
                <TranslateTransform x:Name="VideoTranslate"/>
            </MediaElement.RenderTransform>
        </MediaElement>

        <!-- Countdown Timer -->
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="80,120,0,0"
                Background="#99000000"
                CornerRadius="20"
                Padding="40,20">
            <TextBlock x:Name="CountdownText"
                       FontSize="120"
                       FontWeight="Bold"
                       Foreground="White"
                       TextAlignment="Center">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>
        </Border>

        <!-- Credit -->
        <TextBlock Text="Aset Asli oleh: @konekone2026 (ZOKUZOKU) – Cat Gatekeeper&#x0a;Ekstraksi &amp; Optimasi: Zaki · https://x.com/konekone2026"
                   FontSize="11" Foreground="White"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,20,20" TextAlignment="Right" Opacity="0.6"/>
    </Grid>
</Window>
