<Window x:Class="zeromix.CatGatekeeper.CatOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cat Gatekeeper"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Grid x:Name="RootGrid">

        <!-- Cat Video — fill tinggi layar, anchor kanan bawah seperti Chrome extension -->
        <MediaElement x:Name="CatVideo"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Stretch="UniformToFill"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Width="Auto"
                      MediaEnded="CatVideo_MediaEnded">
            <MediaElement.RenderTransform>
                <TranslateTransform x:Name="VideoTranslate" X="3000"/>
            </MediaElement.RenderTransform>
        </MediaElement>

        <!-- Countdown Timer — pojok kiri atas -->
        <Border HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="60,80,0,0"
                Background="#CC000000"
                CornerRadius="16"
                Padding="28,14">
            <StackPanel>
                <TextBlock Text="Break Time!"
                           FontSize="14" FontWeight="Bold"
                           Foreground="#00D68F"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,2"/>
                <TextBlock x:Name="CountdownText"
                           FontSize="72"
                           FontWeight="Bold"
                           Foreground="White"
                           TextAlignment="Center"
                           MinWidth="140">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="Istirahat sebentar 🐱"
                           FontSize="12"
                           Foreground="#AAAAAA"
                           HorizontalAlignment="Center"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
