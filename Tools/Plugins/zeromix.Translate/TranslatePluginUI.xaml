<UserControl x:Class="ZeroMix.Plugins.Translate.TranslatePluginUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- ComboBox dark theme — full template override agar tidak override sistem ke putih -->
            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="#F0F2F5"/>
                <Setter Property="Background" Value="#111620"/>
                <Setter Property="BorderBrush" Value="#1E2633"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton"
                                              Background="#111620"
                                              BorderBrush="#1E2633"
                                              BorderThickness="1"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="24"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Grid.Column="0"/>
                                                    <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z"
                                                          Fill="#8899AA"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="#00BFA5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Margin="12,0,28,0"
                                                  VerticalAlignment="Center"/>
                                <Popup x:Name="Popup" Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" Focusable="False"
                                       PopupAnimation="Slide">
                                    <Border x:Name="DropDown"
                                            Background="#111620"
                                            BorderBrush="#1E2633"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            MinWidth="{TemplateBinding ActualWidth}"
                                            MaxHeight="200">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.5" Color="Black"/>
                                        </Border.Effect>
                                        <ScrollViewer>
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Background" Value="#111620"/>
                <Setter Property="Foreground" Value="#F0F2F5"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#00BFA5"/>
                                    <Setter Property="Foreground" Value="#0B0E14"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#007A6A"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Storyboard x:Key="ExpandAnim">
                <DoubleAnimation Storyboard.TargetName="SettingsPanel"
                                 Storyboard.TargetProperty="Height"
                                 From="0" To="440" Duration="0:0:0.25">
                    <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="SettingsPanel"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0" To="1" Duration="0:0:0.25"/>
            </Storyboard>
            <Storyboard x:Key="CollapseAnim">
                <DoubleAnimation Storyboard.TargetName="SettingsPanel"
                                 Storyboard.TargetProperty="Height"
                                 From="440" To="0" Duration="0:0:0.2">
                    <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="SettingsPanel"
                                 Storyboard.TargetProperty="Opacity"
                                 From="1" To="0" Duration="0:0:0.2"/>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource CompactCardBorder}">
        <StackPanel>

            <!-- ── HEADER ROW ── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>

                <!-- Plugin Icon -->
                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10" VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#004D40" Offset="0"/>
                            <GradientStop Color="#00251A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="🔄" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Title + Status -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="Nexus Translator" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StatusText" Text="Standby"
                                   Foreground="{StaticResource SubTextBrush}" FontSize="10"/>
                        <TextBlock Text="  ·  " Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                        <TextBlock x:Name="FeatureCount" Text="0/4 active"
                                   Foreground="{StaticResource SubTextBrush}" FontSize="10"/>
                    </StackPanel>
                </StackPanel>

                <!-- Master Power Checkbox -->
                <CheckBox x:Name="PowerSwitch" Grid.Column="3"
                          VerticalAlignment="Center" HorizontalAlignment="Center"
                          Click="PowerSwitch_Click"
                          Style="{StaticResource ModernCheckBox}"
                          ToolTip="Enable / Disable Engine"/>

                <!-- Gear Button -->
                <Button x:Name="GearBtn" Grid.Column="4"
                        Width="28" Height="28" ToolTip="Settings"
                        Click="ToggleButton_Click" Cursor="Hand"
                        Background="#1A1A1A" BorderThickness="1" BorderBrush="#2A2A2A">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#252525"/>
                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource NeonBlueBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{StaticResource SubTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="IconRotation" Angle="0"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Button>
            </Grid>

            <!-- ── SETTINGS PANEL ── -->
            <Border x:Name="SettingsPanel" Height="0" Opacity="0" ClipToBounds="True">
                <StackPanel Margin="0,14,0,0">

                    <Border Height="1" Background="#1A2030" Margin="0,0,0,14"/>

                    <!-- Feature Toggles (2x2 grid) -->
                    <TextBlock Text="FEATURES" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="9" FontWeight="Bold" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Keyboard Translate -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#111620" CornerRadius="8"
                                Padding="10,8" Margin="0,0,5,5"
                                BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="⌨️" FontSize="14" Margin="0,0,0,3"/>
                                    <TextBlock Text="Keyboard" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="Realtime typing" Foreground="{StaticResource SubTextBrush}" FontSize="9"/>
                                </StackPanel>
                                <CheckBox x:Name="KeyboardTranslateToggle" Grid.Column="1"
                                          VerticalAlignment="Top" Margin="0,2,0,0"
                                          Style="{StaticResource ModernCheckBox}"
                                          Checked="FeatureToggle_Changed" Unchecked="FeatureToggle_Changed"/>
                            </Grid>
                        </Border>

                        <!-- Game Mode -->
                        <Border Grid.Row="0" Grid.Column="1" Background="#111620" CornerRadius="8"
                                Padding="10,8" Margin="0,0,0,5"
                                BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🎮" FontSize="14" Margin="0,0,0,3"/>
                                    <TextBlock Text="Game Mode" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="Clipboard paste" Foreground="{StaticResource SubTextBrush}" FontSize="9"/>
                                </StackPanel>
                                <CheckBox x:Name="GameModeSwitch" Grid.Column="1"
                                          VerticalAlignment="Top" Margin="0,2,0,0"
                                          Style="{StaticResource ModernCheckBox}"
                                          Checked="FeatureToggle_Changed" Unchecked="FeatureToggle_Changed"/>
                            </Grid>
                        </Border>

                        <!-- Drag Translate Bubble -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#111620" CornerRadius="8"
                                Padding="10,8" Margin="0,0,5,0"
                                BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="�️" FontSize="14" Margin="0,0,0,3"/>
                                    <TextBlock Text="Bubble" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="Drag to translate" Foreground="{StaticResource SubTextBrush}" FontSize="9"/>
                                </StackPanel>
                                <CheckBox x:Name="BubbleModeSwitch" Grid.Column="1"
                                          VerticalAlignment="Top" Margin="0,2,0,0"
                                          Style="{StaticResource ModernCheckBox}"
                                          Checked="FeatureToggle_Changed" Unchecked="FeatureToggle_Changed"/>
                            </Grid>
                        </Border>

                        <!-- Placeholder slot (OCR removed) -->
                        <Border Grid.Row="1" Grid.Column="1" Background="#0D1117" CornerRadius="8"
                                Padding="10,8" Opacity="0.3"
                                BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="—" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="Slot kosong" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="9" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Language Row -->
                    <TextBlock Text="LANGUAGE" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="9" FontWeight="Bold" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FROM" Foreground="{StaticResource TextMutedBrush}" FontSize="8" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ComboSource" SelectionChanged="Langs_Changed">
                                <ComboBoxItem Content="Indonesian" Tag="id" IsSelected="True"/>
                                <ComboBoxItem Content="English"    Tag="en"/>
                                <ComboBoxItem Content="Japanese"   Tag="ja"/>
                                <ComboBoxItem Content="Korean"     Tag="ko"/>
                                <ComboBoxItem Content="Spanish"    Tag="es"/>
                                <ComboBoxItem Content="Chinese"    Tag="zh-CN"/>
                                <ComboBoxItem Content="Auto"       Tag="auto"/>
                            </ComboBox>
                        </StackPanel>
                        <Button Grid.Column="1" Content="⇄" Background="Transparent"
                                Foreground="{StaticResource NeonBlueBrush}" BorderThickness="0"
                                FontSize="16" Cursor="Hand" Click="SwapBtn_Click"
                                VerticalAlignment="Bottom" Margin="4,0,4,2"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TO" Foreground="{StaticResource TextMutedBrush}" FontSize="8" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ComboTarget" SelectionChanged="Langs_Changed">
                                <ComboBoxItem Content="English"    Tag="en" IsSelected="True"/>
                                <ComboBoxItem Content="Indonesian" Tag="id"/>
                                <ComboBoxItem Content="Japanese"   Tag="ja"/>
                                <ComboBoxItem Content="Korean"     Tag="ko"/>
                                <ComboBoxItem Content="Spanish"    Tag="es"/>
                                <ComboBoxItem Content="Chinese"    Tag="zh-CN"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Delay Slider -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TYPING DELAY" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SpeedLabel" Grid.Column="1" Text="800 ms"
                                   Foreground="{StaticResource NeonBlueBrush}" FontSize="9" VerticalAlignment="Center"/>
                    </Grid>
                    <Slider x:Name="SpeedSlider" Minimum="300" Maximum="2000" Value="800"
                            TickFrequency="100" IsSnapToTickEnabled="True"
                            ValueChanged="SpeedSlider_ValueChanged" Margin="0,0,0,12"/>

                    <!-- Bubble time (conditional) -->
                    <StackPanel x:Name="BubbleTimePanel" Visibility="Collapsed" Margin="0,0,0,12">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="BUBBLE DURATION" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="9" FontWeight="Bold"/>
                            <TextBlock x:Name="BubbleTimeLabel" Text="4 sec"
                                       Foreground="{StaticResource NeonBlueBrush}" FontSize="9"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="BubbleTimeSlider" Minimum="2" Maximum="15" Value="4"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="BubbleTimeSlider_ValueChanged"/>
                    </StackPanel>

                    <!-- Live Log -->
                    <Border Background="#0D1117" CornerRadius="8" Padding="10,8"
                            BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="LOG" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="9" FontWeight="Bold"/>
                                <Button Content="RESET" HorizontalAlignment="Right"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource DangerBrush}"
                                        FontSize="9" Cursor="Hand" Click="PurgeBtn_Click"/>
                            </Grid>
                            <TextBlock x:Name="LiveLog"
                                       Text="[SYSTEM] Nexus initialized. Standing by...&#x0a;"
                                       Foreground="#00C878" FontSize="10" FontFamily="Consolas"
                                       TextWrapping="Wrap" MaxHeight="60"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
