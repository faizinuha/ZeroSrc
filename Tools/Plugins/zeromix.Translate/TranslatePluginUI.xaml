<UserControl x:Class="ZeroMix.Plugins.Translate.TranslatePluginUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <Storyboard x:Key="FadeIn">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,-10,0,10" To="0,0,0,8" Duration="0:0:0.3">
                    <ThicknessAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </ThicknessAnimation.EasingFunction>
                </ThicknessAnimation>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel x:Name="RootPanel">
        <!-- Main Header Card (Standard Plugin Style) -->
        <Border x:Name="HeaderCard" Style="{StaticResource CompactCardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Box -->
                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="#141922" Margin="0,0,14,0">
                    <TextBlock Text="&#xE8C1;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="{StaticResource NeonBlueBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Information -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Nexus Translator Core" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBlock Text="Next-Gen Realtime Anti-Crash System v2.0" Foreground="{StaticResource SubTextBrush}" FontSize="11"/>
                </StackPanel>

                <!-- Toggle Switch -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <CheckBox x:Name="PowerSwitch" Click="PowerSwitch_Click"
                               Style="{StaticResource ModernCheckBox}" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Configuration Engine (Expandable) -->
        <Border x:Name="CoreSettings" Style="{StaticResource CardBorder}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="ENGINE CONFIGURATION" Foreground="{StaticResource NeonBlueBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,16"/>
                
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Source Lang -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Dari:" Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="4,0,0,4"/>
                        <ComboBox x:Name="ComboSource" Style="{StaticResource ModernComboBox}" SelectionChanged="Langs_Changed">
                            <ComboBoxItem Content="Indonesian" Tag="id" IsSelected="True"/>
                            <ComboBoxItem Content="English" Tag="en"/>
                            <ComboBoxItem Content="Japanese" Tag="ja"/>
                            <ComboBoxItem Content="Korean" Tag="ko"/>
                            <ComboBoxItem Content="Spanish" Tag="es"/>
                            <ComboBoxItem Content="Chinese" Tag="zh-CN"/>
                            <ComboBoxItem Content="Auto Detect" Tag="auto"/>
                        </ComboBox>
                    </StackPanel>

                    <Button Grid.Column="1" Content="⇄" Background="Transparent" Foreground="{StaticResource NeonBlueBrush}" BorderThickness="0" 
                            FontSize="16" Margin="10,20,10,0" Cursor="Hand" Click="SwapBtn_Click" VerticalAlignment="Top"/>

                    <!-- Target Lang -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ke:" Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="4,0,0,4"/>
                        <ComboBox x:Name="ComboTarget" Style="{StaticResource ModernComboBox}" SelectionChanged="Langs_Changed">
                            <ComboBoxItem Content="English" Tag="en" IsSelected="True"/>
                            <ComboBoxItem Content="Indonesian" Tag="id"/>
                            <ComboBoxItem Content="Japanese" Tag="ja"/>
                            <ComboBoxItem Content="Korean" Tag="ko"/>
                            <ComboBoxItem Content="Spanish" Tag="es"/>
                            <ComboBoxItem Content="Chinese" Tag="zh-CN"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Delay Ketikan (ms): Algoritma Anti-Tabrakan" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,20">
                    <Slider x:Name="SpeedSlider" Minimum="300" Maximum="2000" Value="800" TickFrequency="100" IsSnapToTickEnabled="True"
                            VerticalAlignment="Center" ValueChanged="SpeedSlider_ValueChanged"/>
                    <TextBlock x:Name="SpeedLabel" Text="800 ms" Foreground="{StaticResource NeonBlueBrush}" FontSize="10" 
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,-15"/>
                </Grid>

                <!-- Game Mode Toggle -->
                <Border Background="#0D1117" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="🎮 Game Mode" Foreground="White" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="Pakai Clipboard Paste (Ctrl+V) — kompatibel dengan game chat" 
                                       Foreground="{StaticResource SubTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="GameModeSwitch" Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource ModernCheckBox}" Click="GameModeSwitch_Click" Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Selection Bubble Mode -->
                <Border Background="#0D1117" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="💬 Selection Bubble" Foreground="White" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="Highlight + Ctrl+C → bubble popup dengan terjemahan otomatis" 
                                       Foreground="{StaticResource SubTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="BubbleModeSwitch" Grid.Column="1" VerticalAlignment="Center"
                                  Style="{StaticResource ModernCheckBox}" Click="BubbleModeSwitch_Click" Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <!-- OCR Snip Mode -->
                <Border Background="#0D1117" CornerRadius="8" Padding="12" Margin="0,0,0,12" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="🔍 OCR Snip" Foreground="White" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="Screen capture → extract text → translate. Berguna untuk gambar &amp; video" 
                                       Foreground="{StaticResource SubTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button x:Name="OcrSnipButton" Grid.Column="1" VerticalAlignment="Center"
                                Content="📷 SNIP" Background="{StaticResource NeonBlueBrush}" Foreground="White"
                                BorderThickness="0" Padding="8,4" FontSize="10" FontWeight="Bold"
                                Click="OcrSnipButton_Click" Margin="10,0,0,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <Button Content="PURGE MEMORY BUFFER (RESET)" Background="{StaticResource DangerBrush}" Foreground="White" 
                        FontWeight="Bold" BorderThickness="0" Padding="0,10" Cursor="Hand" Click="PurgeBtn_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                
                <!-- Terminal Log -->
                <Border Background="#0D1117" CornerRadius="8" Padding="12" Margin="0,20,0,0" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="LIVE TERMINAL LOG" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="Bold"/>
                            <TextBlock Text="ENC_AES_256" Foreground="{StaticResource NeonBlueBrush}" FontSize="8" HorizontalAlignment="Right" Opacity="0.5"/>
                        </Grid>
                        <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LiveLog" Text="[SYSTEM] Nexus Core initialized. Standing by...&#x0a;" 
                                       Foreground="#00FF88" FontSize="11" TextWrapping="Wrap" FontFamily="Consolas" Opacity="0.9"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
