<Window x:Class="ZeroMix.Updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeroMix Updater"
        Width="500" Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <Storyboard x:Key="PulseAnim" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PulseDot"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0.2" Duration="0:0:0.8"
                             AutoReverse="True"/>
        </Storyboard>
    </Window.Resources>

    <!-- Outer shadow -->
    <Border CornerRadius="16" Background="#0D1117"
            BorderBrush="#1E2633" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── TITLE BAR ── -->
            <Grid Grid.Row="0" Background="#080C12" Height="44"
                  MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="16,16,0,0" Background="Transparent"/>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="16,0,0,0">
                    <Ellipse x:Name="PulseDot" Width="8" Height="8"
                             Fill="#00D68F" Margin="0,0,8,0"/>
                    <TextBlock Text="ZeroMix Updater" Foreground="#8899AA"
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Content="✕" Width="44" Height="44"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#445566" FontSize="13" Cursor="Hand"
                        Click="CloseBtn_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                                CornerRadius="0,16,0,0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#FF3B3B22"/>
                                                <Setter Property="Foreground" Value="#FF5555"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- ── CONTENT ── -->
            <StackPanel Grid.Row="1" Margin="32,24,32,0">

                <!-- Logo + Version info -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon placeholder -->
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                            Margin="0,0,16,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#004D40" Offset="0"/>
                                <GradientStop Color="#0A1628" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="⚡" FontSize="22"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="Checking for updates..."
                                   Foreground="White" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="SubText" Text="Connecting to server..."
                                   Foreground="#556677" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Version badges -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#111620" CornerRadius="8"
                            BorderThickness="1" BorderBrush="#1E2633" Padding="12,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="CURRENT" Foreground="#445566"
                                       FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CurrentVerText" Text="—"
                                       Foreground="#8899AA" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Column="1" Text="→" Foreground="#1E2633"
                               FontSize="18" VerticalAlignment="Center" Margin="10,0"/>

                    <Border Grid.Column="2" Background="#0D1A0D" CornerRadius="8"
                            BorderThickness="1" BorderBrush="#1A3A1A" Padding="12,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="LATEST" Foreground="#2A5A2A"
                                       FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LatestVerText" Text="—"
                                       Foreground="#00D68F" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Progress area -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                    <Grid Margin="0,0,0,6">
                        <TextBlock x:Name="ProgressLabel" Text="Downloading..."
                                   Foreground="#8899AA" FontSize="11"/>
                        <TextBlock x:Name="ProgressPct" Text="0%"
                                   Foreground="#00D68F" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Progress bar track -->
                    <Border Background="#111620" CornerRadius="4" Height="6"
                            BorderThickness="1" BorderBrush="#1E2633">
                        <Border x:Name="ProgressFill" CornerRadius="4" Height="6"
                                HorizontalAlignment="Left" Width="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00A37A" Offset="0"/>
                                    <GradientStop Color="#00D68F" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>

                    <Grid Margin="0,6,0,0">
                        <TextBlock x:Name="SpeedText" Text=""
                                   Foreground="#445566" FontSize="10"/>
                        <TextBlock x:Name="SizeText" Text=""
                                   Foreground="#445566" FontSize="10"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>

                <!-- Status text (idle/done/error) -->
                <TextBlock x:Name="StatusText" Text=""
                           Foreground="#445566" FontSize="11"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>

                <!-- ── Changelog Panel ── -->
                <StackPanel x:Name="ChangelogPanel" Visibility="Collapsed" Margin="0,16,0,0">
                    <Border Height="1" Background="#1E2633" Margin="0,0,0,12"/>
                    <TextBlock x:Name="ChangelogTag"
                               Text="📋 What's new"
                               Foreground="#00D68F" FontSize="11" FontWeight="Bold"
                               Margin="0,0,0,8"/>
                    <Border Background="#080C12" CornerRadius="8"
                            BorderThickness="1" BorderBrush="#1E2633"
                            Padding="12,10" MaxHeight="160">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="ChangelogText"
                                       Foreground="#8899AA" FontSize="11"
                                       TextWrapping="Wrap" LineHeight="18"
                                       FontFamily="Consolas"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ── BOTTOM BUTTONS ── -->
            <Grid Grid.Row="2" Margin="32,16,32,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Cancel / Later -->
                <Button x:Name="CancelBtn" Grid.Column="0" Content="Nanti saja"
                        Height="38" Cursor="Hand" Click="CancelBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="#111620" CornerRadius="9"
                                    BorderThickness="1" BorderBrush="#1E2633">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="#334455"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Foreground>
                        <SolidColorBrush Color="#556677"/>
                    </Button.Foreground>
                    <Button.FontSize>12</Button.FontSize>
                </Button>

                <!-- Update / Install -->
                <Button x:Name="ActionBtn" Grid.Column="2"
                        Content="Update Sekarang" Height="38" Padding="24,0"
                        Cursor="Hand" IsEnabled="False" Click="ActionBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="9">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00A37A" Offset="0"/>
                                        <GradientStop Color="#0066CC" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="b" Property="Opacity" Value="0.35"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Foreground>
                        <SolidColorBrush Color="White"/>
                    </Button.Foreground>
                    <Button.FontSize>12</Button.FontSize>
                    <Button.FontWeight>SemiBold</Button.FontWeight>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
