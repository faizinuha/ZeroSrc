<Window x:Class="ZeroMix.Core.UpdateNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Available" 
        Width="350" Height="150"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        Loaded="Window_Loaded">
    <Border Background="#2D3748" CornerRadius="8" BorderBrush="#4A5568" BorderThickness="1">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Pembaruan Tersedia" Foreground="White" FontSize="16" FontWeight="Bold"/>

            <TextBlock x:Name="UpdateMessage" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="Versi baru ZeroMix telah tersedia. Apakah Anda ingin mengunduh sekarang?" 
                       Foreground="#E2E8F0" FontSize="12" Visibility="Visible"/>

            <StackPanel x:Name="ProgressPanel" Grid.Row="1" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Mengunduh pembaruan..." Foreground="#E2E8F0" FontSize="12" Margin="0,0,0,5"/>
                <ProgressBar x:Name="DownloadProgressBar" Height="8" BorderThickness="0" Background="#4A5568" Foreground="#38A169"/>
                <TextBlock x:Name="ProgressText" Text="0%" HorizontalAlignment="Center" Foreground="#A0AEC0" FontSize="10" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="YesButton" Content="Update Sekarang" Click="YesButton_Click"
                        Style="{StaticResource UpdateButtonStyle}" Background="#38A169"/>
                <Button x:Name="NoButton" Content="Nanti Saja" Click="NoButton_Click" Margin="10,0,0,0"
                        Style="{StaticResource UpdateButtonStyle}" Background="#718096"/>
                <TextBlock x:Name="InstallingText" Text="Menginstal..." Foreground="#A0AEC0" VerticalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>

    <Window.Resources>
        <Style x:Key="UpdateButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
</Window>
