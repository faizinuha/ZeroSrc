<Window x:Class="ZeroMix.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeroMix Installer" Height="420" Width="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#6D28D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#4B5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="#0F0F1A" MouseDown="Window_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Margin="20,16,20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#7C3AED" Margin="0,0,6,0"/>
                    <TextBlock Text="ZeroMix Installer" Foreground="#E5E7EB" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" Click="CloseButton_Click"
                        Background="Transparent" Foreground="#6B7280" BorderThickness="0"
                        FontSize="14" Cursor="Hand" Padding="4"/>
            </Grid>

            <!-- Main Content -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Width="480" Margin="0,10,0,10">

                <TextBlock Text="⚡" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="ZeroMix" Foreground="White" FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Smart Desktop Launcher &amp; System Utilities"
                           Foreground="#9CA3AF" FontSize="13" HorizontalAlignment="Center"
                           Margin="0,4,0,24"/>

                <!-- Status -->
                <TextBlock x:Name="StatusText" Text="Siap untuk menginstall ZeroMix"
                           Foreground="#D1D5DB" FontSize="13" HorizontalAlignment="Center"
                           Margin="0,0,0,12" TextWrapping="Wrap" TextAlignment="Center"/>

                <!-- Progress Bar -->
                <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Value="0"
                             Height="8" Margin="0,0,0,6"
                             Background="#1F2937" Foreground="#7C3AED" BorderThickness="0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Height="8">
                                            <Border x:Name="PART_Track">
                                                <Border x:Name="PART_Indicator"
                                                        Background="{TemplateBinding Foreground}"
                                                        CornerRadius="6"
                                                        HorizontalAlignment="Left"/>
                                            </Border>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <TextBlock x:Name="ProgressText" Text="" Foreground="#6B7280"
                           FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,20"/>

                <Button x:Name="InstallButton" Content="Install Sekarang"
                        Style="{StaticResource RoundButton}"
                        HorizontalAlignment="Center" Width="180"
                        Click="InstallButton_Click"/>

                <Button x:Name="CancelButton" Content="Batal"
                        Background="Transparent" Foreground="#6B7280"
                        BorderThickness="0" FontSize="12" Cursor="Hand"
                        HorizontalAlignment="Center" Margin="0,10,0,0"
                        Click="CancelButton_Click"/>
            </StackPanel>

            <!-- Footer -->
            <TextBlock Grid.Row="2" Text="© 2025 ZeroMix Team · zeromix.vercel.app"
                       Foreground="#374151" FontSize="11" HorizontalAlignment="Center"
                       Margin="0,0,0,14"/>
        </Grid>
    </Border>
</Window>
