<Window x:Class="ZeroMix.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif"
        Title="ZeroMix Installer" Height="480" Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Primary button style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="32,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6D28D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost button style -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#9CA3AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer shadow border -->
    <Border CornerRadius="18" Background="#0D0D1C" MouseDown="Window_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#000000" Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- ── Title Bar ── -->
            <Border Grid.Row="0" CornerRadius="18,18,0,0" Background="#13132A">
                <Grid Margin="18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#7C3AED" Margin="0,0,8,0"/>
                        <TextBlock Text="ZeroMix Installer" Foreground="#C4B5FD"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource GhostButton}"
                            FontSize="14" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- ── Main Content ── -->
            <Grid Grid.Row="1" Margin="40,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo + Title -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,28,0,0">
                    <!-- GIF Loading (visible only during install) -->
                    <Image x:Name="LoadingGif"
                           gif:ImageBehavior.AnimatedSource="{Binding Source={x:Null}}"
                           gif:ImageBehavior.RepeatBehavior="Forever"
                           Width="72" Height="72"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed"
                           Margin="0,0,0,8"/>

                    <!-- Static icon (visible when idle) -->
                    <Border x:Name="LogoIcon" Width="72" Height="72" CornerRadius="20"
                            HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7C3AED" Offset="0"/>
                                <GradientStop Color="#4F46E5" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="⚡" FontSize="36" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="ZeroMix" Foreground="White" FontSize="30" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,4,0,2"/>
                    <TextBlock Text="Smart Desktop Launcher &amp; System Utilities"
                               Foreground="#6B7280" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Version badge -->
                <Border Grid.Row="1" HorizontalAlignment="Center" Margin="0,14,0,0"
                        Background="#1A1A35" CornerRadius="20" Padding="14,5">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="VersionBadge" Text="Checking...  ·  Windows x64"
                                   Foreground="#9CA3AF" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Status + Progress area -->
                <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,24,0,0">
                    <!-- Status message -->
                    <TextBlock x:Name="StatusText"
                               Text="Siap untuk menginstall ZeroMix di komputer Anda."
                               Foreground="#D1D5DB" FontSize="13"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,0,0,16"/>

                    <!-- Progress bar container -->
                    <Border Background="#1F2937" CornerRadius="8" Height="10" Margin="0,0,0,6">
                        <Border x:Name="ProgressFill" Background="#7C3AED"
                                CornerRadius="8" HorizontalAlignment="Left" Width="0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0"
                                                  Color="#7C3AED" Opacity="0.8"/>
                            </Border.Effect>
                        </Border>
                    </Border>

                    <Grid Margin="0,0,0,24">
                        <TextBlock x:Name="StepText" Text="" Foreground="#6B7280"
                                   FontSize="11" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="ProgressText" Text=""
                                   Foreground="#7C3AED" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Buttons -->
                    <Button x:Name="InstallButton" Content="Install Sekarang"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Center" MinWidth="200"
                            Click="InstallButton_Click"/>

                    <Button x:Name="CancelButton" Content="Batal"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Center" Margin="0,8,0,0"
                            Click="CancelButton_Click"/>
                </StackPanel>

                <!-- Divider + features -->
                <StackPanel Grid.Row="3" Margin="0,0,0,20">
                    <Rectangle Height="1" Fill="#1F2937" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="✓ Wallpaper Engine" Foreground="#4B5563" FontSize="11" Margin="0,0,20,0"/>
                        <TextBlock Text="✓ Virtual Assistant" Foreground="#4B5563" FontSize="11" Margin="0,0,20,0"/>
                        <TextBlock Text="✓ Plugin Support" Foreground="#4B5563" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ── Footer ── -->
            <Border Grid.Row="2" CornerRadius="0,0,18,18" Background="#0A0A18">
                <TextBlock Text="© 2026 ZeroMix Team  ·  zeromix.vercel.app"
                           Foreground="#374151" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
