<Window x:Class="ZeroMix.Search.SearchOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZeroMix.Search"
        Title="ZeroMix Search"
        Width="680"
        SizeToContent="Height"
        MaxHeight="600"
        Topmost="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Opacity="0"
        Icon="../zeromix.ico"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.95" To="1" Duration="0:0:0.15">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.1"/>
        </Storyboard>

        <local:SuggestionTypeToStringConverter x:Key="SuggestionTypeConverter"/>
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverterInverse" IsInverse="True"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <FontFamily x:Key="MainFont">'JetBrains Mono', 'Fira Code', 'Segoe UI Variable Display', 'Segoe UI', sans-serif</FontFamily>
        <SolidColorBrush x:Key="PrimaryBackground" Color="#121212"/>
        <SolidColorBrush x:Key="SecondaryBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="AccentColor" Color="#007AFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#333333"/>

        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0,12,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontFamily" Value="{StaticResource MainFont}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            <TextBlock x:Name="Placeholder" Text="Type to search..." 
                                       Margin="{TemplateBinding Padding}"
                                       Foreground="#555555"
                                       FontStyle="Normal"
                                       FontSize="22"
                                       FontFamily="{StaticResource MainFont}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuggestionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#252525"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SuggestionItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#252525" Margin="0,0,12,0">
                    <Grid>
                        <Image Source="{Binding IconSource}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding IconSource, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Visibility="{Binding IconSource, Converter={StaticResource NullToVisibilityConverterInverse}}"/>
                    </Grid>
                </Border>

                <!-- Text -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayText}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                               Visibility="{Binding Subtitle, Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Hint/Shortcut -->
                <Border Grid.Column="2" Background="#252525" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Visibility="{Binding IsTerminal, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                    <TextBlock Text="Run" FontSize="10" Foreground="#888888"/>
                </Border>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <Window.RenderTransform>
        <ScaleTransform ScaleY="1" CenterY="0"/>
    </Window.RenderTransform>

    <Border x:Name="MainBorder" 
            Background="#D9121212" 
            CornerRadius="12" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Color="Black" Opacity="0.5" Direction="270"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Search Bar -->
                <RowDefinition Height="Auto"/> <!-- Suggestions -->
                <RowDefinition Height="Auto"/> <!-- Footer/Notification -->
            </Grid.RowDefinitions>

            <!-- Header / Search Bar -->
            <Grid Grid.Row="0" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Icon -->
                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource TextSecondary}" 
                           VerticalAlignment="Center" Margin="8,0,4,0"/>

                <!-- Input -->
                <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource SearchBoxStyle}"
                         TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"
                         AllowDrop="True" Drop="SearchBox_Drop" DragEnter="SearchBox_DragEnter" DragLeave="SearchBox_DragLeave"/>
                
                <!-- Right Side Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Clock -->
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ClockText" Text="12:00" Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="DateText" Text="Mon, 01 Jan" Foreground="#666666" FontSize="10" HorizontalAlignment="Right"/>
                    </StackPanel>
                    
                    <!-- Settings Button -->
                    <Button x:Name="CustomShortcutButton" Click="CustomShortcutButton_Click"
                            Width="32" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Shortcuts Settings">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" 
                                               Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#252525"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Suggestions List -->
            <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <ListBox x:Name="SuggestionList"
                         Background="Transparent"
                         BorderThickness="0"
                         Visibility="Collapsed"
                         SelectionChanged="SuggestionList_SelectionChanged"
                         MouseDoubleClick="SuggestionList_MouseDoubleClick"
                         KeyDown="SuggestionList_KeyDown"
                         ItemContainerStyle="{StaticResource SuggestionItemStyle}"
                         ItemTemplate="{StaticResource SuggestionItemTemplate}"
                         MaxHeight="400"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Padding="8"/>
            </Border>

            <!-- Notifications -->
            <TextBlock x:Name="NotificationText" Grid.Row="2" 
                       Text="Notification" Foreground="#FF5555" HorizontalAlignment="Center" Margin="0,8" Visibility="Collapsed" FontSize="12"/>

            <!-- Preview Panel (Overlay) -->
            <Border x:Name="PreviewPanel" Grid.Row="0" Grid.RowSpan="3" Background="#F2121212" Visibility="Collapsed" CornerRadius="12" 
                    MouseLeftButtonDown="PreviewPanel_MouseDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Preview Header -->
                    <Grid Grid.Row="0" Margin="16">
                        <TextBlock x:Name="PreviewTitle" Text="Preview" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" 
                                Foreground="{StaticResource TextSecondary}" Background="Transparent" BorderThickness="0"
                                Click="BackFromPreviewButton_Click" Padding="8"/>
                    </Grid>
                    
                    <!-- Preview Content -->
                    <ScrollViewer Grid.Row="1" Padding="16" MaxHeight="450">
                        <StackPanel>
                            <!-- Image Preview -->
                            <Border x:Name="ImagePreviewContainer" CornerRadius="8" ClipToBounds="True" Visibility="Collapsed" Margin="0,0,0,16">
                                <Image x:Name="ImagePreview" Stretch="Uniform" MaxHeight="300" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            
                            <!-- Video Preview -->
                            <Border x:Name="VideoPreviewContainer" CornerRadius="8" ClipToBounds="True" Visibility="Collapsed" Background="Black" Margin="0,0,0,16">
                                <Grid>
                                    <MediaElement x:Name="VideoPreview" LoadedBehavior="Manual" Stretch="Uniform" MaxHeight="300"/>
                                    <!-- Simple Controls -->
                                    <StackPanel x:Name="VideoControlsPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10">
                                        <Button x:Name="PlayButton" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White" Background="Transparent" BorderThickness="0" Click="PlayButton_Click" Margin="8"/>
                                        <Button x:Name="PauseButton" Content="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="White" Background="Transparent" BorderThickness="0" Click="PauseButton_Click" Margin="8"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- File Info -->
                            <StackPanel x:Name="FilePreviewContainer" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,20">
                                <Image x:Name="FileIconPreview" Width="64" Height="64" Margin="0,0,0,12"/>
                                <TextBlock x:Name="FileNamePreview" FontSize="16" FontWeight="SemiBold" Foreground="White" TextAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock x:Name="FileSizePreview" FontSize="12" Foreground="{StaticResource TextSecondary}" TextAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Folder List -->
                            <ListBox x:Name="FolderContentsList" Background="Transparent" BorderThickness="0" Visibility="Collapsed"
                                     ItemContainerStyle="{StaticResource SuggestionItemStyle}" ItemTemplate="{StaticResource SuggestionItemTemplate}"
                                     MouseDoubleClick="FolderContentsList_DoubleClick" PreviewMouseLeftButtonDown="FolderContentsList_PreviewMouseDown"
                                     MouseMove="FolderContentsList_MouseMove" MouseLeftButtonUp="FolderContentsList_MouseUp"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Drag & Drop Overlay Hint -->
            <Border x:Name="DragDropArea" Grid.Row="0" Grid.RowSpan="3" Background="#AA000000" Visibility="Collapsed" CornerRadius="12"
                    AllowDrop="True" Drop="DragDropArea_Drop" DragEnter="DragDropArea_DragEnter" DragLeave="DragDropArea_DragLeave">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Drop items here" FontSize="18" Foreground="White" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>