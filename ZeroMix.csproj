    </Page>
    <Page Include="src\ZeroShell\ZeroShellWindow.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Tools\Plugins\DynamicPluginWindow.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Tools\Plugins\ChargerBatterynotif.core\BatteryNotif.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Tools\Plugins\ChargerBatterynotif.core\ChargerNotifUI.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Tools\Plugins\zeromix.Battery\BatteryNotificationWindow.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Tools\Plugins\zeromix.Battery\BatteryPluginUI.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Tools\Plugins\zeromix.Translate\TranslatePluginUI.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Tools\Plugins\zeromix.weather\WeatherPluginUI.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Tools\Plugins\zeromix.Welcome\WelcomePluginUI.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Tools\Plugins\zeromix.Welcome\WelcomeWindow.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="Tools\zeromix.CreatePlugins\CreatePluginWindow.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\**" />
    <Resource Include="Assets\Resources\Locales\**" />
    <Resource Include="src\SleepMode\IMG\**" />
    <Resource Include="Tools\Plugins\Styles.xaml" />
  </ItemGroup>

  <!-- Wallpaper & anim assets -->
  <ItemGroup>
    <Content Include="Assets\Data\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- FFmpeg -->
  <ItemGroup>
    <Content Include="Tools\FFMPEG\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Plugins: hanya asset runtime (png, wav, gif) — BUKAN source code -->
  <ItemGroup>
    <Content Include="Tools\Plugins\**\*.png" Exclude="Tools\Plugins\**\*.cs;Tools\Plugins\**\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\Plugins\**\*.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\Plugins\**\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\Plugins\**\*.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Styles.xaml dibutuhkan runtime sebagai resource -->
    <Content Include="Tools\Plugins\Styles.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- ZeroShell assets — output ke ZeroShell\, bukan src\ZeroShell\ -->
  <ItemGroup>
    <Content Include="src\ZeroShell\**\*.png">
      <Link>ZeroShell\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Virtual Assistant: model files, thumbnails, html viewer — output ke Virtual_Assisten\ -->
  <!-- TIDAK include .cs, .xaml, .md (source code sensitif) -->
  <ItemGroup>
    <Content Include="src\Virtual_Assisten\**\*.png">
      <Link>Virtual_Assisten\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="src\Virtual_Assisten\**\*.jpg">
      <Link>Virtual_Assisten\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="src\Virtual_Assisten\**\*.html">
      <Link>Virtual_Assisten\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="src\Virtual_Assisten\**\*.json" Exclude="src\Virtual_Assisten\**\*.model3.json">
      <Link>Virtual_Assisten\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Model files Live2D -->
    <Content Include="src\Virtual_Assisten\**\*.model3.json">
      <Link>Virtual_Assisten\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="src\Virtual_Assisten\**\*.moc3">
      <Link>Virtual_Assisten\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="src\Virtual_Assisten\**\*.physics3.json">
      <Link>Virtual_Assisten\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="src\Virtual_Assisten\**\*.exp3.json">
      <Link>Virtual_Assisten\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="src\Virtual_Assisten\**\*.motion3.json">
      <Link>Virtual_Assisten\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Build Updater after main build -->
  <Target Name="BuildUpdater" AfterTargets="Build" Condition="'$(Configuration)'=='Release'">
    <Message Text="Building ZeroMix-Updater..." Importance="high" />
    <Exec Command="dotnet publish Tools/Updater/ZeroMix.Updater.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -o $(OutputPath)Tools/Updater" />
  </Target>

</Project>
