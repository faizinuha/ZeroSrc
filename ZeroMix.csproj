    </Page>
    <Page Include="src\Transparan\TransparentTaskbar.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="src\Virtual_Assisten\VirtualAssistantWindow.xaml">
