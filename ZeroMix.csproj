<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>zeromix.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>5.2.3</Version>
    
    <!-- Optimasi Ukuran & Portabilitas (Self-Contained & Kompresi) -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Mode Debug: Simbol Aktif untuk mempermudah perbaikan -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <!-- Mode Release: Matikan Simbol & Debugging untuk Keamanan -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Masukkan Obfuscar ke dalam proses Build (Hanya dijalankan saat Release) -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <PackageReference Include="Obfuscar" Version="2.2.39" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- Obfuscate hanya di Windows environment untuk Release build -->
  <Target Name="Obfuscate" AfterTargets="AfterBuild" Condition="'$(Configuration)' == 'Release' AND '$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <ObfuscarConfig>$(ProjectDir)obfuscar.xml</ObfuscarConfig>
      <!-- Gunakan path dari package yang di-restore -->
      <ObfuscarExe>"$(PkgObfuscar)\tools\Obfuscar.Console.exe"</ObfuscarExe>
    </PropertyGroup>
    <Message Text="Running Obfuscar: $(ObfuscarExe) $(ObfuscarConfig)" Importance="high" />
    <Exec Command="$(ObfuscarExe) $(ObfuscarConfig)" WorkingDirectory="$(TargetDir)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.2" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.2" />
    <PackageReference Include="Vortice.Direct3D9" Version="3.8.2" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.2" />
    <PackageReference Include="Vortice.Mathematics" Version="2.1.0" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="zeromix.ico" />
    <Resource Include="assets\**" />
    <Resource Include="SleepMode\IMG\**" />
    <Resource Include="ZeroShell\asci\*" />
  </ItemGroup>


  <ItemGroup>
    <Content Include="Resource\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="FFMPEG\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Plugins\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="ZeroShell\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="ZeroShell\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Virtual Assistant assets: copy runtime files (models, textures, json) to output -->
  <ItemGroup>
    <Content Include="Virtual_Assisten\**\*.moc3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Virtual_Assisten\**\*.model3.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Virtual_Assisten\**\*.physics3.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Virtual_Assisten\**\*.vtube.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Virtual_Assisten\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Virtual_Assisten\**\*.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Virtual_Assisten\**\*" Exclude="**\*.cs;**\*.xaml;**\*.user;**\*.vspscc;**\*.dll;**\*.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>