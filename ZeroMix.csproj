    </Page>
    <Page Include="src\SleepMode\SleepOverlayWindow.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="src\Studio\ExportOptionsDialog.xaml">
      <SubType>Designer</SubType>
      <Generator>MSBuild:Compile</Generator>
    </Page>
    <Page Include="src\Studio\StudioWindow.xaml">
      <SubType>Designer</SubType>
