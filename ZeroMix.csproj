<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>zeromix.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    
    <!-- Optimasi Ukuran (Hanya aktif saat Publish) -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MegaApiClient" Version="1.10.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Management" Version="9.0.0" /> 
  </ItemGroup>

  <ItemGroup>
    <Resource Include="zeromix.ico" />
    <Resource Include="assets\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resource\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="FFMPEG\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Plugins\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="AfterPublish" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <Message Text="Menjalankan proses signing installer ZeroMix..." Importance="High" />
    <!-- build.ps1 disabled in favor of Makefile -->
    <!-- <Exec Command='powershell -ExecutionPolicy Bypass -File "$(ProjectDir)build\build.ps1"' Condition="Exists('$(ProjectDir)build\build.ps1')" /> -->
    <!-- <Warning Text="Script build.ps1 tidak ditemukan, melewati langkah signing." Condition="!Exists('$(ProjectDir)build\build.ps1')" /> -->
  </Target>

</Project>