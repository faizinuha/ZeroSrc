<Window x:Class="ZeroMix.ClockWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeroMix Clock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="600"
        Height="400"
        Topmost="True"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <Color x:Key="AccentColor">#8BE9FD</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        
        <Style x:Key="GlowText" TargetType="TextBlock">
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainContainer">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Time Display -->
            <TextBlock Name="TimeDisplay"
                       Text="00:00:00"
                       FontSize="120"
                       FontWeight="ExtraLight"
                       Foreground="White"
                       TextAlignment="Center"
                       Style="{StaticResource GlowText}"
                       FontFamily="Segoe UI Variable Display"/>

            <!-- Date Display -->
            <TextBlock Name="DateDisplay"
                       Text="Loading Horizon..."
                       FontSize="18"
                       FontWeight="Light"
                       Foreground="{StaticResource AccentBrush}"
                       TextAlignment="Center"
                       Opacity="0.8"
                       Margin="0,-10,0,0"
                       FontFamily="Segoe UI Variable Display"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0" Opacity="0.4">
                <TextBlock Name="DayOfWeekDisplay" Text="DAY 000" Foreground="White" FontSize="11" Margin="0,0,20,0"/>
                <TextBlock Name="UtcDisplay" Text="UTC+00:00" Foreground="White" FontSize="11"/>
            </StackPanel>
        </StackPanel>

        <!-- Tooltip for exiting -->
        <TextBlock Text="Double-click or Right-click to close" 
                   VerticalAlignment="Bottom" 
                   HorizontalAlignment="Center" 
                   Foreground="White" 
                   Opacity="0.1" 
                   FontSize="10" 
                   Margin="0,0,0,20">
            <TextBlock.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.3"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.1" Duration="0:0:0.3"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </TextBlock.Triggers>
        </TextBlock>
    </Grid>
</Window>
