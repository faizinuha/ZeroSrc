<Project>
  <PropertyGroup>
    <AssemblyName>ZeroMix</AssemblyName>
    <IntermediateOutputPath>obj\Debug\</IntermediateOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>C:\ZeroMix\ZeroMix\obj\</MSBuildProjectExtensionsPath>
    <_TargetAssemblyProjectName>ZeroMix</_TargetAssemblyProjectName>
    <RootNamespace>ZeroMix</RootNamespace>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\Icons\zeromix.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>7.1.1</Version>
    <!-- Optimasi Ukuran & Portabilitas (Self-Contained & Kompresi) -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <!-- Keep manual control for XAML files -->
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ZeroMix.Installer\**" />
    <EmbeddedResource Remove="ZeroMix.Installer\**" />
    <None Remove="ZeroMix.Installer\**" />
    <Content Remove="ZeroMix.Installer\**" />
  </ItemGroup>
  <!-- Exclude Tools/Updater source dari compile ZeroMix utama -->
  <ItemGroup>
    <Compile Remove="Tools\Updater\**" />
    <EmbeddedResource Remove="Tools\Updater\**" />
    <None Remove="Tools\Updater\**" />
    <Content Remove="Tools\Updater\**" />
  </ItemGroup>
  <!-- Mode Debug: Simbol Aktif untuk mempermudah perbaikan -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
  <!-- Mode Release: Matikan Simbol & Debugging untuk Keamanan -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <!-- Masukkan Obfuscar ke dalam proses Build (Hanya dijalankan saat Release) -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <PackageReference Include="Obfuscar" Version="2.2.39" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>
  <!-- Obfuscate hanya di Windows environment untuk Release build -->
  <Target Name="Obfuscate" AfterTargets="AfterBuild" Condition="'$(Configuration)' == 'Release' AND '$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <ObfuscarConfig>$(ProjectDir)Setup\obfuscar.xml</ObfuscarConfig>
      <!-- Gunakan path dari package yang di-restore -->
      <ObfuscarExe>"$(PkgObfuscar)\tools\Obfuscar.Console.exe"</ObfuscarExe>
    </PropertyGroup>
    <Message Text="Running Obfuscar: $(ObfuscarExe) $(ObfuscarConfig)" Importance="high" />
    <Exec Command="$(ObfuscarExe) $(ObfuscarConfig)" WorkingDirectory="$(TargetDir)" />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.2" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.2" />
    <PackageReference Include="Vortice.Direct3D9" Version="3.8.2" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.2" />
    <PackageReference Include="Vortice.Mathematics" Version="2.1.0" />
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="WpfAnimatedGif" Version="2.0.2" />
    <PackageReference Include="WPF-UI" Version="4.2.1" />
    <PackageReference Include="WPF-UI.Tray" Version="4.2.1" />
    <PackageReference Include="Microsoft.VisualBasic" Version="10.3.0" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Menghindari generate file dokumentasi yang tidak perlu -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Mempercepat kompilasi dengan mematikan pengecekan yang tidak perlu di fase dev -->
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>
  <!-- App.xaml must be explicitly defined as ApplicationDefinition -->
  <ItemGroup>
  </ItemGroup>
  <!-- All XAML Pages using wildcard pattern (simpler than listing each file) -->
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
  <!-- Live2D Cubism Core DLL -->
  <ItemGroup>
    <None Include="src\Native\x64\Live2DCubismCore.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <!-- Icons — copy to output for tray icon -->
  <ItemGroup>
    <Content Include="Assets\Icons\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- Wallpaper & anim assets -->
  <ItemGroup>
    <Content Include="Assets\Data\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- Update scripts — ikut ke output agar Check Update bisa jalankan -->
  <ItemGroup>
    <Content Include="Scripts\zeromix-update.ps1">
      <Link>zeromix-update.ps1</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Scripts\zeromix-update.bat">
      <Link>zeromix-update.bat</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ZeroMix.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- FFmpeg -->
  <ItemGroup>
    <Content Include="Tools\FFMPEG\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- Plugins: hanya asset runtime (png, wav, gif) — BUKAN source code -->
  <ItemGroup>
    <Content Include="Tools\Plugins\**\*.png" Exclude="Tools\Plugins\**\*.cs;Tools\Plugins\**\*.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\Plugins\**\*.gif">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\Plugins\**\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\Plugins\**\*.webm">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Tools\Plugins\**\*.mp4">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Styles.xaml dibutuhkan runtime sebagai resource -->
    <Content Include="Tools\Plugins\Styles.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- ZeroShell assets — output ke ZeroShell\, bukan src\ZeroShell\ -->
  <ItemGroup>
    <Content Include="src\ZeroShell\**\*.png">
      <Link>ZeroShell\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- Virtual Assistant: model files, thumbnails, html viewer — output ke Virtual_Assisten\ -->
  <!-- TIDAK include .cs, .xaml, .md (source code sensitif) -->
  <ItemGroup>
    <Content Include="src\Virtual_Assisten\**\*.png">
      <Link>Virtual_Assisten\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="src\Virtual_Assisten\**\*.jpg">
      <Link>Virtual_Assisten\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="src\Virtual_Assisten\**\*.html">
      <Link>Virtual_Assisten\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="src\Virtual_Assisten\**\*.json" Exclude="src\Virtual_Assisten\**\*.model3.json">
      <Link>Virtual_Assisten\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Model files Live2D -->
    <Content Include="src\Virtual_Assisten\**\*.model3.json">
      <Link>Virtual_Assisten\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="src\Virtual_Assisten\**\*.moc3">
      <Link>Virtual_Assisten\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="src\Virtual_Assisten\**\*.physics3.json">
      <Link>Virtual_Assisten\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="src\Virtual_Assisten\**\*.exp3.json">
      <Link>Virtual_Assisten\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="src\Virtual_Assisten\**\*.motion3.json">
      <Link>Virtual_Assisten\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- Build Updater after main build — hanya jika source berubah -->
  <Target Name="BuildUpdater" AfterTargets="Build" Inputs="Tools/Updater/MainWindow.xaml.cs;Tools/Updater/App.xaml.cs;Tools/Updater/ZeroMix.Updater.csproj" Outputs="$(OutputPath)Tools/Updater/ZeroMix-Updater.exe">
    <Message Text="Building ZeroMix-Updater..." Importance="high" />
    <Exec Command="dotnet publish Tools/Updater/ZeroMix.Updater.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -o $(OutputPath)Tools/Updater" ContinueOnError="true" />
  </Target>
