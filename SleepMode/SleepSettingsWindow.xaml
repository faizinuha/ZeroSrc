<Window x:Class="ZeroMix.SleepMode.SleepSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sleep Mode Settings" Height="650" Width="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="CardHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource GlassBrush}" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="20">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Sleep Mode Settings" 
                           FontSize="20" FontWeight="Bold" 
                           Foreground="{StaticResource NeonBlueBrush}"/>
                <TextBlock Text="Configure how fake sleep behaves" 
                           FontSize="12" Foreground="{StaticResource SubTextBrush}"/>
            </StackPanel>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Trigger Mode (bisa pilih lebih dari satu) -->
                    <TextBlock Text="Behavior Mode (bisa pilih lebih dari 1)" Style="{StaticResource CardHeaderStyle}" Margin="0,10,0,5"/>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <CheckBox x:Name="ManualModeChk" Content="Direct Activation (Manual)" IsChecked="True" Style="{StaticResource ModernCheckBox}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox x:Name="IdleModeChk" Content="Active when Idle" Style="{StaticResource ModernCheckBox}" VerticalAlignment="Center" Margin="0"/>
                                <TextBox x:Name="IdleSecondsTxt" Text="60" Width="40" Margin="10,0,5,0" HorizontalContentAlignment="Center"/>
                                <TextBlock Text="sec" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ShortcutModeChk" Content="Shortcut Activation" Style="{StaticResource ModernCheckBox}" VerticalAlignment="Center" Margin="0"/>
                                <TextBox x:Name="ShortcutTxt" Text="Alt + S" IsReadOnly="True" Width="80" Margin="10,0,0,0" HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Exit Behavior -->
                    <TextBlock Text="Exit Behavior" Style="{StaticResource CardHeaderStyle}" Margin="0,15,0,5"/>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <CheckBox x:Name="ExitMouseMoveChk" Content="Exit on Mouse Move" IsChecked="True" Style="{StaticResource ModernCheckBox}"/>
                            <CheckBox x:Name="ExitMouseDownChk" Content="Exit on Mouse Click" IsChecked="True" Style="{StaticResource ModernCheckBox}"/>
                            <CheckBox x:Name="ExitKeyDownChk" Content="Exit on Key Press" IsChecked="True" Style="{StaticResource ModernCheckBox}"/>
                        </StackPanel>
                    </Border>

                    <!-- Visual Settings -->
                    <TextBlock Text="Visuals &amp; Style" Style="{StaticResource CardHeaderStyle}" Margin="0,15,0,5"/>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <CheckBox x:Name="ShowClockChk" Content="Show Digital Clock" IsChecked="True" Style="{StaticResource ModernCheckBox}"/>
                            <CheckBox x:Name="ShowPixelCharChk" Content="Show Pixel Character" IsChecked="False" Style="{StaticResource ModernCheckBox}"/>
                            <CheckBox x:Name="GlowEffectChk" Content="Neo-Glow Effect" IsChecked="False" Style="{StaticResource ModernCheckBox}"/>
                            
                            <TextBlock Text="Brightness (Opacity)" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,10,0,5"/>
                            <Slider x:Name="BrightnessSld" Minimum="0.2" Maximum="1.0" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                        </StackPanel>
                    </Border>

                    <!-- Advanced Settings -->
                    <TextBlock Text="Advanced" Style="{StaticResource CardHeaderStyle}" Margin="0,15,0,5"/>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <CheckBox x:Name="HideNotificationsChk" Content="Hide Notifications in Sleep" Style="{StaticResource ModernCheckBox}"/>
                            <CheckBox x:Name="DisableAnimsChk" Content="Ultra-Low CPU (No Anims)" Style="{StaticResource ModernCheckBox}"/>
                            <CheckBox x:Name="LowBatteryDisableChk" Content="Auto-Disable on Low Battery" IsChecked="True" Style="{StaticResource ModernCheckBox}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" Click="CancelBtn_Click" Style="{StaticResource CasualBtn}" Width="100" Margin="0,0,10,0"/>
                <Button Content="Start Sleep Mode" Click="StartBtn_Click" Style="{StaticResource PrimaryBtn}" Width="150"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
