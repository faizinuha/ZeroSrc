    <system:String x:Key="Search_DragDropText">ここに画像をドラッグして検索</system:String>
    <system:String x:Key="Search_Settings">設定</system:String>
    <system:String x:Key="Search_Play">▶ 再生</system:String>
    <system:String x:Key="Search_Pause">⏸ 一時停止</system:String>
    <system:String x:Key="Search_Close">✕</system:String>
    
