    <system:String x:Key="Monitor_PurgeCache">キャッシュをクリア</system:String>
    <system:String x:Key="Monitor_Sync">同期</system:String>
    
    <!-- Wallpapers View -->
    <system:String x:Key="Wallpaper_Engine">壁紙エンジン</system:String>
    <system:String x:Key="Wallpaper_Description">壁紙エンジンマネージャーを起動 無料の壁紙ツール</system:String>
    <system:String x:Key="Wallpaper_LaunchBtn">壁紙エンジンを起動</system:String>
    
    <!-- About View -->
    <system:String x:Key="About_Title">ニューラルコア: ZeroMix</system:String>
    <system:String x:Key="About_Description">ZeroMixはWindows用の究極の生産性ハブです。精度と美的支配のために設計されています。</system:String>
    <system:String x:Key="About_Features">リアルタイムの生物測定にインスパイアされたシステム監視、量子壁紙管理、ゴーストレベルのタスクバー透明性と統合されています。</system:String>
    <system:String x:Key="About_CoreVersion">コアバージョン</system:String>
    <system:String x:Key="About_CheckUpdate">更新を確認</system:String>
    <system:String x:Key="About_UpdateAvailable">更新利用可能</system:String>
    <system:String x:Key="About_Credits">外部アセットクレジット</system:String>
    <system:String x:Key="About_CreditText">Pixabayの素晴らしいクリエイターたちに、美しい大気ビデオを提供していただき特に感謝します:</system:String>
    <system:String x:Key="About_NoteWeather">注意: 天気効果は現在の都市時間と実際の条件に基づいて動的に変化します。</system:String>
    
    <!-- Privacy View -->
    <system:String x:Key="Privacy_Title">セキュリティと暗号化</system:String>
    <system:String x:Key="Privacy_KernelProtocol">カーネルプロトコル</system:String>
    <system:String x:Key="Privacy_Description">ZeroMixはローカルマシン上で完全に動作します。外部送信なし。テレメトリなし。あなたのデータはあなたのものです。</system:String>
    <system:String x:Key="Privacy_CloudSync">ゼロ外部クラウド同期</system:String>
    <system:String x:Key="Privacy_LocalAnalysis">ローカルのみのメトリック分析</system:String>
    <system:String x:Key="Privacy_Encryption">暗号化されたローカル構成</system:String>
    <system:String x:Key="Privacy_SecureProtocol">セキュアプロトコル</system:String>
    
    <!-- Plugins View -->
    <system:String x:Key="Plugins_Title">エクステンション</system:String>
    <system:String x:Key="Plugins_Subtitle">カスタムモジュールを使用してエクスペリエンスを向上させます</system:String>
    <system:String x:Key="Plugins_CreateBtn">プラグインを作成</system:String>
    <system:String x:Key="Plugins_Section">プラグイン &amp; エクステンション</system:String>
    
    <!-- Recorder View -->
    <system:String x:Key="Recorder_Title">画面録画</system:String>
    <system:String x:Key="Recorder_Subtitle">GPU高速化シネマティックスクリーンスタジオ</system:String>
    <system:String x:Key="Recorder_VideoEngine">ビデオエンジン</system:String>
    <system:String x:Key="Recorder_Framerate">フレームレート (FPS)</system:String>
    <system:String x:Key="Recorder_30FPS">30 FPS - 標準</system:String>
    <system:String x:Key="Recorder_45FPS">45 FPS - スムーズ</system:String>
    <system:String x:Key="Recorder_60FPS">60 FPS - プロモーション</system:String>
    <system:String x:Key="Recorder_Hotkey">ホットキー切り替え</system:String>
    <system:String x:Key="Recorder_ChangeShortcut">クリックしてショートカットを変更</system:String>
    <system:String x:Key="Recorder_AudioSource">オーディオソース</system:String>
    <system:String x:Key="Recorder_Microphone">マイク</system:String>
    <system:String x:Key="Recorder_SystemDefault">システムデフォルト</system:String>
    <system:String x:Key="Recorder_Speakers">システムスピーカー</system:String>
    <system:String x:Key="Recorder_Footer">DXGIミラーリングエンジン • 1080pシネマティック</system:String>
    
