    <system:String x:Key="Category_Browser">ブラウザ</system:String>
    <system:String x:Key="Category_MediaPlayer">メディアプレーヤー</system:String>
    <system:String x:Key="Category_Terminal">ターミナル</system:String>
    <system:String x:Key="Category_Office">オフィスアプリケーション</system:String>
    <system:String x:Key="Category_DevTool">開発ツール</system:String>
    <system:String x:Key="Category_Application">アプリケーション</system:String>
    
    <!-- SearchOverlay Messages -->
    <system:String x:Key="Msg_CalcCopied">✓ コピー済み: {0}</system:String>
    <system:String x:Key="Msg_ConfirmSystemAction">確認</system:String>
    <system:String x:Key="Msg_SleepWarning">コンピュータは10秒でスリープします。キャンセルしますか？</system:String>
    <system:String x:Key="Msg_ShutdownWarning">コンピュータは10秒でシャットダウンします。キャンセルしますか？</system:String>
    <system:String x:Key="Msg_RestartWarning">コンピュータは10秒で再起動します。キャンセルしますか？</system:String>
    <system:String x:Key="Msg_CalculatorResult">計算機の結果</system:String>
    
