<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    
    <!-- Wizard / Welcome -->
    <system:String x:Key="Wiz_Welcome">ZeroMixへようこそ</system:String>
    <system:String x:Key="Wiz_Subtitle">次世代のシネマティックスクリーンスタジオ。</system:String>
    <system:String x:Key="Wiz_SelectLang">言語を選択してください</system:String>
    <system:String x:Key="Wiz_Next">次へ</system:String>
    
    <!-- Dashboard Navigation -->
    <system:String x:Key="Nav_Home">ホーム</system:String>
    <system:String x:Key="Nav_Wallpapers">壁紙</system:String>
