    <system:String x:Key="Home_NeuralClock">ニューラルクロック</system:String>
    <system:String x:Key="Home_GhostTaskbar">ゴーストタスクバー</system:String>
    <system:String x:Key="Home_ZeroRecord">画面録画</system:String>
    
    <!-- Monitoring Panel -->
    <system:String x:Key="Monitor_CoreStats">コア統計</system:String>
    <system:String x:Key="Monitor_CPUEngine">CPUエンジン</system:String>
    <system:String x:Key="Monitor_MemoryArray">メモリアレイ</system:String>
    <system:String x:Key="Monitor_DataStream">データストリーム</system:String>
    <system:String x:Key="Monitor_SystemRegistry">システムレジストリ</system:String>
    <system:String x:Key="Monitor_OSVersion">OS: 読み込み中...</system:String>
    <system:String x:Key="Monitor_Processor">CPU: アーキテクチャ</system:String>
    <system:String x:Key="Monitor_TotalRam">RAM: 計算中</system:String>
    <system:String x:Key="Monitor_Network">ネット: スキャン中</system:String>
