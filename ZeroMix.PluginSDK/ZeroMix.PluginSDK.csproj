<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- NuGet Package Info -->
    <PackageId>ZeroMix.PluginSDK</PackageId>
    <Version>1.0.0</Version>
    <Authors>faizinuha</Authors>
    <Company>ZeroMix Team</Company>
    <Description>SDK for building ZeroMix plugins. Provides interfaces and base types for plugin development.</Description>
    <PackageTags>zeromix;plugin;sdk;wpf</PackageTags>
    <RepositoryUrl>https://github.com/faizinuha/ZeroMix</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
