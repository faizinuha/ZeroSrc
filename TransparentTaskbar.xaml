<Window x:Class="ZeroMix.TransparentTaskbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeroMix Taskbar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Height="60"
        Width="{Binding SystemParameters.PrimaryScreenWidth}"
        ResizeMode="NoResize"
        Topmost="True"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Colors for Glass Morphism -->
        <Color x:Key="GlassBackground">#0F0F0F</Color>
        <Color x:Key="GlassOverlay">#1A1A2E</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="HoverColor">#2A2A3E</Color>

        <SolidColorBrush x:Key="GlassBrush" Color="{StaticResource GlassOverlay}" Opacity="0.8"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" Opacity="0.6"/>

        <!-- Button Style -->
        <Style x:Key="TaskbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource GlassBrush}" 
            CornerRadius="0,0,16,16"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="0,0,0,1"
            Effect="None">

        <Grid Margin="15,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo / App Name -->
            <StackPanel Grid.Column="0" 
                       VerticalAlignment="Center"
                       Orientation="Horizontal"
                       Margin="10,0,20,0">
                <TextBlock Text="⚡" FontSize="18" Margin="0,0,8,0"/>
                <TextBlock Text="ZeroMix"
                          FontSize="14"
                          FontWeight="Bold"
                          Foreground="{StaticResource AccentBrush}"
                          VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Center App Buttons -->
            <StackPanel Grid.Column="1" 
                       Orientation="Horizontal" 
                       VerticalAlignment="Center"
                       Margin="20,0">
                <Button Style="{StaticResource TaskbarButton}" 
                       Content="🏠 Home"
                       Name="HomeTaskbarBtn"
                       Click="HomeTaskbarBtn_Click"/>
                <Button Style="{StaticResource TaskbarButton}" 
                       Content="📊 Dashboard"
                       Name="DashboardTaskbarBtn"
                       Click="DashboardTaskbarBtn_Click"
                       Margin="8,0,0,0"/>
                <Button Style="{StaticResource TaskbarButton}" 
                       Content="🎮 Launcher"
                       Name="LauncherTaskbarBtn"
                       Click="LauncherTaskbarBtn_Click"
                       Margin="8,0,0,0"/>
                <Button Style="{StaticResource TaskbarButton}" 
                       Content="⚙️ Settings"
                       Name="SettingsTaskbarBtn"
                       Click="SettingsTaskbarBtn_Click"
                       Margin="8,0,0,0"/>
            </StackPanel>

            <!-- Right Side Info -->
            <StackPanel Grid.Column="2" 
                       Orientation="Horizontal"
                       VerticalAlignment="Center"
                       Margin="20,0,15,0"
                       Gap="15">
                <!-- Time -->
                <TextBlock Name="TimeDisplay"
                          Text="14:23"
                          FontSize="12"
                          Foreground="{StaticResource TextBrush}"
                          VerticalAlignment="Center"
                          FontFamily="Courier New"
                          FontWeight="Bold"/>

                <!-- Separator -->
                <Border Width="1" Background="{StaticResource AccentBrush}" Opacity="0.3"/>

                <!-- CPU -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Gap="4">
                    <TextBlock Text="CPU:" FontSize="11" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Name="CpuDisplay" 
                              Text="00%"
                              FontSize="11" 
                              Foreground="{StaticResource AccentBrush}"
                              FontWeight="Bold"
                              MinWidth="35"/>
                </StackPanel>

                <!-- RAM -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Gap="4">
                    <TextBlock Text="RAM:" FontSize="11" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Name="RamDisplay" 
                              Text="00%"
                              FontSize="11" 
                              Foreground="{StaticResource AccentBrush}"
                              FontWeight="Bold"
                              MinWidth="35"/>
                </StackPanel>
            </StackPanel>

            <!-- Right Buttons -->
            <StackPanel Grid.Column="3" 
                       Orientation="Horizontal"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       Gap="8">
                <Button Style="{StaticResource TaskbarButton}" 
                       Content="📌"
                       Name="PinButton"
                       Click="PinButton_Click"
                       ToolTip="Pin to Top"
                       Padding="8,8"/>
                <Button Style="{StaticResource TaskbarButton}" 
                       Content="⚙️"
                       Name="TaskbarSettingsBtn"
                       Click="TaskbarSettingsBtn_Click"
                       ToolTip="Taskbar Settings"
                       Padding="8,8"/>
            </StackPanel>

            <!-- Close Button -->
            <Button Grid.Column="4" 
                   Style="{StaticResource TaskbarButton}" 
                   Content="✕"
                   Click="CloseTaskbarBtn_Click"
                   Foreground="#FF6B6B"
                   ToolTip="Close"
                   Padding="8,8"/>
        </Grid>
    </Border>
</Window>
