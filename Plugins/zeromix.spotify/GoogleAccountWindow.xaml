<Window x:Class="ZeroMix.Plugins.Spotify.GoogleAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Google Account"
        Height="280"
        Width="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border CornerRadius="12"
            BorderThickness="1"
            BorderBrush="#40FFFFFF">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F0FFD1DC" Offset="0.0"/>
                <GradientStop Color="#F0FFB6C1" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#20000000" 
                              BlurRadius="20" 
                              ShadowDepth="0" 
                              Direction="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <!-- Title Bar -->
                <RowDefinition Height="*"/>
                <!-- Content -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" 
                    Background="#20000000" 
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Google Account" 
                               FontWeight="SemiBold" 
                               FontSize="13"
                               Foreground="White" 
                               VerticalAlignment="Center" 
                               Margin="15,0,0,0"/>
                    <Button x:Name="CloseBtn"
                            Content="✕"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="36"
                            Height="36"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"
                            Click="CloseBtn_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="0,12,0,0">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#40FF6B6B"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="24,20,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Profile -->
                    <RowDefinition Height="*"/>
                    <!-- Spacer -->
                    <RowDefinition Height="Auto"/>
                    <!-- Actions -->
                </Grid.RowDefinitions>

                <!-- Profile Info -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Width="56" Height="56" CornerRadius="28">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF69B4" Offset="0"/>
                                <GradientStop Color="#FF1493" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Ellipse Fill="#30FFFFFF"/>
                            <Image x:Name="ProfileImg" Stretch="UniformToFill">
                                <Image.Clip>
                                    <EllipseGeometry Center="28,28" RadiusX="28" RadiusY="28"/>
                                </Image.Clip>
                            </Image>
                            <!-- Default Icon when no image -->
                            <TextBlock x:Name="DefaultIcon"
                                       Text="👤"
                                       FontSize="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="UserNameText"
                                   Text="Guest"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="White"/>
                        <TextBlock x:Name="UserStatusText"
                                   Text="Belum terhubung"
                                   FontSize="12"
                                   Foreground="#E0FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Bottom Actions -->
                <StackPanel Grid.Row="2">
                    <Button x:Name="LoginBtn"
                            Content="🔗  Hubungkan Google"
                            Background="#FF69B4"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="0,14"
                            FontWeight="SemiBold"
                            FontSize="13"
                            HorizontalAlignment="Stretch"
                            Cursor="Hand"
                            Margin="0,0,0,10">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="8"
                                                    x:Name="border">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FF1493"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <Button x:Name="LogoutBtn"
                            Content="Putuskan Koneksi"
                            Background="#40000000"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="0,12"
                            FontWeight="Normal"
                            FontSize="12"
                            HorizontalAlignment="Stretch"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Click="Logout_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="8"
                                                    x:Name="border">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#60000000"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <TextBlock x:Name="StatusText"
                               Text=""
                               FontSize="11"
                               Foreground="White"
                               Opacity="0.6"
                               TextAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
