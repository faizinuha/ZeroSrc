<Window x:Class="ZeroMix.Plugins.Spotify.SpotifySidebar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Google Account"
        Height="1080"
        Width="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">

    <Border CornerRadius="0"
            BorderThickness="0,0,1,0"
            BorderBrush="#FF69B4">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,1">
                <GradientStop Color="#EEFFD1DC"
                              Offset="0.0"/>
                <GradientStop Color="#EEFFB6C1"
                              Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="20,30,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Profile -->
                <RowDefinition Height="*"/>
                <!-- Spacer -->
                <RowDefinition Height="Auto"/>
                <!-- Actions -->
            </Grid.RowDefinitions>

            <!-- Profile Info -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="45"
                        Height="45"
                        CornerRadius="0"
                        BorderThickness="2"
                        BorderBrush="White">
                    <Grid>
                        <Ellipse Fill="#4DFFD1DC"/>
                        <Image x:Name="ProfileImg"
                               Stretch="UniformToFill">
                            <Image.Clip>
                                <EllipseGeometry Center="22.5,22.5"
                                                 RadiusX="22.5"
                                                 RadiusY="22.5"/>
                            </Image.Clip>
                        </Image>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="UserNameText"
                               Text="Guest"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="White"/>
                    <TextBlock x:Name="UserStatusText"
                               Text="Offline"
                               FontSize="10"
                               Foreground="#F0F0F0"
                               Opacity="0.7"/>
                </StackPanel>
            </Grid>

            <!-- Bottom Actions -->
            <StackPanel Grid.Row="2">
                <Button x:Name="LoginBtn"
                        Content="Login accout Google"
                        Background="#FF69B4"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="15,10"
                        FontWeight="Bold"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,5"/>
                <Button x:Name="LogoutBtn"
                        Content="DISCONNECT GOOGLE"
                        Background="#FF69B4"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="15,10"
                        FontWeight="Bold"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,10"
                        Visibility="Collapsed"
                        Click="Logout_Click"/>
                <TextBlock x:Name="StatusText"
                           Text="Offline"
                           FontSize="9"
                           Foreground="White"
                           Opacity="0.5"
                           TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>