<Window x:Class="ZeroMix.Plugins.Spotify.SpotifySidebar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotify Sidebar"
        Height="1080"
        Width="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SpotifyStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="0"
            BorderThickness="0,0,1,0"
            BorderBrush="{StaticResource HotPinkBrush}">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,1">
                <GradientStop Color="#EEFFD1DC"
                              Offset="0.0"/>
                <GradientStop Color="#EEFFB6C1"
                              Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="20,30,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Profile -->
                <RowDefinition Height="Auto"/>
                <!-- Search -->
                <RowDefinition Height="*"/>
                <!-- Player & Bookmarks -->
                <RowDefinition Height="Auto"/>
                <!-- Actions -->
            </Grid.RowDefinitions>

            <!-- Profile Info -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="45"
                        Height="45"
                        CornerRadius="0"
                        BorderThickness="2"
                        BorderBrush="White">
                    <Grid>
                        <Ellipse Fill="{StaticResource GlassPinkBrush}"/>
                        <Image x:Name="ProfileImg"
                               Stretch="UniformToFill">
                            <Image.Clip>
                                <EllipseGeometry Center="22.5,22.5"
                                                 RadiusX="22.5"
                                                 RadiusY="22.5"/>
                            </Image.Clip>
                        </Image>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="UserNameText"
                               Text="Spotify Guest"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="White"/>
                    <TextBlock x:Name="UserStatusText"
                               Text="Offline"
                               FontSize="10"
                               Foreground="#F0F0F0"
                               Opacity="0.7"/>
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button Content=""
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="16"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Margin="0,0,10,0"/>
                </StackPanel>
            </Grid>

            <!-- Search Bar -->
            <Border Grid.Row="1"
                    Background="{StaticResource GlassPinkBrush}"
                    CornerRadius="0"
                    Padding="12,8"
                    Margin="0,0,0,25"
                    BorderThickness="1"
                    BorderBrush="#44FFFFFF">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text=""
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1"
                             x:Name="SearchBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             FontSize="13"
                             VerticalAlignment="Center"
                             KeyDown="SearchBox_KeyDown">
                        <TextBox.Resources>
                            <VisualBrush x:Key="Placeholder"
                                         Visual="{Binding ElementName=PlaceholderText}"/>
                        </TextBox.Resources>
                    </TextBox>
                    <TextBlock Grid.Column="1"
                               x:Name="PlaceholderText"
                               Text="Search Spotify..."
                               Foreground="#CCFFFFFF"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- Main Content Area (Scrollable) -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <!-- Search Results Panel -->
                    <StackPanel x:Name="SearchResultsPanel"
                                Visibility="Collapsed"
                                Margin="0,0,0,20">
                        <TextBlock Text="SEARCH RESULTS"
                                   FontSize="10"
                                   FontWeight="Black"
                                   Foreground="White"
                                   Opacity="0.6"
                                   Margin="5,0,0,10"/>
                        <ItemsControl x:Name="SearchResultsList"/>
                    </StackPanel>

                    <!-- Player Card -->
                    <Border Background="#33000000"
                            CornerRadius="0"
                            Padding="20"
                            Margin="0,0,0,25">
                        <StackPanel>
                            <Border CornerRadius="15"
                                    Width="180"
                                    Height="180"
                                    Margin="0,0,0,15">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20"
                                                      Color="#FF69B4"
                                                      Opacity="0.3"
                                                      ShadowDepth="0"/>
                                </Border.Effect>
                                <Grid>
                                    <Rectangle Fill="#222"
                                               RadiusX="0"
                                               RadiusY="0"/>
                                    <Image x:Name="AlbumCoverImg"
                                           Stretch="UniformToFill"/>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="SongTitleText"
                                       Text="Not Playing"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="ArtistNameText"
                                       Text="Connect to play"
                                       FontSize="12"
                                       Foreground="#EEE"
                                       TextAlignment="Center"
                                       Margin="0,0,0,20"/>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <Button Content=""
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="18"
                                        Background="Transparent"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Margin="8,0"/>
                                <Button x:Name="PlayPauseBtn"
                                        Content=""
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="32"
                                        Background="Transparent"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Margin="15,0"/>
                                <Button Content=""
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="18"
                                        Background="Transparent"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Margin="8,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Bookmarks / Liked Songs -->
                    <TextBlock Text="LIKED SONGS"
                               FontSize="10"
                               FontWeight="Black"
                               Foreground="White"
                               Opacity="0.6"
                               Margin="5,0,0,10"/>
                    <ItemsControl x:Name="LikedSongsList"/>
                    <TextBlock x:Name="EmptyBookmarksMsg"
                               Text="No bookmarks yet. Search and add some!"
                               FontSize="11"
                               Foreground="#AAA"
                               TextAlignment="Center"
                               Margin="0,20,0,20"
                               Visibility="Visible"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Actions -->
            <StackPanel Grid.Row="3">
                <Button x:Name="LoginBtn"
                        Content="CONNECT SPOTIFY ACCOUNT"
                        Style="{StaticResource SpotifyPinkButton}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,5"/>
                <Button x:Name="LogoutBtn"
                        Content="DISCONNECT"
                        Style="{StaticResource SpotifyPinkButton}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,10"
                        Visibility="Collapsed"
                        Click="Logout_Click"/>
                <TextBlock x:Name="StatusText"
                           Text="Offline - Using Local Bookmarks"
                           FontSize="9"
                           Foreground="White"
                           Opacity="0.5"
                           TextAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
