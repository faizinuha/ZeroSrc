<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Spotify Pink Theme Colors -->
    <Color x:Key="SpotifyPinkColor">#FFD1DC</Color>
    <Color x:Key="HotPinkColor">#FF69B4</Color>
    <Color x:Key="DeepPinkColor">#FF1493</Color>
    <Color x:Key="SoftPinkColor">#FFF0F5</Color>
    <Color x:Key="GlassPinkColor">#4DFFD1DC</Color> <!-- 30% Opacity -->
    
    <SolidColorBrush x:Key="SpotifyPinkBrush" Color="{StaticResource SpotifyPinkColor}"/>
    <SolidColorBrush x:Key="HotPinkBrush" Color="{StaticResource HotPinkColor}"/>
    <SolidColorBrush x:Key="DeepPinkBrush" Color="{StaticResource DeepPinkColor}"/>
    <SolidColorBrush x:Key="SoftPinkBrush" Color="{StaticResource SoftPinkColor}"/>
    <SolidColorBrush x:Key="GlassPinkBrush" Color="{StaticResource GlassPinkColor}"/>
    
    <Style x:Key="SpotifyPinkButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource HotPinkBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="15,10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
