<UserControl x:Class="ZeroMix.Plugins.Battery.BatteryPluginUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="150"
             d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary Source="../Styles.xaml"/>
    </UserControl.Resources>

    <StackPanel>
        <Border x:Name="BatteryCard"
                Style="{StaticResource CompactCardBorder}"
                MouseDown="BatteryCard_MouseDown"
                Cursor="Hand">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon -->
                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="#141922" Margin="0,0,14,0">
                    <TextBlock Text="&#xEBA7;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="#00D68F"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Battery Assistant" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBlock Text="Cute mascot notifications when battery is low." Foreground="{StaticResource SubTextBrush}" FontSize="11"/>

                    <!-- Progress -->
                    <StackPanel x:Name="PluginProgressPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock x:Name="PluginStatusText" Text="Processing Plugin... 0%" Foreground="{StaticResource NeonBlueBrush}" FontSize="11" Margin="0,0,0,5"/>
                        <ProgressBar x:Name="PluginProgressBar" Height="4" Maximum="100" Foreground="{StaticResource NeonBlueBrush}" Background="#141922" BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SetupBatteryBtn" Content="&#xE713;"
                            FontFamily="Segoe MDL2 Assets"
                            Style="{StaticResource ActionButton}"
                            Padding="10"
                            FontSize="14"
                            Margin="0,0,10,0"
                            Click="SetupBatteryBtn_Click"
                            VerticalAlignment="Center"/>
                    <CheckBox x:Name="BatteryPluginToggle" VerticalAlignment="Center"
                              Click="BatteryPluginToggle_Click"
                              Style="{StaticResource ModernCheckBox}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Settings Panel (Expanded) -->
        <Border x:Name="BatterySettingsBorder"
                Style="{StaticResource CardBorder}"
                Visibility="Collapsed"
                Margin="0,0,0,0">
            <StackPanel>
                <TextBlock Text="CUSTOMIZE MASCOT DIALOG"
                        FontWeight="Bold"
                        Foreground="{StaticResource NeonBlueBrush}"
                        FontSize="10"
                        Margin="0,0,0,16"/>

                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,8,10">
                        <TextBlock Text="🌅 Pagi" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtMorning" Background="#141922" Foreground="White" Padding="10,8" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="☀️ Siang" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtAfternoon" Background="#141922" Foreground="White" Padding="10,8" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,10">
                        <TextBlock Text="🌇 Sore" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtEvening" Background="#141922" Foreground="White" Padding="10,8" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="🌙 Malam" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtNight" Background="#141922" Foreground="White" Padding="10,8" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                </UniformGrid>

                <TextBlock Text="⚠️ Battery Warnings" Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,10,0,6"/>
                <TextBox x:Name="TxtBattWarn" Background="#141922" Foreground="White" Padding="10,8" Margin="0,0,0,8" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                    <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                </TextBox>
                <TextBox x:Name="TxtBattCrit" Background="#141922" Foreground="White" Padding="10,8" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                    <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources>
                </TextBox>

                <Button Content="Save Dialog" Style="{StaticResource ActionButton}" Margin="0,16,0,0" Click="SaveDialog_Click" HorizontalAlignment="Left" Padding="24,10"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
