<Window x:Class="ZeroMix.SearchOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZeroMix"
        Title="ZeroMix"
        Width="600"
        SizeToContent="Height"
        MaxHeight="700"
        Topmost="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Opacity="0"
        Icon="zeromix.ico"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.98"
                             To="1"
                             Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <QuarticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.98"
                             To="1"
                             Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <QuarticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            
            <!-- Animasi untuk menggambar logo Z -->
            <DoubleAnimation Storyboard.TargetName="ZLogoPath"
                             Storyboard.TargetProperty="StrokeDashOffset"
                             From="80" 
                             To="0"
                             BeginTime="0:0:0.05"
                             Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1"
                             To="0"
                             Duration="0:0:0.1"/>
        </Storyboard>

        <local:SuggestionTypeToStringConverter x:Key="SuggestionTypeConverter"/>

        <DropShadowEffect x:Key="MacShadow"
                          BlurRadius="25"
                          ShadowDepth="0"
                          Color="#000000"
                          Opacity="0.25"
                          RenderingBias="Performance"/>

        <LinearGradientBrush x:Key="ZGradient"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#4285F4"
                          Offset="0.0"/>
            <GradientStop Color="#34A853"
                          Offset="0.33"/>
            <GradientStop Color="#FBBC05"
                          Offset="0.66"/>
            <GradientStop Color="#EA4335"
                          Offset="1.0"/>
        </LinearGradientBrush>

        <FontFamily x:Key="MacFont">Segoe UI, -apple-system, BlinkMacSystemFont, 'San Francisco', 'Helvetica Neue', sans-serif</FontFamily>

        <Style x:Key="SearchBoxStyle"
               TargetType="TextBox">
            <Setter Property="FontSize"
                    Value="20"/>
            <Setter Property="Height"
                    Value="48"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="16,0,8,0"/>
            <Setter Property="Foreground"
                    Value="#1A1A1A"/>
            <Setter Property="FontWeight"
                    Value="Normal"/>
            <Setter Property="FontFamily"
                    Value="{StaticResource MacFont}"/>
            <Setter Property="CaretBrush"
                    Value="#007AFF"/>
        </Style>

        <ControlTemplate x:Key="SearchBoxPlaceholderTemplate"
                         TargetType="{x:Type TextBox}">
            <Grid>
                <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True"/>
                <ScrollViewer x:Name="PART_ContentHost"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                <TextBlock x:Name="Placeholder"
                           Margin="{TemplateBinding Padding}"
                           Foreground="#8E8E93"
                           FontStyle="Normal"
                           FontSize="20"
                           FontFamily="{StaticResource MacFont}"
                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility"
                                    Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static local:StringToVisibilityConverter.Instance}}"
                                             Value="Collapsed">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </ControlTemplate>

        <Style x:Key="SuggestionItemStyle"
               TargetType="ListBoxItem">
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="Margin"
                    Value="0"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="#1A1A1A"/>
            <Setter Property="FontWeight"
                    Value="Normal"/>
            <Setter Property="FontFamily"
                    Value="{StaticResource MacFont}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0"
                                Padding="8,10,8,10"
                                BorderThickness="0,1,0,0"
                                BorderBrush="#F0F0F0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#F8F8FA"/>
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#007AFF"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                                <Setter TargetName="Border"
                                        Property="BorderBrush"
                                        Value="#007AFF"/>
                            </Trigger>
                            
                            <!-- Pink Style for Terminal Commands -->
                            <DataTrigger Binding="{Binding IsTerminal}" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF007F"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FF007F"/>
                            </DataTrigger>
                            
                            <!-- Ensure Pink overrides Blue if both Selected and Terminal -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsTerminal}" Value="True"/>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#FF007F"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FF007F"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SuggestionItemTemplate">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Container with rounded background -->
                <Border Grid.Column="0" 
                        Width="40" 
                        Height="40"
                        CornerRadius="8"
                        Background="#F2F2F7"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="8,0,12,0">
                    
                    <!-- Colorful Icon dari .exe file -->
                    <Image Source="{Binding IconSource}"
                           Width="28"
                           Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding IconSource, Converter={x:Static local:NullToVisibilityConverter.Instance}}"/>
                </Border>

                <!-- Icon Fallback Container -->
                <Border Grid.Column="0" 
                        Width="40" 
                        Height="40"
                        CornerRadius="8"
                        Background="#007AFF"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="8,0,12,0"
                        Visibility="{Binding IconSource, Converter={x:Static local:NullToVisibilityConverter.InstanceInverse}}">
                    <TextBlock Text="{Binding Icon}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Text Container (Title + Subtitle) -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="4,0,12,0">
                    <TextBlock Text="{Binding DisplayText}"
                               TextTrimming="CharacterEllipsis"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#1A1A1A"
                               LineHeight="18"/>
                    
                    <TextBlock Text="{Binding Subtitle}"
                               TextTrimming="CharacterEllipsis"
                               FontSize="11"
                               Opacity="0.6"
                               Foreground="#666666"
                               Visibility="{Binding Subtitle, Converter={x:Static local:StringToVisibilityConverter.Instance}}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Window.RenderTransform>
        <ScaleTransform ScaleX="1"
                        ScaleY="1"
                        CenterX="450"
                        CenterY="350"/>
    </Window.RenderTransform>

    <Grid>
        <Border x:Name="MainBorder"
                CornerRadius="18"
                Background="#CCF2F2F7"
                BorderBrush="#20000000"
                BorderThickness="1"
                Effect="{StaticResource MacShadow}"
                CacheMode="BitmapCache">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search Bar Header -->
                <Grid Grid.Row="0"
                      Grid.Column="0"
                      Grid.ColumnSpan="3"
                      Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Grid.Column="0"
                             Margin="12,0,0,0"
                             VerticalAlignment="Center"
                             Height="40"
                             Width="40">
                        <Canvas Width="32"
                                Height="32">
                            <Path x:Name="ZLogoPath"
                                  Data="M 4,6 L 28,6 L 4,26 L 28,26"
                                  StrokeThickness="5"
                                  Stroke="{StaticResource ZGradient}"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeDashArray="80"
                                  StrokeDashOffset="80"
                                  />
                        </Canvas>
                    </Viewbox>

                    <TextBox Name="SearchBox"
                             Grid.Column="1"
                             Padding="8,0,16,0"
                             Margin="0,12,16,12"
                             KeyDown="SearchBox_KeyDown"
                             TextChanged="SearchBox_TextChanged"
                             Style="{StaticResource SearchBoxStyle}"
                             Template="{StaticResource SearchBoxPlaceholderTemplate}"
                             AllowDrop="True"
                             Drop="SearchBox_Drop"
                             DragEnter="SearchBox_DragEnter"
                             DragLeave="SearchBox_DragLeave"/>

                    <!-- Clock Display -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Margin="0,0,50,0">
                        <TextBlock Name="ClockText"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#1A1A1A"
                                   FontFamily="{StaticResource MacFont}"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Name="DateText"
                                   FontSize="11"
                                   Foreground="#8E8E93"
                                   FontFamily="{StaticResource MacFont}"
                                   HorizontalAlignment="Right"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Drag & Drop Area -->
                <Border Name="DragDropArea"
                        Grid.Row="1"
                        Margin="16,0,16,8"
                        Height="80"
                        CornerRadius="12"
                        Background="#10007AFF"
                        BorderBrush="#30007AFF"
                        BorderThickness="2"
                        Visibility="Collapsed"
                        AllowDrop="True"
                        Drop="DragDropArea_Drop"
                        DragEnter="DragDropArea_DragEnter"
                        DragLeave="DragDropArea_DragLeave">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="&#xEB9F;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="#007AFF"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Search_DragDropText}"
                                   FontSize="13"
                                   Foreground="#8E8E93"
                                   FontFamily="{StaticResource MacFont}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Suggestion List Container with Rounded Corners -->
                <Border Grid.Row="1"
                        Margin="16,0,16,16"
                        CornerRadius="12"
                        Background="White"
                        BorderThickness="1"
                        BorderBrush="#E8E8E8">
                    <ListBox Name="SuggestionList"
                             Background="Transparent"
                             BorderThickness="0"
                             Visibility="Collapsed"
                             SelectionChanged="SuggestionList_SelectionChanged"
                             MouseDoubleClick="SuggestionList_MouseDoubleClick"
                             KeyDown="SuggestionList_KeyDown"
                             ItemContainerStyle="{StaticResource SuggestionItemStyle}"
                             FontFamily="{StaticResource MacFont}"
                             ItemTemplate="{StaticResource SuggestionItemTemplate}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MaxHeight="400"/>
                </Border>

                <TextBlock Name="NotificationText"
                           Grid.Row="2"
                           Margin="16,12,16,12"
                           TextAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#007AFF"
                           FontFamily="{StaticResource MacFont}"
                           FontSize="12"
                           Visibility="Collapsed"/>

                <!-- Settings Button -->
                <Button Name="CustomShortcutButton"
                        Grid.Row="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,15,0"
                        Content="&#xE713;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="16"
                        Width="32"
                        Height="32"
                        Background="Transparent"
                        Foreground="#555"
                        BorderThickness="0"
                        Click="CustomShortcutButton_Click"
                        ToolTip="{DynamicResource Search_Settings}"/>

                <!-- PREVIEW PANEL - Modal Overlay -->
                <Border x:Name="PreviewPanel"
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Background="#E6E6E6"
                        Opacity="0.95"
                        Visibility="Collapsed"
                        MouseLeftButtonDown="PreviewPanel_MouseDown">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Close Header -->
                        <Border Grid.Row="0"
                                Background="White"
                                Padding="16,12">
                            <Grid>
                                <TextBlock x:Name="PreviewTitle"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#1A1A1A"
                                           VerticalAlignment="Center"/>
                                <Button HorizontalAlignment="Right"
                                        Content="{DynamicResource Search_Close}"
                                        FontSize="16"
                                        Padding="8"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="BackFromPreviewButton_Click"
                                        Foreground="#666"/>
                            </Grid>
                        </Border>

                        <!-- Content Area with Scroll -->
                        <ScrollViewer Grid.Row="1"
                                      Background="White"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                <!-- Image Preview -->
                                <Border x:Name="ImagePreviewContainer"
                                        CornerRadius="8"
                                        Background="#F5F5F5"
                                        Visibility="Collapsed"
                                        Margin="0,0,0,16">
                                    <Image x:Name="ImagePreview"
                                           Stretch="UniformToFill"
                                           MaxHeight="400"
                                           MaxWidth="300"/>
                                </Border>

                                <!-- Video Preview -->
                                <Border x:Name="VideoPreviewContainer"
                                        CornerRadius="8"
                                        Background="#000000"
                                        Visibility="Collapsed"
                                        Margin="0,0,0,16">
                                    <MediaElement x:Name="VideoPreview"
                                                  LoadedBehavior="Manual"
                                                  MaxHeight="400"
                                                  MaxWidth="300"/>
                                </Border>

                                <!-- File Preview -->
                                <StackPanel x:Name="FilePreviewContainer"
                                            Visibility="Collapsed"
                                            HorizontalAlignment="Center">
                                    <Image x:Name="FileIconPreview"
                                           Width="80"
                                           Height="80"
                                           Margin="0,0,0,12"/>
                                    <TextBlock x:Name="FileNamePreview"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#1A1A1A"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,8"/>
                                    <TextBlock x:Name="FileSizePreview"
                                               FontSize="12"
                                               Foreground="#8E8E93"
                                               TextAlignment="Center"/>
                                </StackPanel>

                                <!-- Folder Preview -->
                                <ListBox x:Name="FolderContentsList"
                                         Visibility="Collapsed"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemTemplate="{StaticResource SuggestionItemTemplate}"
                                         ItemContainerStyle="{StaticResource SuggestionItemStyle}"
                                         MaxHeight="400"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         FontFamily="{StaticResource MacFont}"
                                         AllowDrop="True"
                                         MouseDoubleClick="FolderContentsList_DoubleClick"
                                         PreviewMouseLeftButtonDown="FolderContentsList_PreviewMouseDown"
                                         MouseMove="FolderContentsList_MouseMove"
                                         MouseLeftButtonUp="FolderContentsList_MouseUp"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Video Controls -->
                        <StackPanel x:Name="VideoControlsPanel"
                                    Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Visibility="Collapsed"
                                    Background="White"
                                    Margin="16">
                            <Button Name="PlayButton"
                                    Content="{DynamicResource Search_Play}"
                                    Padding="12,8"
                                    Margin="0,0,8,0"
                                    Click="PlayButton_Click"
                                    Background="#007AFF"
                                    Foreground="White"
                                    BorderThickness="0"/>
                            <Button Name="PauseButton"
                                    Content="{DynamicResource Search_Pause}"
                                    Padding="12,8"
                                    Background="#007AFF"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="PauseButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>