<Window x:Class="ZeroMix.SearchOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZeroMix"
        Title="ZeroMix"
        Width="700"
        SizeToContent="Height"
        MaxHeight="600"
        Topmost="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Opacity="0"
        Icon="zeromix.ico"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0"
                             To="1"
                             Duration="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.95"
                             To="1"
                             Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase Exponent="4"
                                     EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.95"
                             To="1"
                             Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase Exponent="4"
                                     EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            
            <!-- Animasi untuk menggambar logo Z -->
            <DoubleAnimation Storyboard.TargetName="ZLogoPath"
                             Storyboard.TargetProperty="StrokeDashOffset"
                             From="80" 
                             To="0"
                             BeginTime="0:0:0.1"
                             Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1"
                             To="0"
                             Duration="0:0:0.15"/>
        </Storyboard>

        <local:SuggestionTypeToStringConverter x:Key="SuggestionTypeConverter"/>

        <DropShadowEffect x:Key="MacShadow"
                          BlurRadius="30"
                          ShadowDepth="0"
                          Color="#000000"
                          Opacity="0.2"/>

        <LinearGradientBrush x:Key="ZGradient"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#4285F4"
                          Offset="0.0"/>
            <GradientStop Color="#34A853"
                          Offset="0.33"/>
            <GradientStop Color="#FBBC05"
                          Offset="0.66"/>
            <GradientStop Color="#EA4335"
                          Offset="1.0"/>
        </LinearGradientBrush>

        <FontFamily x:Key="MacFont">Segoe UI, -apple-system, BlinkMacSystemFont, 'San Francisco', 'Helvetica Neue', sans-serif</FontFamily>

        <Style x:Key="SearchBoxStyle"
               TargetType="TextBox">
            <Setter Property="FontSize"
                    Value="20"/>
            <Setter Property="Height"
                    Value="48"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="16,0,8,0"/>
            <Setter Property="Foreground"
                    Value="#1A1A1A"/>
            <Setter Property="FontWeight"
                    Value="Normal"/>
            <Setter Property="FontFamily"
                    Value="{StaticResource MacFont}"/>
            <Setter Property="CaretBrush"
                    Value="#007AFF"/>
        </Style>

        <ControlTemplate x:Key="SearchBoxPlaceholderTemplate"
                         TargetType="{x:Type TextBox}">
            <Grid>
                <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True"/>
                <ScrollViewer x:Name="PART_ContentHost"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                <TextBlock x:Name="Placeholder"
                           Margin="{TemplateBinding Padding}"
                           Text="Type here to search..."
                           Foreground="#8E8E93"
                           FontStyle="Normal"
                           FontSize="20"
                           FontFamily="{StaticResource MacFont}"
                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility"
                                    Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static local:StringToVisibilityConverter.Instance}}"
                                             Value="Collapsed">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </ControlTemplate>


        <Style x:Key="SuggestionItemStyle"
               TargetType="ListBoxItem">
            <Setter Property="Padding"
                    Value="16,12"/>
            <Setter Property="Margin"
                    Value="0,1"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="#1A1A1A"/>
            <Setter Property="FontWeight"
                    Value="Normal"/>
            <Setter Property="FontFamily"
                    Value="{StaticResource MacFont}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#F2F2F7"/>
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="#007AFF"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                            </Trigger>
                            
                            <!-- Pink Style for Terminal Commands -->
                            <DataTrigger Binding="{Binding IsTerminal}" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF007F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                            
                            <!-- Ensure Pink overrides Blue if both Selected and Terminal -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsTerminal}" Value="True"/>
                                    <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#FF007F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SuggestionItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Container: Prioritas Image (colorful) > TextBlock (MDL2) -->
                <Grid Grid.Column="0" 
                      Width="32" 
                      Height="32"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center">
                    
                    <!-- Colorful Icon dari .exe file -->
                    <Image Source="{Binding IconSource}"
                           Width="24"
                           Height="24"
                           Visibility="{Binding IconSource, Converter={x:Static local:NullToVisibilityConverter.Instance}}"/>
                    
                    <!-- Fallback: Segoe MDL2 Icon -->
                    <TextBlock Text="{Binding Icon}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Visibility="{Binding IconSource, Converter={x:Static local:NullToVisibilityConverter.InstanceInverse}}"/>
                </Grid>

                <!-- Text Container (Title + Subtitle) -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0">
                    <TextBlock Text="{Binding DisplayText}"
                               TextTrimming="CharacterEllipsis"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    
                    <TextBlock Text="{Binding Subtitle}"
                               TextTrimming="CharacterEllipsis"
                               FontSize="11"
                               Opacity="0.7"
                               Visibility="{Binding Subtitle, Converter={x:Static local:StringToVisibilityConverter.Instance}}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Window.RenderTransform>
        <ScaleTransform ScaleX="1"
                        ScaleY="1"
                        CenterX="340"
                        CenterY="45"/>
    </Window.RenderTransform>

    <Grid>
        <Border x:Name="MainBorder"
                CornerRadius="18"
                Background="#CCF2F2F7"
                BorderBrush="#20000000"
                BorderThickness="1"
                Effect="{StaticResource MacShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Grid.Column="0"
                             Margin="12,0,0,0"
                             VerticalAlignment="Center"
                             Height="40"
                             Width="40">
                        <Canvas Width="32"
                                Height="32">
                            <Path x:Name="ZLogoPath"
                                  Data="M 4,6 L 28,6 L 4,26 L 28,26"
                                  StrokeThickness="5"
                                  Stroke="{StaticResource ZGradient}"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeDashArray="80"
                                  StrokeDashOffset="80"
                                  />
                        </Canvas>
                    </Viewbox>

                    <TextBox Name="SearchBox"
                             Grid.Column="1"
                             Padding="8,0,16,0"
                             Margin="0,12,16,12"
                             KeyDown="SearchBox_KeyDown"
                             TextChanged="SearchBox_TextChanged"
                             Style="{StaticResource SearchBoxStyle}"
                             Template="{StaticResource SearchBoxPlaceholderTemplate}"
                             AllowDrop="True"
                             Drop="SearchBox_Drop"
                             DragEnter="SearchBox_DragEnter"
                             DragLeave="SearchBox_DragLeave"/>

                    <!-- Clock Display -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                Margin="0,0,50,0">
                        <TextBlock Name="ClockText"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#1A1A1A"
                                   FontFamily="{StaticResource MacFont}"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Name="DateText"
                                   FontSize="11"
                                   Foreground="#8E8E93"
                                   FontFamily="{StaticResource MacFont}"
                                   HorizontalAlignment="Right"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Drag & Drop Area -->
                <Border Name="DragDropArea"
                        Grid.Row="1"
                        Margin="16,0,16,8"
                        Height="80"
                        CornerRadius="12"
                        Background="#10007AFF"
                        BorderBrush="#30007AFF"
                        BorderThickness="2"
                        Visibility="Collapsed"
                        AllowDrop="True"
                        Drop="DragDropArea_Drop"
                        DragEnter="DragDropArea_DragEnter"
                        DragLeave="DragDropArea_DragLeave">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="&#xEB9F;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="#007AFF"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Drop image here to search"
                                   FontSize="13"
                                   Foreground="#8E8E93"
                                   FontFamily="{StaticResource MacFont}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <ListBox Name="SuggestionList"
                         Grid.Row="1"
                         Margin="16,0,16,16"
                         MaxHeight="400"
                         Background="Transparent"
                         BorderThickness="0"
                         Visibility="Collapsed"
                         SelectionChanged="SuggestionList_SelectionChanged"
                         MouseDoubleClick="SuggestionList_MouseDoubleClick"
                         KeyDown="SuggestionList_KeyDown"
                         ItemContainerStyle="{StaticResource SuggestionItemStyle}"
                         FontFamily="{StaticResource MacFont}"
                         ItemTemplate="{StaticResource SuggestionItemTemplate}"/>

                <TextBlock Name="NotificationText"
                           Grid.Row="2"
                           Margin="16,0,16,16"
                           TextAlignment="Center"
                           FontWeight="Medium"
                           Foreground="#007AFF"
                           FontFamily="{StaticResource MacFont}"
                           Visibility="Collapsed"/>

                <!-- Settings Button -->
                <Button Name="CustomShortcutButton"
                        Grid.Row="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,15,0"
                        Content="&#xE713;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="16"
                        Width="32"
                        Height="32"
                        Background="Transparent"
                        Foreground="#555"
                        BorderThickness="0"
                        Click="CustomShortcutButton_Click"
                        ToolTip="Settings"/>
            </Grid>
        </Border>
    </Grid>
</Window>