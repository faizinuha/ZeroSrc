<Window x:Class="ZeroMix.SleepMode.SleepSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sleep Mode Settings" Height="650" Width="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="CardHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource GlassBrush}" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="20">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Sleep Mode Settings" 
                           FontSize="20" FontWeight="Bold" 
                           Foreground="{StaticResource NeonBlueBrush}"/>
                <TextBlock Text="Configure how fake sleep behaves" 
                           FontSize="12" Foreground="{StaticResource SubTextBrush}"/>
            </StackPanel>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Trigger Mode (bisa pilih lebih dari satu) -->
                    <TextBlock Text="Behavior Mode (bisa pilih lebih dari 1)" Style="{StaticResource CardHeaderStyle}" Margin="0,10,0,5"/>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <CheckBox x:Name="ManualModeChk" Content="Direct Activation (Manual)" IsChecked="True" Style="{StaticResource ModernCheckBox}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox x:Name="IdleModeChk" Content="Active when Idle" Style="{StaticResource ModernCheckBox}" VerticalAlignment="Center" Margin="0"/>
                                <TextBox x:Name="IdleSecondsTxt" Text="60" Width="40" Margin="10,0,5,0" HorizontalContentAlignment="Center"/>
                                <TextBlock Text="sec" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ShortcutModeChk" Content="Shortcut Activation" Style="{StaticResource ModernCheckBox}" VerticalAlignment="Center" Margin="0"/>
                                <TextBox x:Name="ShortcutTxt" Text="Alt + S" IsReadOnly="True" Width="80" Margin="10,0,0,0" HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Exit Behavior -->
                    <TextBlock Text="Exit Behavior" Style="{StaticResource CardHeaderStyle}" Margin="0,15,0,5"/>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <CheckBox x:Name="ExitMouseMoveChk" Content="Exit on Mouse Move" IsChecked="True" Style="{StaticResource ModernCheckBox}"/>
                            <CheckBox x:Name="ExitMouseDownChk" Content="Exit on Mouse Click" IsChecked="True" Style="{StaticResource ModernCheckBox}"/>
                            <CheckBox x:Name="ExitKeyDownChk" Content="Exit on Key Press" IsChecked="True" Style="{StaticResource ModernCheckBox}"/>
                        </StackPanel>
                    </Border>

                    <!-- AOD Style -->
                    <TextBlock Text="Always-On Display Style" Style="{StaticResource CardHeaderStyle}" Margin="0,15,0,8"/>
                    
                    <!-- Style Cards -->
                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <!-- Minimal Clock -->
                        <Border x:Name="StyleCardMinimal" CornerRadius="10" Margin="0,0,6,6" Padding="10" Cursor="Hand"
                                Background="#141922" BorderThickness="2" BorderBrush="{StaticResource NeonBlueBrush}"
                                MouseLeftButtonDown="StyleCard_Click" Tag="MinimalClock">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="00:00" FontSize="18" FontWeight="Bold" Foreground="#44FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Minimal" FontSize="10" Foreground="{StaticResource NeonBlueBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Digital Glow -->
                        <Border x:Name="StyleCardGlow" CornerRadius="10" Margin="3,0,3,6" Padding="10" Cursor="Hand"
                                Background="#141922" BorderThickness="1" BorderBrush="#1A2030"
                                MouseLeftButtonDown="StyleCard_Click" Tag="DigitalGlow">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="00:00" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center">
                                    <TextBlock.Foreground>
                                        <SolidColorBrush Color="#00D9FF"/>
                                    </TextBlock.Foreground>
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="#00D9FF" BlurRadius="8" ShadowDepth="0"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <TextBlock Text="Neon Glow" FontSize="10" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Analog -->
                        <Border x:Name="StyleCardAnalog" CornerRadius="10" Margin="6,0,0,6" Padding="10" Cursor="Hand"
                                Background="#141922" BorderThickness="1" BorderBrush="#1A2030"
                                MouseLeftButtonDown="StyleCard_Click" Tag="Analog">
                            <StackPanel HorizontalAlignment="Center">
                                <Ellipse Width="30" Height="30" Stroke="#44FFFFFF" StrokeThickness="1.5" HorizontalAlignment="Center"/>
                                <TextBlock Text="Analog" FontSize="10" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Date Focus -->
                        <Border x:Name="StyleCardDate" CornerRadius="10" Margin="0,0,6,0" Padding="10" Cursor="Hand"
                                Background="#141922" BorderThickness="1" BorderBrush="#1A2030"
                                MouseLeftButtonDown="StyleCard_Click" Tag="DateFocus">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="APR 5" FontSize="14" FontWeight="Bold" Foreground="#44FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="00:00" FontSize="10" Foreground="#22FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Date Focus" FontSize="10" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Blank -->
                        <Border x:Name="StyleCardBlank" CornerRadius="10" Margin="3,0,3,0" Padding="10" Cursor="Hand"
                                Background="#0A0A0A" BorderThickness="1" BorderBrush="#1A2030"
                                MouseLeftButtonDown="StyleCard_Click" Tag="Blank">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="■" FontSize="18" Foreground="#11FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Blank" FontSize="10" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Brightness -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Brightness" Foreground="{StaticResource SubTextBrush}" FontSize="11"/>
                                <TextBlock x:Name="BrightnessLabel" Text=" — 100%" Foreground="{StaticResource NeonBlueBrush}" FontSize="11"/>
                            </StackPanel>
                            <Slider x:Name="BrightnessSld" Minimum="0.2" Maximum="1.0" Value="1.0"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    ValueChanged="BrightnessSld_ValueChanged"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" Click="CancelBtn_Click" Style="{StaticResource CasualBtn}" Width="100" Margin="0,0,10,0"/>
                <Button Content="Start Sleep Mode" Click="StartBtn_Click" Style="{StaticResource PrimaryBtn}" Width="150"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
