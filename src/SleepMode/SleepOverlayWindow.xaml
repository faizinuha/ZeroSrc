<Window x:Class="ZeroMix.SleepMode.SleepOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SleepOverlay" Height="450" Width="800"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Black" 
        Topmost="True" 
        WindowState="Maximized"
        Cursor="None"
        ShowInTaskbar="False"
        Focusable="True">
    

    <Grid x:Name="MainGrid" Opacity="1">
        <!-- Background Image (3.jpg) - Sangat tipis (hampir tidak kelihatan tapi ada) -->
        <Image x:Name="DefaultBgImage"
               Source="IMG/3.jpg" 
               Stretch="UniformToFill" 
               Opacity="0.10"
               IsHitTestVisible="False"/>

        <!-- Custom Background (gambar/video pilihan user) -->
        <Image x:Name="CustomBgImage"
               Stretch="UniformToFill"
               Opacity="0.3"
               IsHitTestVisible="False"
               Visibility="Collapsed"/>
        <MediaElement x:Name="CustomBgVideo"
                      Stretch="UniformToFill"
                      LoadedBehavior="Play"
                      IsMuted="True"
                      Opacity="0.3"
                      IsHitTestVisible="False"
                      Visibility="Collapsed"
                      MediaEnded="CustomBgVideo_MediaEnded"/>

        <!-- Konten animasi ringan (Jam digital) -->
        <StackPanel x:Name="AnimContainer" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">

            <!-- Date Focus style -->
            <TextBlock x:Name="DateText"
                       Text="APR 5"
                       FontSize="52" FontWeight="Light"
                       Foreground="#55FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"
                       Visibility="Collapsed"/>
            
            <TextBlock x:Name="TimeText" 
                       Text="00:00" 
                       FontSize="72" 
                       FontWeight="Bold" 
                       Foreground="#33FFFFFF" 
                       HorizontalAlignment="Center"
                       Visibility="Visible"/>
            
            <TextBlock x:Name="StatusText" 
                       Text="Sleep Mode Active" 
                       FontSize="16" 
                       Foreground="#11FFFFFF" 
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>

            <!-- Analog Clock -->
            <Grid x:Name="AnalogClockContainer" Width="160" Height="160"
                  Margin="0,10,0,0" Visibility="Collapsed">
                <!-- Face -->
                <Ellipse Stroke="#33FFFFFF" StrokeThickness="1.5"/>
                <!-- Hour markers -->
                <Ellipse Width="4" Height="4" Fill="#44FFFFFF" VerticalAlignment="Top" Margin="0,8,0,0"/>
                <Ellipse Width="4" Height="4" Fill="#44FFFFFF" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                <Ellipse Width="4" Height="4" Fill="#44FFFFFF" HorizontalAlignment="Left" Margin="8,0,0,0"/>
                <Ellipse Width="4" Height="4" Fill="#44FFFFFF" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                <!-- Hour hand -->
                <Line x:Name="HourHand" X1="80" Y1="80" X2="80" Y2="45"
                      Stroke="#AAFFFFFF" StrokeThickness="3"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <!-- Minute hand -->
                <Line x:Name="MinuteHand" X1="80" Y1="80" X2="80" Y2="30"
                      Stroke="#CCFFFFFF" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <!-- Second hand -->
                <Line x:Name="SecondHand" X1="80" Y1="80" X2="80" Y2="22"
                      Stroke="#00D9FF" StrokeThickness="1"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <!-- Center dot -->
                <Ellipse Width="8" Height="8" Fill="#00D9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Pixel Character Placeholder -->
            <Grid x:Name="PixelCharContainer" 
                  Width="64" Height="64" 
                  Margin="0,30,0,0" 
                  Visibility="Collapsed">
                <Rectangle Fill="{StaticResource NeonBlueBrush}" 
                           Width="32" Height="32" 
                           VerticalAlignment="Bottom">
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="PixelCharMove"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Grid>
        </StackPanel>

        <!-- Dekorasi Gambar (1 & 2) di Pojok Bawah -->
        <Grid VerticalAlignment="Bottom" Margin="40">
            <!-- Gambar 1 di Kiri Bawah -->
            <Border HorizontalAlignment="Left" 
                    Width="120" Height="120" 
                    CornerRadius="15" 
                    BorderThickness="1" 
                    BorderBrush="#11FFFFFF" 
                    ClipToBounds="True">
                <Image Source="IMG/1.jfif" 
                       Stretch="UniformToFill" 
                       Opacity="0.4"/>
            </Border>

            <!-- Gambar 2 di Kanan Bawah -->
            <Border HorizontalAlignment="Right" 
                    Width="120" Height="120" 
                    CornerRadius="15" 
                    BorderThickness="1" 
                    BorderBrush="#11FFFFFF" 
                    ClipToBounds="True">
                <Image Source="IMG/2.jfif" 
                       Stretch="UniformToFill" 
                       Opacity="0.4"/>
            </Border>
        </Grid>
    </Grid>
</Window>
