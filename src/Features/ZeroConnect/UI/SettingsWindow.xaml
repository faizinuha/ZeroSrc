<Window x:Class="ZeroMix.Features.ZeroConnect.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="360" Width="320" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <StackPanel>
            <TextBlock Text="Welcome Area: Show/Hide features" FontWeight="Bold" Margin="0,0,0,12"/>

            <CheckBox x:Name="Cb1" Content="Feature 1" Margin="0,4"/>
            <CheckBox x:Name="Cb2" Content="Feature 2" Margin="0,4"/>
            <CheckBox x:Name="Cb3" Content="Feature 3" Margin="0,4"/>
            <CheckBox x:Name="Cb4" Content="Feature 4" Margin="0,4"/>
            <CheckBox x:Name="Cb5" Content="Feature 5" Margin="0,4"/>
            <CheckBox x:Name="Cb6" Content="Feature 6" Margin="0,4"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Width="80" Margin="0,0,8,0" Click="BtnCancel_Click">Cancel</Button>
                <Button Width="80" Click="BtnSave_Click">Save</Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>