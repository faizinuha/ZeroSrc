<ui:FluentWindow
    x:Class="ZeroMix.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:battery="clr-namespace:ZeroMix.Plugins.Battery"
    xmlns:chargernotif="clr-namespace:ZeroMix.Plugins.ChargerNotif"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ZeroMix"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:translate="clr-namespace:ZeroMix.Plugins.Translate"
    xmlns:tray="clr-namespace:Wpf.Ui.Tray.Controls;assembly=Wpf.Ui.Tray"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:snaplayout="clr-namespace:zeromix.SnapLayout"
    xmlns:wallpapers="clr-namespace:ZeroMix.Wallpapers"
    xmlns:weather="clr-namespace:ZeroMix.Plugins.Weather"
    xmlns:welcome="clr-namespace:ZeroMix.Plugins.Welcome"
    xmlns:zc="clr-namespace:ZeroMix.Features.ZeroConnect.UI"
    Title="ZeroMix"
    Width="1000"
    Height="650"
    MinWidth="1000"
    MinHeight="650"
    Background="#FF141922"
    Closing="Window_Closing"
    ExtendsContentIntoTitleBar="True"
    Icon="../Assets/Icons/zeromix.ico"
    KeyDown="Window_KeyDown"
    Loaded="Window_Loaded"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="True"
    StateChanged="Window_StateChanged"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <!-- Fix C (Bagian 7): fallback gelap (#141922) bukan putih/transparan supaya frame
         sebelum Mica ter-attach tidak menyilaukan. Mica menutup brush ini begitu aktif. -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Tools/Plugins/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Global ComboBox  -->
            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="#141922" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="FontSize" Value="12" />
                <Style.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#141922" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F0F2F5" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource NeonBlueColor}" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black" />
                </Style.Resources>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Background" Value="#141922" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="BorderThickness" Value="0" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource NeonBlueBrush}" />
                        <Setter Property="Foreground" Value="Black" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource NeonBlueBrush}" />
                        <Setter Property="Foreground" Value="Black" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--  Premium Navigation Button Style  -->
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#B0B0B0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Height" Value="45" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Border
                                    x:Name="border"
                                    Margin="10,2,10,2"
                                    Background="Transparent"
                                    CornerRadius="8">
                                    <ContentPresenter Margin="15,0,0,0" VerticalAlignment="Center" />
                                </Border>
                                <!--  Precise Left Indicator  -->
                                <Border
                                    x:Name="indicator"
                                    Width="4"
                                    Height="20"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource NeonBlueBrush}"
                                    CornerRadius="0,2,2,0"
                                    Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#1AFFFFFF" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True">
                                    <Setter TargetName="indicator" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="border" Property="Background" Value="#12FFFFFF" />
                                    <Setter Property="Foreground" Value="{StaticResource NeonBlueBrush}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  Recorder Mode Card Style (hover works via animation because selected colors are set in code)  -->
            <Style x:Key="RecModeCard" TargetType="Border">
                <Setter Property="Padding" Value="16" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="#111620" />
                <Setter Property="BorderBrush" Value="#1A2030" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard x:Name="ModeHoverIn">
                            <Storyboard>
                                <ColorAnimation
                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                    To="#1C2636"
                                    Duration="0:0:0.12" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <RemoveStoryboard BeginStoryboardName="ModeHoverIn" />
                    </EventTrigger>
                </Style.Triggers>
            </Style>

            <!--  Hover Card Style (Recorder history items)  -->
            <Style x:Key="HoverCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Background" Value="#141922" />
                <Setter Property="BorderBrush" Value="#1A2030" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1A2333" />
                        <Setter Property="BorderBrush" Value="#2A3A52" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--  Quick Action Card Style  -->
            <Style x:Key="QuickActionButton" TargetType="Button">
                <Setter Property="Background" Value="#0D1117" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#1E2A3A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="16" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Height" Value="120" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="border"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#00BFA5" />
                                    <Setter TargetName="border" Property="Background" Value="#111820" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#0A0E1A" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  Primary Button  -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource NeonBlueBrush}" />
                <Setter Property="Foreground" Value="#0A0D13" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Padding" Value="28,12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="border"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MainBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Margin" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--  Hide ScrollBars Global  -->
            <Style TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <ScrollContentPresenter
                                x:Name="PART_ScrollContentPresenter"
                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <tray:NotifyIcon
                x:Key="AppTrayResource"
                ToolTip="ZeroMix"
                Visibility="Collapsed" />
        </ResourceDictionary>
    </Window.Resources>


    <!--  Main Container with rounded corners  -->
    <Border
        x:Name="RootBorder"
        Background="#0A0E1A"
        BorderThickness="0"
        ClipToBounds="True"
        Style="{StaticResource MainBorderStyle}">
        <Grid x:Name="MainLayoutGrid">

            <Grid>
                <Grid.RowDefinitions>
                    <!--  Modern Title Bar  -->
                    <RowDefinition Height="38" />
                    <!--  Content Body  -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  â•â•â•â•â•â•â•â• TITLE BAR (WPF-UI) â•â•â•â•â•â•â•â•  -->
                <ui:TitleBar
                    Title="ZeroMix Hub"
                    Grid.Row="0"
                    Icon="../Assets/Icons/zeromix.ico">
                    <ui:TitleBar.Header>
                        <Button
                            x:Name="HamburgerBtn"
                            Width="34"
                            Height="34"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="HamburgerBtn_Click"
                            Content="&#xE700;"
                            Cursor="Hand"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Foreground="White"
                            ToolTip="Toggle Sidebar" />
                    </ui:TitleBar.Header>
                    <ui:TitleBar.TrailingContent>
                        <ComboBox
                            x:Name="LanguageComboBox"
                            Width="110"
                            Height="26"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            SelectionChanged="LanguageComboBox_SelectionChanged"
                            Style="{StaticResource ModernComboBox}">
                            <ComboBoxItem Content="English" Tag="en-US" />
                            <ComboBoxItem Content="Indonesia" Tag="id-ID" />
                            <ComboBoxItem Content="日本語" Tag="ja-JP" />
                            <ComboBoxItem Content="中文" Tag="zh-CN" />
                            <ComboBoxItem Content="한국어" Tag="ko-KR" />
                        </ComboBox>
                    </ui:TitleBar.TrailingContent>
                </ui:TitleBar>
                <!--  compat elements for code-behind  -->
                <Border
                    x:Name="TitleDragArea"
                    Grid.Row="0"
                    Visibility="Collapsed" />
                <Button
                    x:Name="MaximizeButton"
                    Grid.Row="0"
                    Click="MaximizeRestore_Click"
                    Visibility="Collapsed" />

                <!--  â•â•â•â•â•â•â•â• BODY â•â•â•â•â•â•â•â•  -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!--  Sidebar column set to Auto so it follows the Border's width  -->
                        <ColumnDefinition x:Name="SidebarColumn" Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ SIDEBAR â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€  -->
                    <Border
                        x:Name="SidebarPane"
                        Grid.Column="0"
                        Width="220"
                        Background="#080C16"
                        BorderBrush="#1E2A3A"
                        BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Navigation Items  -->
                            <StackPanel Grid.Row="0" Margin="0,15,0,0">
                                <Button
                                    x:Name="HomeButton"
                                    Click="HomeButton_Click"
                                    Style="{StaticResource NavButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            x:Name="IconHome"
                                            Width="30"
                                            Margin="0,0,15,0"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="20"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            Text="&#xE80F;" />
                                        <TextBlock
                                            x:Name="NavTextHome"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="Dashboard" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    x:Name="WallpaperButton"
                                    Click="NavWallpapers_Click"
                                    Style="{StaticResource NavButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            x:Name="IconWall"
                                            Width="30"
                                            Margin="0,0,15,0"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="20"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            Text="&#xEB9F;" />
                                        <TextBlock
                                            x:Name="NavTextWall"
                                            VerticalAlignment="Center"
                                            Text="Wallpapers" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    x:Name="PluginsButton"
                                    Click="PluginsButton_Click"
                                    Style="{StaticResource NavButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            x:Name="IconPlugins"
                                            Width="30"
                                            Margin="0,0,15,0"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="20"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            Text="&#xEA86;" />
                                        <TextBlock
                                            x:Name="NavTextPlugins"
                                            VerticalAlignment="Center"
                                            Text="Plugins" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    x:Name="RecorderButton"
                                    Click="RecorderButton_Click"
                                    Style="{StaticResource NavButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            x:Name="IconRec"
                                            Width="30"
                                            Margin="0,0,15,0"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="20"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            Text="&#xE714;" />
                                        <TextBlock
                                            x:Name="NavTextRec"
                                            VerticalAlignment="Center"
                                            Text="Capture" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    x:Name="AssistantButton"
                                    Click="AssistantButton_Click"
                                    Style="{StaticResource NavButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            x:Name="IconAsst"
                                            Width="30"
                                            Margin="0,0,15,0"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="20"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            Text="&#xE77B;" />
                                        <TextBlock
                                            x:Name="NavTextAsst"
                                            VerticalAlignment="Center"
                                            Text="AI Companions" />
                                    </StackPanel>
                                </Button>
                                
                                <Button
                                    x:Name="ZeroConnectButton"
                                    Visibility="Collapsed"
                                    Click="ZeroConnectButton_Click"
                                    Style="{StaticResource NavButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            x:Name="IconZeroConnect"
                                            Margin="0,0,15,0"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            Text="&#xE77B;" />
                                        <TextBlock
                                            x:Name="NavTextZeroConnect"
                                            VerticalAlignment="Center"
                                            Text="ZeroConnect" />
                                    </StackPanel>
                                </Button>
                            

                                <Border
                                    Height="1"
                                    Margin="20,15"
                                    Background="#11FFFFFF" />

                                <Button
                                    x:Name="AboutButton"
                                    Click="AboutButton_Click"
                                    Style="{StaticResource NavButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <!--  Icon + Update Badge  -->
                                        <Grid
                                            Width="30"
                                            Margin="0,0,15,0"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                x:Name="IconAbout"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="20"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                Text="&#xE946;" />
                                            <!--  Update dot badge  -->
                                            <Ellipse
                                                x:Name="SidebarUpdateDot"
                                                Width="8"
                                                Height="8"
                                                Margin="0,0,-2,-2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Fill="#FF4D4D"
                                                Visibility="Collapsed">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <Trigger Property="Visibility" Value="Visible">
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                                            <DoubleAnimation
                                                                                Storyboard.TargetProperty="Opacity"
                                                                                From="1"
                                                                                To="0.3"
                                                                                Duration="0:0:1" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                x:Name="NavTextAbout"
                                                VerticalAlignment="Center"
                                                Text="System Info" />
                                            <!--  Update text badge (visible saat sidebar expanded)  -->
                                            <Border
                                                x:Name="SidebarUpdateBadge"
                                                Margin="8,0,0,0"
                                                Padding="5,1"
                                                VerticalAlignment="Center"
                                                Background="#FF4D4D"
                                                CornerRadius="4"
                                                Visibility="Collapsed">
                                                <TextBlock
                                                    FontSize="8"
                                                    FontWeight="Bold"
                                                    Foreground="White"
                                                    Text="UPDATE" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!--  Sidebar Footer  -->
                            <StackPanel Grid.Row="1" Margin="15,0,15,15">
                                <TextBlock
                                    x:Name="StatusLabel"
                                    Margin="5,0,0,10"
                                    FontSize="9"
                                    Foreground="#66FFFFFF"
                                    Text="All Systems Normal"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="SettingsSidebarButton"
                                    Click="SettingsSidebarButton_Click"
                                    Style="{StaticResource NavButtonStyle}"
                                    Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            x:Name="IconSettings"
                                            Width="30"
                                            Margin="0,0,15,0"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="20"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            Text="&#xE713;" />
                                        <TextBlock VerticalAlignment="Center" Text="Settings" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ CONTENT AREA (Glass Card Styles) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€  -->
                    <Grid Grid.Column="1" Margin="25">

                        <!--  â•â•â• HOME VIEW â•â•â•  -->
                        <ScrollViewer
                            x:Name="HomeContent"
                            BorderThickness="0"
                            VerticalScrollBarVisibility="Hidden">
                            <StackPanel>
                                <!--  Welcome Header  -->
                                <StackPanel Margin="0,0,0,32">
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        FontSize="30"
                                        FontWeight="ExtraBold"
                                        Foreground="{StaticResource TextBrush}"
                                        Text="Welcome back" />
                                    <TextBlock
                                        FontSize="14"
                                        Foreground="{StaticResource SubTextBrush}"
                                        Text="Ready to optimize your experience today?" />
                                </StackPanel>

                                <!--  Quick Actions  -->
                                <TextBlock
                                    Margin="0,0,0,14"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="#8892A4"
                                    Text="QUICK OPERATIONS" />

                                <Grid Margin="0,0,0,32">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button
                                        x:Name="EnableMonitoringBtn"
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Margin="0,0,8,8"
                                        Click="EnableMonitoringBtn_Click"
                                        Style="{StaticResource QuickActionButton}">
                                        <StackPanel>
                                            <ui:SymbolIcon
                                                Margin="0,0,0,10"
                                                HorizontalAlignment="Center"
                                                FontSize="28"
                                                Foreground="#00BFA5"
                                                Symbol="HeartPulse24" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="#FFFFFF"
                                                Text="System Health" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="OpenClockBtn"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Margin="4,0,4,8"
                                        Click="OpenClockBtn_Click"
                                        Style="{StaticResource QuickActionButton}">
                                        <StackPanel>
                                            <ui:SymbolIcon
                                                Margin="0,0,0,10"
                                                HorizontalAlignment="Center"
                                                FontSize="28"
                                                Foreground="#00BFA5"
                                                Symbol="Clock32" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="#FFFFFF"
                                                Text="Neural Clock" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="TaskbarToggleBtn"
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        Margin="8,0,0,8"
                                        Click="TaskbarToggleBtn_Click"
                                        Style="{StaticResource QuickActionButton}">
                                        <StackPanel>
                                            <ui:SymbolIcon
                                                Margin="0,0,0,10"
                                                HorizontalAlignment="Center"
                                                FontSize="28"
                                                Foreground="#00BFA5"
                                                Symbol="AppsListDetail20" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="#FFFFFF"
                                                Text="Ghost Taskbar" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        x:Name="HomeRecordBtn"
                                        Grid.Row="1"
                                        Grid.Column="0"
