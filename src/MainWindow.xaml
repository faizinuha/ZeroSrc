                        <!-- ═══ RECORDER VIEW ═══ -->
                        <ScrollViewer x:Name="RecorderContent"
                                       Visibility="Collapsed"
                                       VerticalScrollBarVisibility="Auto"
                                       HorizontalScrollBarVisibility="Disabled"
                                       BorderThickness="0">
                            <StackPanel Margin="0,0,0,30">
                                <!-- Header Section -->
                                <Grid Margin="0,0,0,24">
                                    <StackPanel>
                                        <TextBlock Text="ZeroRecord"
                                                   FontSize="32"
                                                   FontWeight="Black"
                                                   Foreground="{StaticResource NeonBlueBrush}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="Cinematic, Smooth, GPU-Powered Capture."
                                                   FontSize="14"
                                                   Foreground="{StaticResource SubTextBrush}"
                                                   Opacity="0.8"/>
                                    </StackPanel>
                                    
                                    <!-- Recording Status Indicator -->
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="RecordDurationText"
                                                   Text="00:00"
                                                   Foreground="#FF4D4D"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Margin="0,0,14,0"
                                                   Visibility="Collapsed"/>
                                        <Border x:Name="RecordingPulse"
                                                Background="#FF4D4D"
                                                Width="12" Height="12"
                                                CornerRadius="6"
                                                Visibility="Collapsed">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="Visibility" Value="Visible">
                                                            <Trigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard RepeatBehavior="Forever">
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         From="1" To="0.2"
                                                                                         Duration="0:0:0.6"
                                                                                         AutoReverse="True"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                         From="1" To="1.5" Duration="0:0:0.6" AutoReverse="True"/>
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                         From="1" To="1.5" Duration="0:0:0.6" AutoReverse="True"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.EnterActions>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.RenderTransform>
                                                <ScaleTransform CenterX="6" CenterY="6"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- 1. MODE SELECTION (4 OPTIONS) -->
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="RECORDING MODE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <Border x:Name="GameDetectBadge" Visibility="Collapsed" HorizontalAlignment="Right" Background="#1A2030" Padding="10,4" CornerRadius="8" BorderBrush="{StaticResource NeonBlueBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="#00FF9D" Margin="0,0,8,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <Trigger Property="Visibility" Value="Visible">
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.8"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock x:Name="GameDetectText" Text="GAME DETECTED: Genshin Impact" FontSize="10" FontWeight="Bold" Foreground="#00FF9D"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <WrapPanel Margin="0,0,0,20" ItemWidth="160">
                                    <Border x:Name="ModeFullScreen" CornerRadius="12" Background="#141922" BorderThickness="2" BorderBrush="{StaticResource NeonBlueBrush}" Margin="0,0,8,8" Padding="15" Cursor="Hand" Tag="FullScreen" MouseLeftButtonDown="RecordingMode_Click">
                                        <Grid>
                                            <Canvas x:Name="CanvasFullScreen" Opacity="0.1" Background="{StaticResource NeonBlueBrush}" IsHitTestVisible="False"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🖥️" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                                <TextBlock Text="Full Screen" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Captures Entire Monitor" FontSize="9" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" Opacity="0.6"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="ModeApp" CornerRadius="12" Background="#111620" BorderThickness="1" BorderBrush="#1A2030" Margin="0,0,8,8" Padding="15" Cursor="Hand" Tag="Application" MouseLeftButtonDown="RecordingMode_Click">
                                        <Grid>
                                            <Canvas x:Name="CanvasApp" Opacity="0.1" Background="#6B7280" IsHitTestVisible="False"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🎮" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                                <TextBlock Text="Specific App" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Games &amp; Software" FontSize="9" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" Opacity="0.6"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="ModeArea" CornerRadius="12" Background="#111620" BorderThickness="1" BorderBrush="#1A2030" Margin="0,0,8,8" Padding="15" Cursor="Hand" Tag="Area" MouseLeftButtonDown="RecordingMode_Click">
                                        <Grid>
                                            <Canvas x:Name="CanvasArea" Opacity="0.1" Background="#F59E0B" IsHitTestVisible="False"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="📐" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                                <TextBlock Text="Select Area" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Custom Rectangle" FontSize="9" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" Opacity="0.6"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="ModeWindow" CornerRadius="12" Background="#111620" BorderThickness="1" BorderBrush="#1A2030" Margin="0,0,0,8" Padding="15" Cursor="Hand" Tag="Window" MouseLeftButtonDown="RecordingMode_Click">
                                        <Grid>
                                            <Canvas x:Name="CanvasWindow" Opacity="0.1" Background="#3B82F6" IsHitTestVisible="False"/>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🪟" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                                <TextBlock Text="Window" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Single Window Capture" FontSize="9" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" Opacity="0.6"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </WrapPanel>

                                <!-- 2. CAPTURE CONTROLS -->
                                <Border Background="#111620" CornerRadius="16" Padding="24" BorderThickness="1" BorderBrush="#1A2030">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="HARDWARE SETTINGS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,15"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock Text="FRAMERATE" FontSize="9" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,6"/>
                                                    <ComboBox x:Name="FpsComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                                        <ComboBoxItem Content="30 FPS"/>
                                                        <ComboBoxItem Content="60 FPS"/>
                                                        <ComboBoxItem Content="120 FPS (Pro)"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="5,0">
                                                    <TextBlock Text="AUDIO SOURCE" FontSize="9" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,6"/>
                                                    <ComboBox x:Name="MicComboBox" Style="{StaticResource ModernComboBox}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                                    <TextBlock Text="SYSTEM SOUND" FontSize="9" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,6"/>
                                                    <ComboBox x:Name="SpeakerComboBox" Style="{StaticResource ModernComboBox}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Format & Bitrate -->
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock Text="FORMAT" FontSize="9" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,6"/>
                                                    <ComboBox x:Name="FormatComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                                        <ComboBoxItem Content="MP4" Tag="mp4"/>
                                                        <ComboBoxItem Content="MKV" Tag="mkv"/>
                                                        <ComboBoxItem Content="WebM" Tag="webm"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="5,0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="QUALITY" FontSize="9" Foreground="{StaticResource SubTextBrush}"/>
                                                        <TextBlock x:Name="BitrateLabel" Text=" — 8 Mbps" FontSize="9" Foreground="{StaticResource NeonBlueBrush}"/>
                                                    </StackPanel>
                                                    <Slider x:Name="BitrateSlider" Minimum="2000" Maximum="50000" Value="8000"
                                                            TickFrequency="2000" IsSnapToTickEnabled="True"
                                                            ValueChanged="BitrateSlider_ValueChanged"/>
                                                </StackPanel>
                                                <Button x:Name="PauseResumeBtn" Grid.Column="2"
                                                        Content="⏸ Pause" Margin="10,0,0,0"
                                                        Style="{StaticResource CasualBtn}" FontSize="10"
                                                        Visibility="Collapsed"
                                                        Click="PauseResumeBtn_Click"/>
                                            </Grid>

                                            <!-- Features & Info -->
                                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                                <CheckBox x:Name="CinematicZoomToggle" IsChecked="True" Style="{StaticResource ModernCheckBox}" Margin="0,0,20,0">
                                                    <TextBlock Text="Cinematic Camera Zoom" FontSize="10" Foreground="#00D68F" FontWeight="Bold"/>
                                                </CheckBox>
                                                <Border x:Name="HotkeyBorder" Background="#2000D9FF" CornerRadius="4" Padding="8,4" Cursor="Hand" MouseLeftButtonDown="HotkeyBorder_MouseLeftButtonDown">
                                                    <TextBlock x:Name="HotkeyDisplayText" Text="Hotkey: F9" FontSize="10" Foreground="{StaticResource NeonBlueBrush}" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Pulse Record Button -->
                                        <Button Grid.Column="1" x:Name="RecorderPageRecordBtn" Width="80" Height="80" Click="ZeroRecordBtn_Click" Margin="20,0,0,0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Ellipse x:Name="outer" Stroke="#FF4D4D" StrokeThickness="2" Margin="-6" Opacity="0.3"/>
                                                        <Ellipse x:Name="bg" Fill="#FF4D4D" Opacity="0.1"/>
                                                        <Ellipse x:Name="dot" Fill="#FF4D4D" Width="34" Height="34"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="dot" Property="Width" Value="38"/>
                                                            <Setter TargetName="dot" Property="Height" Value="38"/>
                                                            <Setter TargetName="bg" Property="Opacity" Value="0.2"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- 3. RECORDING HISTORY -->
                                <Grid Margin="0,24,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="RECENT RECORDINGS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="OPEN FOLDER" Style="{StaticResource CasualBtn}" FontSize="10" Click="OpenRecordingsBtn_Click"/>
                                </Grid>

                                <ScrollViewer Height="250" Margin="0,12,0,0">
                                    <ItemsControl x:Name="RecordingHistoryList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#141922" CornerRadius="10" Padding="15" Margin="0,0,0,8" BorderThickness="1" BorderBrush="#1A2030">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="40" Height="40" Background="#1A2030" CornerRadius="8" Margin="0,0,15,0">
                                                            <TextBlock Text="🎬" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding CreationDate}" FontSize="11" Foreground="{StaticResource SubTextBrush}"/>
                                                                <TextBlock Text=" • " Foreground="{StaticResource SubTextBrush}"/>
                                                                <TextBlock Text="{Binding FileSize}" FontSize="11" Foreground="{StaticResource SubTextBrush}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="PLAY" Style="{StaticResource ActionButton}" Padding="12,5" FontSize="10" Margin="0,0,8,0" Click="PlayRecording_Click"/>
                                                            <Button Content="✕" Style="{StaticResource CasualBtn}" Padding="10,5" FontSize="10" Foreground="#FF5555" Click="DeleteRecording_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ═══ SLEEP MODE SETTINGS VIEW ═══ -->
                        <ScrollViewer x:Name="SleepContent"
                                      Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto"
                                      BorderThickness="0">
                            <StackPanel Margin="0,0,0,30">
                                <!-- Header + Back -->
                                <Grid Margin="0,0,0,24">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Button Content="← Back" Click="SleepBackBtn_Click"
                                                    Style="{StaticResource CasualBtn}" Padding="12,5" FontSize="11" Margin="0,0,12,0"/>
                                            <TextBlock Text="Sleep Mode Settings"
                                                       FontSize="28" FontWeight="Black"
                                                       Foreground="{StaticResource NeonBlueBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Configure how fake sleep behaves"
                                                   FontSize="13" Foreground="{StaticResource SubTextBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Trigger Mode -->
                                <TextBlock Text="BEHAVIOR MODE" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <CheckBox x:Name="SLP_ManualModeChk" Content="Direct Activation (Manual)" IsChecked="True" Style="{StaticResource ModernCheckBox}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <CheckBox x:Name="SLP_IdleModeChk" Content="Active when Idle" Style="{StaticResource ModernCheckBox}" VerticalAlignment="Center" Margin="0"/>
                                            <TextBox x:Name="SLP_IdleSecondsTxt" Text="60" Width="40" Margin="10,0,5,0" HorizontalContentAlignment="Center"/>
                                            <TextBlock Text="sec" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox x:Name="SLP_ShortcutModeChk" Content="Shortcut Activation" Style="{StaticResource ModernCheckBox}" VerticalAlignment="Center" Margin="0"/>
                                            <TextBox x:Name="SLP_ShortcutTxt" Text="Alt + S" IsReadOnly="True" Width="80" Margin="10,0,0,0" HorizontalContentAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Exit Behavior -->
                                <TextBlock Text="EXIT BEHAVIOR" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <CheckBox x:Name="SLP_ExitMouseMoveChk" Content="Exit on Mouse Move" IsChecked="True" Style="{StaticResource ModernCheckBox}"/>
                                        <CheckBox x:Name="SLP_ExitMouseDownChk" Content="Exit on Mouse Click" IsChecked="True" Style="{StaticResource ModernCheckBox}"/>
                                        <CheckBox x:Name="SLP_ExitKeyDownChk" Content="Exit on Key Press" IsChecked="True" Style="{StaticResource ModernCheckBox}"/>
                                    </StackPanel>
                                </Border>

                                <!-- AOD Style -->
                                <TextBlock Text="ALWAYS-ON DISPLAY STYLE" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                                <UniformGrid Columns="3" Margin="0,0,0,20">
                                    <Border x:Name="SLP_StyleCardMinimal" CornerRadius="10" Margin="0,0,6,6" Padding="10" Cursor="Hand"
                                            Background="#141922" BorderThickness="2" BorderBrush="{StaticResource NeonBlueBrush}"
                                            MouseLeftButtonDown="SLP_StyleCard_Click" Tag="MinimalClock">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="00:00" FontSize="18" FontWeight="Bold" Foreground="#44FFFFFF" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Minimal" FontSize="10" Foreground="{StaticResource NeonBlueBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="SLP_StyleCardGlow" CornerRadius="10" Margin="3,0,3,6" Padding="10" Cursor="Hand"
                                            Background="#141922" BorderThickness="1" BorderBrush="#1A2030"
                                            MouseLeftButtonDown="SLP_StyleCard_Click" Tag="DigitalGlow">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="00:00" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#00D9FF"/>
                                            <TextBlock Text="Neon Glow" FontSize="10" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="SLP_StyleCardAnalog" CornerRadius="10" Margin="6,0,0,6" Padding="10" Cursor="Hand"
                                            Background="#141922" BorderThickness="1" BorderBrush="#1A2030"
                                            MouseLeftButtonDown="SLP_StyleCard_Click" Tag="Analog">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Ellipse Width="30" Height="30" Stroke="#44FFFFFF" StrokeThickness="1.5" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Analog" FontSize="10" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="SLP_StyleCardDate" CornerRadius="10" Margin="0,0,6,0" Padding="10" Cursor="Hand"
                                            Background="#141922" BorderThickness="1" BorderBrush="#1A2030"
                                            MouseLeftButtonDown="SLP_StyleCard_Click" Tag="DateFocus">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="APR 5" FontSize="14" FontWeight="Bold" Foreground="#44FFFFFF" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Date Focus" FontSize="10" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="SLP_StyleCardBlank" CornerRadius="10" Margin="3,0,3,0" Padding="10" Cursor="Hand"
                                            Background="#0A0A0A" BorderThickness="1" BorderBrush="#1A2030"
                                            MouseLeftButtonDown="SLP_StyleCard_Click" Tag="Blank">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="■" FontSize="18" Foreground="#11FFFFFF" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Blank" FontSize="10" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Brightness -->
                                <TextBlock Text="BRIGHTNESS" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="Brightness" Foreground="{StaticResource SubTextBrush}" FontSize="11"/>
                                            <TextBlock x:Name="SLP_BrightnessLabel" Text=" — 100%" Foreground="{StaticResource NeonBlueBrush}" FontSize="11"/>
                                        </StackPanel>
                                        <Slider x:Name="SLP_BrightnessSld" Minimum="0.2" Maximum="1.0" Value="1.0"
                                                TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                ValueChanged="SLP_BrightnessSld_ValueChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- Custom Background -->
                                <TextBlock Text="CUSTOM BACKGROUND" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Pilih gambar atau video sebagai background AOD"
                                                   Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#0D1117" CornerRadius="6" Padding="8,6" Margin="0,0,8,0">
                                                <TextBlock x:Name="SLP_CustomBgPathText" Text="Tidak ada file dipilih"
                                                           Foreground="{StaticResource SubTextBrush}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </Border>
                                            <Button Grid.Column="1" Content="Pilih File" Style="{StaticResource ActionButton}"
                                                    Padding="12,6" Click="SLP_BrowseCustomBg_Click" Margin="0,0,6,0"/>
                                            <Button Grid.Column="2" Content="✕" Style="{StaticResource CasualBtn}"
                                                    Padding="10,6" Click="SLP_ClearCustomBg_Click"/>
                                        </Grid>
                                        <TextBlock Text="Format: JPG, PNG, MP4, WebM"
                                                   Foreground="#44FFFFFF" FontSize="10" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Music -->
                                <TextBlock Text="MUSIC (OPSIONAL)" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Putar musik saat Sleep Mode aktif — bisa dipakai dengan background apapun"
                                                   Foreground="{StaticResource SubTextBrush}" FontSize="11" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#0D1117" CornerRadius="6" Padding="8,6" Margin="0,0,8,0">
                                                <TextBlock x:Name="SLP_MusicPathText" Text="Tidak ada musik dipilih"
                                                           Foreground="{StaticResource SubTextBrush}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </Border>
                                            <Button Grid.Column="1" Content="Pilih Musik" Style="{StaticResource ActionButton}"
                                                    Padding="12,6" Click="SLP_BrowseMusic_Click" Margin="0,0,6,0"/>
                                            <Button Grid.Column="2" Content="✕" Style="{StaticResource CasualBtn}"
                                                    Padding="10,6" Click="SLP_ClearMusic_Click"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <TextBlock Text="Volume" Foreground="{StaticResource SubTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Slider x:Name="SLP_MusicVolumeSld" Minimum="0" Maximum="1" Value="0.5"
                                                    Width="160" VerticalAlignment="Center" ValueChanged="SLP_MusicVolumeSld_ValueChanged"/>
                                            <TextBlock x:Name="SLP_MusicVolumeLabel" Text="50%" Foreground="{StaticResource NeonBlueBrush}"
                                                       FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Start Button -->
                                <Button Content="Start Sleep Mode" Click="SLP_StartBtn_Click"
                                        Style="{StaticResource PrimaryBtn}" Width="200" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </ScrollViewer>

                    </Grid>
                </Grid>
            </Grid>

            <!-- Resize Grip Visual -->
            <Path Data="M 8,0 L 0,8" Stroke="#2A3040" StrokeThickness="1"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,6,6"/>
            <Path Data="M 8,0 L 0,8" Stroke="#2A3040" StrokeThickness="1"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,10,10"/>
        </Grid>
    </Border>
</ui:FluentWindow>
