                        <!--  â•â•â• PLUGINS VIEW â•â•â•  -->
                        <ScrollViewer
                            x:Name="PluginsContent"
                            BorderThickness="0"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Stretch">
                                <!--  Header  -->
                                <Grid Margin="0,0,0,24">
                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,0,0,4"
                                            FontSize="28"
                                            FontWeight="ExtraBold"
                                            Foreground="White"
                                            Text="Extensions" />
                                        <TextBlock
                                            FontSize="14"
                                            Foreground="{StaticResource SubTextBrush}"
                                            Text="Enhance your experience with custom modules" />
                                    </StackPanel>
                                    <Button
                                        x:Name="CreatePluginBtn"
                                        Padding="16,8"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Click="CreatePluginBtn_Click"
                                        Style="{StaticResource ActionButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                Text="&#xE710;" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Text="Buat Plugin" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!--  Plugins List  -->
                                <StackPanel x:Name="PluginsListPanel">
                                    <TextBlock
                                        Margin="0,0,0,14"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        Text="PLUGINS &amp; EXTENSIONS" />
                                    <!--  Built-in  -->
                                    <welcome:WelcomePluginUI />
                                    <weather:WeatherPluginUI />
                                    <battery:BatteryPluginUI />
                                    <translate:TranslatePluginUI />
                                    <chargernotif:ChargerNotifUI />
                                    <snaplayout:SnapLayoutUI />
                                    
                                    <!--  CatGatekeeper: loaded lazily from code-behind  -->
                                    <ContentPresenter x:Name="CatGatekeeperContainer" />
                                    <StackPanel x:Name="UserPluginsContainer" Margin="0,12,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!--  â•â•â• RECORDER VIEW â•â•â•  -->
                        <ScrollViewer
                            x:Name="RecorderContent"
                            BorderThickness="0"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed">
                            <StackPanel Margin="0,0,0,30">
                                <!--  Header Section  -->
                                <Grid Margin="0,0,0,24">
                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,0,0,4"
                                            FontSize="32"
                                            FontWeight="Black"
                                            Foreground="{StaticResource NeonBlueBrush}"
                                            Text="ZeroRecord" />
                                        <TextBlock
                                            FontSize="14"
                                            Foreground="{StaticResource SubTextBrush}"
                                            Opacity="0.8"
                                            Text="Cinematic, Smooth, GPU-Powered Capture." />
                                    </StackPanel>

                                    <!--  Recording Status Indicator  -->
                                    <StackPanel
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            x:Name="RecordDurationText"
                                            Margin="0,0,14,0"
                                            FontSize="20"
                                            FontWeight="Bold"
                                            Foreground="#FF4D4D"
                                            Text="00:00"
                                            Visibility="Collapsed" />
                                        <Border
                                            x:Name="RecordingPulse"
                                            Width="12"
                                            Height="12"
                                            Background="#FF4D4D"
                                            CornerRadius="6"
                                            Visibility="Collapsed">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="Visibility" Value="Visible">
                                                            <Trigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard RepeatBehavior="Forever">
                                                                        <DoubleAnimation
                                                                            AutoReverse="True"
                                                                            Storyboard.TargetProperty="Opacity"
                                                                            From="1"
                                                                            To="0.2"
                                                                            Duration="0:0:0.6" />
                                                                        <DoubleAnimation
                                                                            AutoReverse="True"
                                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                            From="1"
                                                                            To="1.5"
                                                                            Duration="0:0:0.6" />
                                                                        <DoubleAnimation
                                                                            AutoReverse="True"
                                                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                            From="1"
                                                                            To="1.5"
                                                                            Duration="0:0:0.6" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.EnterActions>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.RenderTransform>
                                                <ScaleTransform CenterX="6" CenterY="6" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!--  1. MODE SELECTION (4 OPTIONS)  -->
                                <Grid Margin="0,0,0,12">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        Text="RECORDING MODE" />
                                    <Border
                                        x:Name="GameDetectBadge"
                                        Padding="10,4"
                                        HorizontalAlignment="Right"
                                        Background="#1A2030"
                                        BorderBrush="{StaticResource NeonBlueBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse
                                                Width="8"
                                                Height="8"
                                                Margin="0,0,8,0"
                                                Fill="#00FF9D">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <Trigger Property="Visibility" Value="Visible">
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                                            <DoubleAnimation
                                                                                Storyboard.TargetProperty="Opacity"
                                                                                From="1"
                                                                                To="0.2"
                                                                                Duration="0:0:0.8" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock
                                                x:Name="GameDetectText"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="#00FF9D"
                                                Text="GAME DETECTED: Genshin Impact" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <WrapPanel Margin="0,0,0,20" ItemWidth="160">
                                    <Border
                                        x:Name="ModeFullScreen"
                                        Margin="0,0,8,8"
                                        Padding="16"
                                        Style="{StaticResource RecModeCard}"
                                        BorderBrush="{StaticResource NeonBlueBrush}"
                                        BorderThickness="2"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="RecordingMode_Click"
                                        Tag="FullScreen">
                                        <Grid>
                                            <Canvas
                                                x:Name="CanvasFullScreen"
                                                Background="{StaticResource NeonBlueBrush}"
                                                IsHitTestVisible="False"
                                                Opacity="0.1" />
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock
                                                    Margin="0,0,0,5"
                                                    HorizontalAlignment="Center"
                                                    FontSize="20"
                                                    Text="🖥️" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource TextBrush}"
                                                    Text="Full Screen" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="9"
                                                    Foreground="{StaticResource SubTextBrush}"
                                                    Opacity="0.6"
                                                    Text="Captures Entire Monitor" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border
                                        x:Name="ModeApp"
                                        Margin="0,0,8,8"
                                        Padding="16"
                                        Style="{StaticResource RecModeCard}"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="RecordingMode_Click"
                                        Tag="Application">
                                        <Grid>
                                            <Canvas
                                                x:Name="CanvasApp"
                                                Background="#6B7280"
                                                IsHitTestVisible="False"
                                                Opacity="0.1" />
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock
                                                    Margin="0,0,0,5"
                                                    HorizontalAlignment="Center"
                                                    FontSize="20"
                                                    Text="📱" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource TextBrush}"
                                                    Text="Specific App" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="9"
                                                    Foreground="{StaticResource SubTextBrush}"
                                                    Opacity="0.6"
                                                    Text="Games &amp; Software" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border
                                        x:Name="ModeArea"
                                        Margin="0,0,8,8"
                                        Padding="16"
                                        Style="{StaticResource RecModeCard}"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="RecordingMode_Click"
                                        Tag="Area">
                                        <Grid>
                                            <Canvas
                                                x:Name="CanvasArea"
                                                Background="#F59E0B"
                                                IsHitTestVisible="False"
                                                Opacity="0.1" />
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock
                                                    Margin="0,0,0,5"
                                                    HorizontalAlignment="Center"
                                                    FontSize="20"
                                                    Text="✂️" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource TextBrush}"
                                                    Text="Select Area" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="9"
                                                    Foreground="{StaticResource SubTextBrush}"
                                                    Opacity="0.6"
                                                    Text="Custom Rectangle" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border
                                        x:Name="ModeWindow"
                                        Margin="0,0,0,8"
                                        Padding="16"
                                        Style="{StaticResource RecModeCard}"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="RecordingMode_Click"
                                        Tag="Window">
                                        <Grid>
                                            <Canvas
                                                x:Name="CanvasWindow"
                                                Background="#3B82F6"
                                                IsHitTestVisible="False"
                                                Opacity="0.1" />
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock
                                                    Margin="0,0,0,5"
                                                    HorizontalAlignment="Center"
                                                    FontSize="20"
                                                    Text="🪟" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource TextBrush}"
                                                    Text="Window" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="9"
                                                    Foreground="{StaticResource SubTextBrush}"
                                                    Opacity="0.6"
                                                    Text="Single Window Capture" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </WrapPanel>

                                <!--  2. CAPTURE CONTROLS  -->
                                <Border
                                    Padding="24"
                                    Background="#111620"
                                    BorderBrush="#1A2030"
                                    BorderThickness="1"
                                    CornerRadius="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock
                                                Margin="0,0,0,15"
                                                FontSize="10"
                                                FontWeight="Bold"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                Text="HARDWARE SETTINGS" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock
                                                        Margin="0,0,0,6"
                                                        FontSize="9"
                                                        Foreground="{StaticResource SubTextBrush}"
                                                        Text="FRAMERATE" />
                                                    <ComboBox
                                                        x:Name="FpsComboBox"
                                                        SelectedIndex="0"
                                                        Style="{StaticResource ModernComboBox}">
                                                        <ComboBoxItem Content="30 FPS" />
                                                        <ComboBoxItem Content="60 FPS" />
                                                        <ComboBoxItem Content="120 FPS (Pro)" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="5,0">
                                                    <TextBlock
                                                        Margin="0,0,0,6"
                                                        FontSize="9"
                                                        Foreground="{StaticResource SubTextBrush}"
                                                        Text="AUDIO SOURCE" />
                                                    <ComboBox x:Name="MicComboBox" Style="{StaticResource ModernComboBox}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                                    <TextBlock
                                                        Margin="0,0,0,6"
                                                        FontSize="9"
                                                        Foreground="{StaticResource SubTextBrush}"
                                                        Text="SYSTEM SOUND" />
                                                    <ComboBox x:Name="SpeakerComboBox" Style="{StaticResource ModernComboBox}" />
                                                </StackPanel>
                                            </Grid>

                                            <!--  Format & Bitrate  -->
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                    <TextBlock
                                                        Margin="0,0,0,6"
                                                        FontSize="9"
                                                        Foreground="{StaticResource SubTextBrush}"
                                                        Text="FORMAT" />
                                                    <ComboBox
                                                        x:Name="FormatComboBox"
                                                        SelectedIndex="0"
                                                        Style="{StaticResource ModernComboBox}">
                                                        <ComboBoxItem Content="MP4" Tag="mp4" />
                                                        <ComboBoxItem Content="MKV" Tag="mkv" />
                                                        <ComboBoxItem Content="WebM" Tag="webm" />
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="5,0">
                                                    <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                                        <TextBlock
                                                            FontSize="9"
                                                            Foreground="{StaticResource SubTextBrush}"
                                                            Text="QUALITY" />
                                                        <TextBlock
                                                            x:Name="BitrateLabel"
                                                            FontSize="9"
                                                            Foreground="{StaticResource NeonBlueBrush}"
                                                            Text=" — 8 Mbps" />
                                                    </StackPanel>
                                                    <Slider
                                                        x:Name="BitrateSlider"
                                                        IsSnapToTickEnabled="True"
                                                        Maximum="50000"
                                                        Minimum="2000"
                                                        TickFrequency="2000"
                                                        ValueChanged="BitrateSlider_ValueChanged"
                                                        Value="8000" />
                                                </StackPanel>
                                                <Button
                                                    x:Name="PauseResumeBtn"
                                                    Grid.Column="2"
                                                    Margin="10,0,0,0"
                                                    Click="PauseResumeBtn_Click"
                                                    Content="⏸ Pause"
                                                    FontSize="10"
                                                    Style="{StaticResource CasualBtn}"
                                                    Visibility="Collapsed" />
                                            </Grid>

                                            <!--  Features & Info  -->
                                            <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                                                <CheckBox
                                                    x:Name="CinematicZoomToggle"
                                                    Margin="0,0,20,0"
                                                    IsChecked="True"
                                                    Style="{StaticResource ModernCheckBox}">
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="Bold"
                                                        Foreground="#00D68F"
                                                        Text="Cinematic Camera Zoom" />
                                                </CheckBox>
                                                <Border
                                                    x:Name="HotkeyBorder"
                                                    Padding="8,4"
                                                    Background="#2000D9FF"
                                                    CornerRadius="4"
                                                    Cursor="Hand"
                                                    MouseLeftButtonDown="HotkeyBorder_MouseLeftButtonDown">
                                                    <TextBlock
                                                        x:Name="HotkeyDisplayText"
                                                        FontSize="10"
                                                        FontWeight="Bold"
                                                        Foreground="{StaticResource NeonBlueBrush}"
                                                        Text="Hotkey: F9" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!--  Pulse Record Button  -->
                                        <Button
                                            x:Name="RecorderPageRecordBtn"
                                            Grid.Column="1"
                                            Width="80"
                                            Height="80"
                                            Margin="20,0,0,0"
                                            Click="ZeroRecordBtn_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Ellipse
                                                            x:Name="outer"
                                                            Margin="-6"
                                                            Opacity="0.3"
                                                            Stroke="#FF4D4D"
                                                            StrokeThickness="2" />
                                                        <Ellipse
                                                            x:Name="bg"
                                                            Fill="#FF4D4D"
                                                            Opacity="0.1" />
                                                        <Ellipse
                                                            x:Name="dot"
                                                            Width="34"
                                                            Height="34"
                                                            Fill="#FF4D4D" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="dot" Property="Width" Value="38" />
                                                            <Setter TargetName="dot" Property="Height" Value="38" />
                                                            <Setter TargetName="bg" Property="Opacity" Value="0.2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!--  3. RECORDING HISTORY  -->
                                <Grid Margin="0,24,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        Text="RECENT RECORDINGS" />
                                    <Button
                                        Grid.Column="1"
                                        Click="OpenRecordingsBtn_Click"
                                        Content="OPEN FOLDER"
                                        FontSize="10"
                                        Style="{StaticResource CasualBtn}" />
                                </Grid>

                                <ScrollViewer Height="250" Margin="0,12,0,0">
                                    <ItemsControl x:Name="RecordingHistoryList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,0,0,8"
                                                    Padding="15"
                                                    Style="{StaticResource HoverCard}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border
                                                            Grid.Column="0"
                                                            Width="40"
                                                            Height="40"
                                                            Margin="0,0,15,0"
                                                            Background="#1A2030"
                                                            CornerRadius="8">
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontSize="20"
                                                                Text="🎬" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock
                                                                FontSize="13"
                                                                FontWeight="Bold"
                                                                Foreground="{StaticResource TextBrush}"
                                                                Text="{Binding FileName}" />
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    Foreground="{StaticResource SubTextBrush}"
                                                                    Text="{Binding CreationDate}" />
                                                                <TextBlock Foreground="{StaticResource SubTextBrush}" Text=" • " />
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    Foreground="{StaticResource SubTextBrush}"
                                                                    Text="{Binding FileSize}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel
                                                            Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal">
                                                            <Button
                                                                Margin="0,0,8,0"
                                                                Padding="12,5"
                                                                Click="PlayRecording_Click"
                                                                Content="PLAY"
                                                                FontSize="10"
                                                                Style="{StaticResource ActionButton}" />
                                                            <Button
                                                                Padding="10,5"
                                                                Click="DeleteRecording_Click"
                                                                Content="🗑"
                                                                FontSize="12"
                                                                Foreground="#FF5555"
                                                                Style="{StaticResource CasualBtn}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </ScrollViewer>

                        <!--  â•â•â• SLEEP MODE SETTINGS VIEW â•â•â•  -->
                        <ScrollViewer
                            x:Name="SleepContent"
                            BorderThickness="0"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed">
                            <StackPanel Margin="0,0,0,30">
                                <!--  Header + Back  -->
                                <Grid Margin="0,0,0,24">
                                    <StackPanel>
                                        <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                            <Button
                                                Margin="0,0,12,0"
                                                Padding="12,5"
                                                Click="SleepBackBtn_Click"
                                                Content="← Back"
                                                FontSize="11"
                                                Style="{StaticResource CasualBtn}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="28"
                                                FontWeight="Black"
                                                Foreground="{StaticResource NeonBlueBrush}"
                                                Text="Sleep Mode Settings" />
                                        </StackPanel>
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{StaticResource SubTextBrush}"
                                            Text="Configure how fake sleep behaves" />
                                    </StackPanel>
                                </Grid>

                                <!--  Trigger Mode  -->
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="BEHAVIOR MODE" />
                                <Border Margin="0,0,0,20" Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <CheckBox
                                            x:Name="SLP_ManualModeChk"
                                            Content="Direct Activation (Manual)"
                                            IsChecked="True"
                                            Style="{StaticResource ModernCheckBox}" />
                                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                            <CheckBox
                                                x:Name="SLP_IdleModeChk"
                                                Margin="0"
                                                VerticalAlignment="Center"
                                                Content="Active when Idle"
                                                Style="{StaticResource ModernCheckBox}" />
                                            <TextBox
                                                x:Name="SLP_IdleSecondsTxt"
                                                Width="40"
                                                Margin="10,0,5,0"
                                                HorizontalContentAlignment="Center"
                                                Text="60" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource SubTextBrush}"
                                                Text="sec" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox
                                                x:Name="SLP_ShortcutModeChk"
                                                Margin="0"
                                                VerticalAlignment="Center"
                                                Content="Shortcut Activation"
                                                Style="{StaticResource ModernCheckBox}" />
                                            <TextBox
                                                x:Name="SLP_ShortcutTxt"
                                                Width="80"
                                                Margin="10,0,0,0"
                                                HorizontalContentAlignment="Center"
                                                IsReadOnly="True"
                                                Text="Alt + S" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>


                                <!--  Exit Behavior  -->
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="EXIT BEHAVIOR" />
                                <Border Margin="0,0,0,20" Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <CheckBox
                                            x:Name="SLP_ExitMouseMoveChk"
                                            Content="Exit on Mouse Move"
                                            IsChecked="True"
                                            Style="{StaticResource ModernCheckBox}" />
                                        <CheckBox
                                            x:Name="SLP_ExitMouseDownChk"
                                            Content="Exit on Mouse Click"
                                            IsChecked="True"
                                            Style="{StaticResource ModernCheckBox}" />
                                        <CheckBox
                                            x:Name="SLP_ExitKeyDownChk"
                                            Content="Exit on Key Press"
                                            IsChecked="True"
                                            Style="{StaticResource ModernCheckBox}" />
                                    </StackPanel>
                                </Border>

                                <!--  AOD Style  -->
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="ALWAYS-ON DISPLAY STYLE" />
                                <UniformGrid Margin="0,0,0,20" Columns="3">
                                    <Border
                                        x:Name="SLP_StyleCardMinimal"
                                        Margin="0,0,6,6"
                                        Padding="10"
                                        Background="#141922"
                                        BorderBrush="{StaticResource NeonBlueBrush}"
                                        BorderThickness="2"
                                        CornerRadius="10"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="SLP_StyleCard_Click"
                                        Tag="MinimalClock">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="18"
                                                FontWeight="Bold"
                                                Foreground="#44FFFFFF"
                                                Text="00:00" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource NeonBlueBrush}"
                                                Text="Minimal" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        x:Name="SLP_StyleCardGlow"
                                        Margin="3,0,3,6"
                                        Padding="10"
                                        Background="#141922"
                                        BorderBrush="#1A2030"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="SLP_StyleCard_Click"
                                        Tag="DigitalGlow">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="18"
                                                FontWeight="Bold"
                                                Foreground="#00D9FF"
                                                Text="00:00" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{StaticResource SubTextBrush}"
                                                Text="Neon Glow" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        x:Name="SLP_StyleCardAnalog"
                                        Margin="6,0,0,6"
                                        Padding="10"
                                        Background="#141922"
                                        BorderBrush="#1A2030"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="SLP_StyleCard_Click"
                                        Tag="Analog">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Ellipse
                                                Width="30"
                                                Height="30"
                                                HorizontalAlignment="Center"
                                                Stroke="#44FFFFFF"
                                                StrokeThickness="1.5" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{StaticResource SubTextBrush}"
                                                Text="Analog" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        x:Name="SLP_StyleCardDate"
                                        Margin="0,0,6,0"
                                        Padding="10"
                                        Background="#141922"
                                        BorderBrush="#1A2030"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="SLP_StyleCard_Click"
                                        Tag="DateFocus">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Foreground="#44FFFFFF"
                                                Text="APR 5" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{StaticResource SubTextBrush}"
                                                Text="Date Focus" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        x:Name="SLP_StyleCardBlank"
                                        Margin="3,0,3,0"
                                        Padding="10"
                                        Background="#0A0A0A"
                                        BorderBrush="#1A2030"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="SLP_StyleCard_Click"
                                        Tag="Blank">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="18"
                                                Foreground="#11FFFFFF"
                                                Text="■" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="10"
                                                Foreground="{StaticResource SubTextBrush}"
                                                Text="Blank" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!--  Brightness  -->
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="BRIGHTNESS" />
                                <Border Margin="0,0,0,20" Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{StaticResource SubTextBrush}"
                                                Text="Brightness" />
                                            <TextBlock
                                                x:Name="SLP_BrightnessLabel"
                                                FontSize="11"
                                                Foreground="{StaticResource NeonBlueBrush}"
                                                Text=" — 100%" />
                                        </StackPanel>
                                        <Slider
                                            x:Name="SLP_BrightnessSld"
                                            IsSnapToTickEnabled="True"
                                            Maximum="1.0"
                                            Minimum="0.2"
                                            TickFrequency="0.1"
                                            ValueChanged="SLP_BrightnessSld_ValueChanged"
                                            Value="1.0" />
                                    </StackPanel>
                                </Border>

                                <!--  Custom Background  -->
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="CUSTOM BACKGROUND" />
                                <Border Margin="0,0,0,20" Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,0,0,10"
                                            FontSize="11"
                                            Foreground="{StaticResource SubTextBrush}"
                                            Text="Pilih gambar atau video sebagai background AOD" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Grid.Column="0"
                                                Margin="0,0,8,0"
                                                Padding="8,6"
                                                Background="#0D1117"
                                                CornerRadius="6">
                                                <TextBlock
                                                    x:Name="SLP_CustomBgPathText"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{StaticResource SubTextBrush}"
                                                    Text="Tidak ada file dipilih"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Button
                                                Grid.Column="1"
                                                Margin="0,0,6,0"
                                                Padding="12,6"
                                                Click="SLP_BrowseCustomBg_Click"
                                                Content="Pilih File"
                                                Style="{StaticResource ActionButton}" />
                                            <Button
                                                Grid.Column="2"
                                                Padding="10,6"
                                                Click="SLP_ClearCustomBg_Click"
                                                Content="?"
                                                Style="{StaticResource CasualBtn}" />
                                        </Grid>
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="10"
                                            Foreground="#44FFFFFF"
                                            Text="Format: JPG, PNG, MP4, WebM" />
                                    </StackPanel>
                                </Border>

                                <!--  Music  -->
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="MUSIC (OPSIONAL)" />
                                <Border Margin="0,0,0,20" Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,0,0,10"
                                            FontSize="11"
                                            Foreground="{StaticResource SubTextBrush}"
                                            Text="Putar musik saat Sleep Mode aktif — bisa dipakai dengan background apapun" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Grid.Column="0"
                                                Margin="0,0,8,0"
                                                Padding="8,6"
                                                Background="#0D1117"
                                                CornerRadius="6">
                                                <TextBlock
                                                    x:Name="SLP_MusicPathText"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{StaticResource SubTextBrush}"
                                                    Text="Tidak ada musik dipilih"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Button
                                                Grid.Column="1"
                                                Margin="0,0,6,0"
                                                Padding="12,6"
                                                Click="SLP_BrowseMusic_Click"
                                                Content="Pilih Musik"
                                                Style="{StaticResource ActionButton}" />
                                            <Button
                                                Grid.Column="2"
                                                Padding="10,6"
                                                Click="SLP_ClearMusic_Click"
                                                Content="?"
                                                Style="{StaticResource CasualBtn}" />
                                        </Grid>
                                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                            <TextBlock
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{StaticResource SubTextBrush}"
                                                Text="Volume" />
                                            <Slider
                                                x:Name="SLP_MusicVolumeSld"
                                                Width="160"
                                                VerticalAlignment="Center"
                                                Maximum="1"
                                                Minimum="0"
                                                ValueChanged="SLP_MusicVolumeSld_ValueChanged"
                                                Value="0.5" />
                                            <TextBlock
                                                x:Name="SLP_MusicVolumeLabel"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{StaticResource NeonBlueBrush}"
                                                Text="50%" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!--  Start Button  -->
                                <Button
                                    Width="200"
                                    HorizontalAlignment="Left"
                                    Click="SLP_StartBtn_Click"
                                    Content="Start Sleep Mode"
                                    Style="{StaticResource PrimaryBtn}" />
                            </StackPanel>
                        </ScrollViewer>

                        <!--  ═══ SETTINGS VIEW ═══  -->
                        <ScrollViewer
                            x:Name="SettingsContent"
                            BorderThickness="0"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed">
                            <StackPanel Margin="0,0,0,30">
                                <!--  Header + Back  -->
                                <Grid Margin="0,0,0,24">
                                    <StackPanel>
                                        <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                            <Button
                                                Margin="0,0,12,0"
                                                Padding="12,5"
                                                Click="SettingsBackBtn_Click"
                                                Content="← Back"
                                                FontSize="11"
                                                Style="{StaticResource CasualBtn}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="28"
                                                FontWeight="Black"
                                                Foreground="{StaticResource NeonBlueBrush}"
                                                Text="Settings" />
                                        </StackPanel>
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{StaticResource SubTextBrush}"
                                            Text="Customize which features appear on the dashboard" />
                                    </StackPanel>
                                </Grid>

                                <!--  Welcome Area (Dashboard Quick Actions)  -->
                                <TextBlock
                                    Margin="0,0,0,12"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    Text="WELCOME AREA" />
                                <Border Margin="0,0,0,20" Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,0,0,4"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource TextBrush}"
                                            Text="Dashboard Quick Actions" />
                                        <TextBlock
                                            Margin="0,0,0,14"
                                            FontSize="11"
                                            Foreground="{StaticResource SubTextBrush}"
                                            Text="Choose which quick actions appear on the welcome dashboard" />
                                        <UniformGrid Columns="2">
                                            <CheckBox
                                                x:Name="SettingsCb1"
                                                Margin="0,6,10,6"
                                                Content="System Health"
                                                Style="{StaticResource ModernCheckBox}" />
                                            <CheckBox
                                                x:Name="SettingsCb2"
                                                Margin="10,6,0,6"
                                                Content="Neural Clock"
                                                Style="{StaticResource ModernCheckBox}" />
                                            <CheckBox
                                                x:Name="SettingsCb3"
                                                Margin="0,6,10,6"
                                                Content="Ghost Taskbar"
                                                Style="{StaticResource ModernCheckBox}" />
                                            <CheckBox
                                                x:Name="SettingsCb4"
                                                Margin="10,6,0,6"
                                                Content="ZeroRecord"
                                                Style="{StaticResource ModernCheckBox}" />
                                            <CheckBox
                                                x:Name="SettingsCb5"
                                                Margin="0,6,10,6"
                                                Content="Sleep Mode"
                                                Style="{StaticResource ModernCheckBox}" />
                                            <CheckBox
                                                x:Name="SettingsCb6"
                                                Margin="10,6,0,6"
                                                Content="56Editor"
                                                Style="{StaticResource ModernCheckBox}" />
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!--  Save  -->
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Width="180"
                                        HorizontalAlignment="Left"
                                        Click="SettingsSaveBtn_Click"
                                        Content="Save Changes"
                                        Style="{StaticResource PrimaryBtn}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!--  â•â•â• ZEROCONNECT VIEW â•â•â•  -->
                        <ScrollViewer
                            x:Name="ZeroContent"
                            BorderThickness="0"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed">
                            <zc:ZeroConnectPage />
                        </ScrollViewer>

                    </Grid>

                </Grid>
            </Grid>


            <!--  Resize Grip Visual  -->
            <Path
                Margin="0,0,6,6"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Data="M 8,0 L 0,8"
                Stroke="#2A3040"
                StrokeThickness="1" />
            <Path
                Margin="0,0,10,10"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Data="M 8,0 L 0,8"
                Stroke="#2A3040"
                StrokeThickness="1" />
        </Grid>
    </Border>
</ui:FluentWindow>
