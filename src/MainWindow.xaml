                                            </TextBlock>
                                        </StackPanel>

                                        <!--  Cat Gatekeeper Credit  -->
                                        <TextBlock
                                            Margin="0,8,0,6"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            Text="🐱 Cat Gatekeeper" />
                                        <StackPanel Margin="8,0,0,16">
                                            <TextBlock
                                                Margin="0,0,0,4"
                                                FontSize="12"
                                                Foreground="{StaticResource SubTextBrush}"
                                                TextWrapping="Wrap">
                                                <Run Text="Aset video kucing asli oleh " />
                                                <Run
