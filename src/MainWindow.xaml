                                            <TextBlock Margin="0,0,0,4" FontSize="12">
                                                <Run Foreground="{StaticResource NeonBlueBrush}" Text="• " />
                                                <Hyperlink NavigateUri="https://x.com/konekone2026" RequestNavigate="Hyperlink_RequestNavigate">
                                                    https://x.com/konekone2026
