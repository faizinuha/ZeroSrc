<ui:FluentWindow x:Class="ZeroMix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tray="clr-namespace:Wpf.Ui.Tray.Controls;assembly=Wpf.Ui.Tray"
        mc:Ignorable="d"
        xmlns:local="clr-namespace:ZeroMix"
        xmlns:wallpapers="clr-namespace:ZeroMix.Wallpapers"
        xmlns:battery="clr-namespace:ZeroMix.Plugins.Battery"
        xmlns:weather="clr-namespace:ZeroMix.Plugins.Weather"
        xmlns:translate="clr-namespace:ZeroMix.Plugins.Translate"
        xmlns:chargernotif="clr-namespace:ZeroMix.Plugins.ChargerNotif"
        xmlns:welcome="clr-namespace:ZeroMix.Plugins.Welcome"
        Title="ZeroMix"
        Icon="../Assets/Icons/zeromix.ico"
        Height="650"
        Width="1000"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Background="Transparent"
        KeyDown="Window_KeyDown"
        ResizeMode="CanResizeWithGrip"
        StateChanged="Window_StateChanged"
        ShowInTaskbar="True"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Tools/Plugins/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Global ComboBox -->
            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="#141922"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontSize" Value="12"/>
                <Style.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#141922"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F0F2F5"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource NeonBlueColor}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
                </Style.Resources>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Background" Value="#141922"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource NeonBlueBrush}"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource NeonBlueBrush}"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Premium Navigation Button Style -->
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#B0B0B0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Height" Value="45"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Border x:Name="border"
                                        Background="Transparent"
                                        CornerRadius="8"
                                        Margin="10,2,10,2">
                                    <ContentPresenter VerticalAlignment="Center"
                                                      Margin="15,0,0,0"/>
                                </Border>
                                <!-- Precise Left Indicator -->
                                <Border x:Name="indicator"
                                        Width="4" Height="20"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        CornerRadius="0,2,2,0"
                                        Background="{StaticResource NeonBlueBrush}"
                                        Visibility="Collapsed"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#1AFFFFFF"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True">
                                    <Setter TargetName="indicator" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="border" Property="Background" Value="#12FFFFFF"/>
                                    <Setter Property="Foreground" Value="{StaticResource NeonBlueBrush}"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Quick Action Card Style -->
            <Style x:Key="QuickActionButton" TargetType="Button">
                <Setter Property="Background" Value="#0D1117"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#1E2A3A"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Height" Value="120"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#00BFA5"/>
                                    <Setter TargetName="border" Property="Background" Value="#111820"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#0A0E1A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary Button -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource NeonBlueBrush}"/>
                <Setter Property="Foreground" Value="#0A0D13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Padding" Value="28,12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="MainBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Hide ScrollBars Global -->
            <Style TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollViewer">
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
                <tray:NotifyIcon x:Key="AppTrayResource" ToolTip="ZeroMix" Visibility="Collapsed" />
        </ResourceDictionary>
    </Window.Resources>


    <!-- Main Container with rounded corners -->
    <Border x:Name="RootBorder"
            Style="{StaticResource MainBorderStyle}"
            Background="#0A0E1A"
            BorderThickness="0"
            ClipToBounds="True">
        <Grid x:Name="MainLayoutGrid">

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Modern Title Bar -->
                    <RowDefinition Height="38"/>
                    <!-- Content Body -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ════════ TITLE BAR (WPF-UI) ════════ -->
                <ui:TitleBar Grid.Row="0"
                             Title="ZeroMix Hub"
                             Icon="../Assets/Icons/zeromix.ico">
                    <ui:TitleBar.Header>
                        <Button x:Name="HamburgerBtn"
                                Content="&#xE700;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                Width="34" Height="34"
                                Cursor="Hand"
                                Click="HamburgerBtn_Click"
                                ToolTip="Toggle Sidebar"/>
                    </ui:TitleBar.Header>
                    <ui:TitleBar.TrailingContent>
                        <ComboBox x:Name="LanguageComboBox"
                                  Width="110" Height="26"
                                  FontSize="11"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"
                                  Style="{StaticResource ModernComboBox}"
                                  SelectionChanged="LanguageComboBox_SelectionChanged">
                            <ComboBoxItem Content="English"   Tag="en-US"/>
                            <ComboBoxItem Content="Indonesia" Tag="id-ID"/>
                            <ComboBoxItem Content="日本語"     Tag="ja-JP"/>
                            <ComboBoxItem Content="中文"       Tag="zh-CN"/>
                            <ComboBoxItem Content="한국어"     Tag="ko-KR"/>
                        </ComboBox>
                    </ui:TitleBar.TrailingContent>
                </ui:TitleBar>
                <!-- compat elements for code-behind -->
                <Border x:Name="TitleDragArea" Grid.Row="0" Visibility="Collapsed"/>
                <Button x:Name="MaximizeButton" Grid.Row="0" Visibility="Collapsed" Click="MaximizeRestore_Click"/>

                <!-- ════════ BODY ════════ -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Sidebar column set to Auto so it follows the Border's width -->
                        <ColumnDefinition x:Name="SidebarColumn" Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ──────────────── SIDEBAR ──────────────── -->
                    <Border Grid.Column="0"
                            x:Name="SidebarPane"
                            Width="220"
                            Background="#080C16"
                            BorderThickness="0,0,1,0"
                            BorderBrush="#1E2A3A">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Navigation Items -->
                            <StackPanel Grid.Row="0" Margin="0,15,0,0">
                                <Button x:Name="HomeButton" Style="{StaticResource NavButtonStyle}" Click="HomeButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="IconHome" Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="20" Width="30" Margin="0,0,15,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="NavTextHome" Text="Dashboard" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="WallpaperButton" Style="{StaticResource NavButtonStyle}" Click="NavWallpapers_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="IconWall" Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="20" Width="30" Margin="0,0,15,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="NavTextWall" Text="Wallpapers" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PluginsButton" Style="{StaticResource NavButtonStyle}" Click="PluginsButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="IconPlugins" Text="&#xEA86;" FontFamily="Segoe MDL2 Assets" FontSize="20" Width="30" Margin="0,0,15,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="NavTextPlugins" Text="Plugins" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RecorderButton" Style="{StaticResource NavButtonStyle}" Click="RecorderButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="IconRec" Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="20" Width="30" Margin="0,0,15,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="NavTextRec" Text="Capture" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="AssistantButton" Style="{StaticResource NavButtonStyle}" Click="AssistantButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="IconAsst" Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="20" Width="30" Margin="0,0,15,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="NavTextAsst" Text="AI Companions" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Border Height="1" Background="#11FFFFFF" Margin="20,15"/>

                                <Button x:Name="AboutButton" Style="{StaticResource NavButtonStyle}" Click="AboutButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Icon + Update Badge -->
                                        <Grid Width="30" Margin="0,0,15,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="IconAbout" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <!-- Update dot badge -->
                                            <Ellipse x:Name="SidebarUpdateDot"
                                                     Width="8" Height="8"
                                                     Fill="#FF4D4D"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Top"
                                                     Margin="0,0,-2,-2"
                                                     Visibility="Collapsed">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <Trigger Property="Visibility" Value="Visible">
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                             From="1" To="0.3"
                                                                                             Duration="0:0:1"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="NavTextAbout" Text="System Info" VerticalAlignment="Center"/>
                                            <!-- Update text badge (visible saat sidebar expanded) -->
                                            <Border x:Name="SidebarUpdateBadge"
                                                    Background="#FF4D4D"
                                                    CornerRadius="4"
                                                    Padding="5,1"
                                                    Margin="8,0,0,0"
                                                    Visibility="Collapsed"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="UPDATE" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Sidebar Footer -->
                            <StackPanel Grid.Row="1" Margin="15,0,15,15">
                                <TextBlock x:Name="StatusLabel" Text="All Systems Normal" FontSize="9" Foreground="#66FFFFFF" Margin="5,0,0,10" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ──────────────── CONTENT AREA (Glass Card Styles) ──────────────── -->
                    <Grid Grid.Column="1" Margin="25">

                        <!-- ═══ HOME VIEW ═══ -->
                        <ScrollViewer x:Name="HomeContent"
                                      VerticalScrollBarVisibility="Hidden"
                                      BorderThickness="0">
                            <StackPanel>
                                <!-- Welcome Header -->
                                <StackPanel Margin="0,0,0,32">
                                    <TextBlock Text="Welcome back"
                                               FontSize="30"
                                               FontWeight="ExtraBold"
                                               Foreground="{StaticResource TextBrush}"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="Ready to optimize your experience today?"
                                               FontSize="14"
                                               Foreground="{StaticResource SubTextBrush}"/>
                                </StackPanel>

                                <!-- Quick Actions -->
                                <TextBlock Text="QUICK OPERATIONS"
                                           FontSize="11" FontWeight="Bold"
                                           Foreground="#8892A4"
                                           Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,32">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="EnableMonitoringBtn" Grid.Row="0" Grid.Column="0"
                                            Style="{StaticResource QuickActionButton}" Margin="0,0,8,8"
                                            Click="EnableMonitoringBtn_Click">
                                        <StackPanel>
                                            <ui:SymbolIcon Symbol="HeartPulse24" FontSize="28" Foreground="#00BFA5" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock Text="System Health" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="OpenClockBtn" Grid.Row="0" Grid.Column="1"
                                            Style="{StaticResource QuickActionButton}" Margin="4,0,4,8"
                                            Click="OpenClockBtn_Click">
                                        <StackPanel>
                                            <ui:SymbolIcon Symbol="Clock32" FontSize="28" Foreground="#00BFA5" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock Text="Neural Clock" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="TaskbarToggleBtn" Grid.Row="0" Grid.Column="2"
                                            Style="{StaticResource QuickActionButton}" Margin="8,0,0,8"
                                            Click="TaskbarToggleBtn_Click">
                                        <StackPanel>
                                            <ui:SymbolIcon Symbol="AppsListDetail20" FontSize="28" Foreground="#00BFA5" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock Text="Ghost Taskbar" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="HomeRecordBtn" Grid.Row="1" Grid.Column="0"
                                            Style="{StaticResource QuickActionButton}" Margin="0,0,8,0"
                                            Click="ZeroRecordBtn_Click">
                                        <StackPanel>
                                            <ui:SymbolIcon Symbol="Record24" FontSize="28" Foreground="#FF4757" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock x:Name="HomeRecordBtnText" Text="ZeroRecord" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="SleepSettingsBtn" Grid.Row="1" Grid.Column="1"
                                            Style="{StaticResource QuickActionButton}" Margin="4,0,4,0"
                                            Click="SleepSettingsBtn_Click">
                                        <StackPanel>
                                            <ui:SymbolIcon Symbol="Sleep24" FontSize="28" Foreground="#00BFA5" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock Text="Sleep Mode" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Row="1" Grid.Column="2"
                                            Style="{StaticResource QuickActionButton}" Margin="8,0,0,0"
                                            Click="ShowExport_Click">
                                        <StackPanel>
                                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="28" Foreground="#00BFA5" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock Text="56Editor" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Monitoring Panel -->
                                <Border x:Name="MonitoringPanel"
                                        Style="{StaticResource CardBorder}"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,20">
                                            <TextBlock Text="Core Statistics"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextBrush}"/>
                                            <Button x:Name="DisableMonitoringBtn"
                                                    Content="&#xE711;"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    Click="DisableMonitoringBtn_Click"
                                                    Style="{StaticResource ActionButton}"
                                                    FontSize="12"
                                                    HorizontalAlignment="Right"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    Foreground="{StaticResource SubTextBrush}"/>
                                        </Grid>

                                        <!-- Stats Row -->
                                        <Grid Margin="0,0,0,24">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- CPU -->
                                            <Border Grid.Column="0" Background="#111620" CornerRadius="12" Padding="16" Margin="0,0,6,0">
                                                <StackPanel>
                                                    <TextBlock Text="CPU"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,8"/>
                                                    <TextBlock x:Name="CpuPercentText"
                                                               Text="0.0 %"
                                                               FontSize="24"
                                                               FontWeight="Black"
                                                               Foreground="{StaticResource TextBrush}"
                                                               Margin="0,0,0,10"/>
                                                    <ProgressBar x:Name="CpuProgressBar"
                                                                 Height="5"
                                                                 Maximum="100"
                                                                 Foreground="{StaticResource NeonBlueBrush}"
                                                                 Background="#1A2030"
                                                                 BorderThickness="0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- RAM -->
                                            <Border Grid.Column="1" Background="#111620" CornerRadius="12" Padding="16" Margin="3,0">
                                                <StackPanel>
                                                    <TextBlock Text="MEMORY"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,8"/>
                                                    <TextBlock x:Name="RamPercentText"
                                                               Text="0.0 %"
                                                               FontSize="24"
                                                               FontWeight="Black"
                                                               Foreground="{StaticResource TextBrush}"
                                                               Margin="0,0,0,10"/>
                                                    <ProgressBar x:Name="RamProgressBar"
                                                                 Height="5"
                                                                 Maximum="100"
                                                                 Foreground="{StaticResource NeonBlueBrush}"
                                                                 Background="#1A2030"
                                                                 BorderThickness="0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Disk -->
                                            <Border Grid.Column="2" Background="#111620" CornerRadius="12" Padding="16" Margin="6,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="DISK"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,8"/>
                                                    <TextBlock x:Name="DiskPercentText"
                                                               Text="0.0 %"
                                                               FontSize="24"
                                                               FontWeight="Black"
                                                               Foreground="{StaticResource TextBrush}"
                                                               Margin="0,0,0,10"/>
                                                    <ProgressBar x:Name="DiskProgressBar"
                                                                 Height="5"
                                                                 Maximum="100"
                                                                 Foreground="{StaticResource NeonBlueBrush}"
                                                                 Background="#1A2030"
                                                                 BorderThickness="0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- System Info + Maintenance -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="SYSTEM INFO"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="10"
                                                           Margin="0,0,0,10"/>
                                                <Border Background="#111620" CornerRadius="12" Padding="14">
                                                    <StackPanel>
                                                        <TextBlock x:Name="OsVersionText" Text="OS: Loading..." Foreground="{StaticResource TextBrush}" FontSize="12" Margin="0,0,0,6"/>
                                                        <TextBlock x:Name="ProcessorText" Text="CPU: Architecture" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,0,0,6"/>
                                                        <TextBlock x:Name="TotalRamText" Text="RAM: Calculating" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,0,0,6"/>
                                                        <TextBlock x:Name="NetworkText" Text="Net: Scanning" Foreground="{StaticResource SubTextBrush}" FontSize="12"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="MAINTENANCE"
