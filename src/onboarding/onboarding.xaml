<Window x:Class="ZeroMix.Onboarding.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to ZeroMix"
        Height="520" Width="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent">

    <Border CornerRadius="14"
            Background="#0D1117"
            BorderBrush="#21262D"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Slides -->
            <Grid x:Name="SlidesContainer" Grid.Row="0" Margin="48,40,48,0">

                <!-- SLIDE 0: Welcome -->
                <Grid x:Name="Slide0" Visibility="Visible">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/assets/zeromix-high-resolution-logo-transparent.png"
                               Height="80" Margin="0,0,0,24"/>
                        <TextBlock Text="Welcome to ZeroMix"
                                   FontSize="28" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="A modern Windows utility suite for power users."
                                   FontSize="14" Foreground="#8B949E"
                                   Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- SLIDE 1: Core Features -->
                <Grid x:Name="Slide1" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="What's included" FontSize="22" FontWeight="Bold"
                                   Foreground="White" Margin="0,0,0,24"/>
                        <UniformGrid Columns="2" Rows="3">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,16">
                                <TextBlock Text="🎥" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="ZeroRecord" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                                    <TextBlock Text="Hardware-accelerated screen recording" Foreground="#8B949E" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Nexus Translate" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                                    <TextBlock Text="Real-time translation anywhere" Foreground="#8B949E" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,16">
                                <TextBlock Text="🤖" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Virtual Assistant" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                                    <TextBlock Text="Live2D AI companions" Foreground="#8B949E" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="🎨" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Ghost Taskbar" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                                    <TextBlock Text="Transparent taskbar with Mica effect" Foreground="#8B949E" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <TextBlock Text="🔍" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Search Overlay" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                                    <TextBlock Text="Fast launcher with AI support" Foreground="#8B949E" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <TextBlock Text="🐱" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Cat Gatekeeper" FontWeight="SemiBold" Foreground="White" FontSize="13"/>
                                    <TextBlock Text="Screen time enforcer" Foreground="#8B949E" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Grid>

                <!-- SLIDE 2: Keyboard Shortcuts -->
                <Grid x:Name="Slide2" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Keyboard shortcuts" FontSize="22" FontWeight="Bold"
                                   Foreground="White" Margin="0,0,0,24"/>
                        <Border Background="#161B22" CornerRadius="10" Padding="20"
                                BorderBrush="#21262D" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Border Background="#21262D" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                        <TextBlock Text="Ctrl + Q" Foreground="#58A6FF" FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="Toggle main dashboard" Foreground="#C9D1D9" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Border Background="#21262D" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                        <TextBlock Text="Alt + Space" Foreground="#58A6FF" FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="Open Search Overlay" Foreground="#C9D1D9" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Border Background="#21262D" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                        <TextBlock Text="Alt + S" Foreground="#58A6FF" FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="Toggle Sleep Mode" Foreground="#C9D1D9" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <Border Background="#21262D" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                        <TextBlock Text="Ctrl + R" Foreground="#58A6FF" FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="Refresh system metrics" Foreground="#C9D1D9" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- SLIDE 3: What's New -->
                <Grid x:Name="Slide3" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="What's new"
                                   FontSize="22" FontWeight="Bold" Foreground="White"
                                   Margin="0,0,0,16"/>
                        <Border Grid.Row="1" Background="#161B22" CornerRadius="10"
                                BorderBrush="#21262D" BorderThickness="1" Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ReleasesParams">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,16">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Border Background="#1F6FEB22" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding TagName}" Foreground="#58A6FF"
                                                                   FontSize="11" FontWeight="Bold" FontFamily="Consolas"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd MMM yyyy}'}"
                                                               Foreground="#8B949E" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Body}" Foreground="#C9D1D9"
                                                           FontSize="11" TextWrapping="Wrap"/>
                                                <Border Height="1" Background="#21262D" Margin="0,12,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- SLIDE 4: Ready -->
                <Grid x:Name="Slide4" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="✅" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="You're all set"
                                   FontSize="28" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="ZeroMix is running in your system tray. Press Ctrl+Q to open the dashboard anytime."
                                   FontSize="13" Foreground="#8B949E" TextWrapping="Wrap"
                                   MaxWidth="400" TextAlignment="Center"
                                   Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

            </Grid>

            <!-- Bottom Navigation -->
            <Border Grid.Row="1" BorderBrush="#21262D" BorderThickness="0,1,0,0" Padding="48,16">
                <Grid>
                    <!-- Step indicator dots -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Ellipse x:Name="Dot0" Width="6" Height="6" Fill="#58A6FF" Margin="0,0,6,0"/>
                        <Ellipse x:Name="Dot1" Width="6" Height="6" Fill="#30363D" Margin="0,0,6,0"/>
                        <Ellipse x:Name="Dot2" Width="6" Height="6" Fill="#30363D" Margin="0,0,6,0"/>
                        <Ellipse x:Name="Dot3" Width="6" Height="6" Fill="#30363D" Margin="0,0,6,0"/>
                        <Ellipse x:Name="Dot4" Width="6" Height="6" Fill="#30363D"/>
                    </StackPanel>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnBack" Content="Back"
                                Click="BtnBack_Click"
                                Visibility="Collapsed"
                                Margin="0,0,8,0"
                                Padding="20,8"
                                Background="#21262D" Foreground="#C9D1D9"
                                BorderBrush="#30363D" BorderThickness="1"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#30363D"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BtnNext" Content="Continue"
                                Click="BtnNext_Click"
                                Padding="24,8"
                                Background="#238636" Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#2EA043"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
