<Window x:Class="ZeroMix.ZeroShell.ZeroShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zero Terminal" 
        Height="700" Width="1200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        MouseDown="Window_MouseDown"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" 
                      ResizeBorderThickness="8" 
                      CornerRadius="0" 
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Border x:Name="MainBorder">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="20"/>
                    <Setter Property="Margin" Value="20"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                            <Setter Property="CornerRadius" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F5101820" Offset="0"/>
                    <GradientStop Color="#F5080E14" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="Black" Opacity="0.6" ShadowDepth="0"/>
            </Border.Effect>

            <Grid x:Name="RootLayout">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition x:Name="StatusBarRow" Height="42"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="MainContentRow" Height="*"/>
                    <RowDefinition Height="48"/>
                </Grid.RowDefinitions>

                <!-- TITLE BAR (Modern Pill Style) -->
                <Grid Grid.Row="0" Margin="10,8,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#18FFFFFF" CornerRadius="12" Padding="10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="30">
                            <Ellipse Width="10" Height="10" Fill="#FFFF5F56" Margin="0,0,8,0" MouseLeftButtonDown="CloseButton_Click" Cursor="Hand"/>
                            <Ellipse Width="10" Height="10" Fill="#FFFFBD2E" Margin="0,0,8,0" MouseLeftButtonDown="MinimizeButton_Click" Cursor="Hand"/>
                            <Ellipse Width="10" Height="10" Fill="#FF27C93F" Margin="0,0,15,0" MouseLeftButtonDown="MaximizeButton_Click" Cursor="Hand"/>
                            <StackPanel x:Name="TabBar" Orientation="Horizontal"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="1" HorizontalAlignment="Center" Background="#18FFFFFF" CornerRadius="12" Padding="15,0">
                         <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="28">
                             <TextBlock x:Name="CurrentTimeText" Text="13:28" Foreground="#CCFFFFFF" FontSize="11" VerticalAlignment="Center"/>
                             <TextBlock Text=" ◓ 29°C " Foreground="#CC6BDDFF" FontSize="10" VerticalAlignment="Center" Margin="10,0,0,0"/>
                         </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#18FFFFFF" CornerRadius="12" Padding="12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="30">
                            <TextBlock Text=" BAT 34% " Foreground="#FFCC6BFF" FontSize="10" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text=" RAM 71% " Foreground="#FFFF9F43" FontSize="10" VerticalAlignment="Center" Margin="5,0" FontWeight="Bold"/>
                            <TextBlock x:Name="StatusPathText" Text=" ~ " Foreground="#88FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="10,0"/>
                            <TextBlock Text="  " Foreground="#FF27C93F" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            
                            <!-- THE GEAR ICON (Settings Toggle) -->
                            <TextBlock x:Name="GearBtn" Text=" &#xE713; " FontFamily="Segoe MDL2 Assets" Foreground="White" 
                                       FontSize="14" VerticalAlignment="Center" Cursor="Hand"
                                       MouseLeftButtonDown="GearBtn_Click">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#00D4FF"/>
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- SPARE ROW ( statusBarRow ) -->
                <Grid Grid.Row="1"/>

                <!-- MAIN CONTENT AREA (TILED LAYOUT) -->
                <Grid Grid.Row="3" Margin="20,10" x:Name="MainContentArea">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="RightColumn" Width="0"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT TILES (Terminal + Clock) -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition x:Name="ClockRow" Height="0"/>
                        </Grid.RowDefinitions>

                        <!-- TERMINAL AREA -->
                        <Border x:Name="TermBorder" Background="#15FFFFFF" CornerRadius="12" Margin="0,0,0,5" BorderBrush="#20FFFFFF" BorderThickness="1">
                             <Grid x:Name="TerminalsContainer" Margin="12"/>
                        </Border>

                        <!-- CLOCK AREA (Hidden by default) -->
                        <Border x:Name="ClockArea" Grid.Row="1" Visibility="Collapsed" 
                                Background="#10FFFFFF" CornerRadius="12" Margin="0,5,0,0" BorderBrush="#3000D4FF" BorderThickness="1">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="BigClockText" Text="13:28" Foreground="#FF27C93F" FontSize="80" 
                                               FontFamily="JetBrains Mono" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="BigDateText" Text="2026-03-02" Foreground="#88FFFFFF" FontSize="14" 
                                               HorizontalAlignment="Center" Margin="0,-10,0,0"/>
                                 </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    
                    <!-- RIGHT AREA (ASCII art, toggleable) -->
                    <Border Grid.Column="1" x:Name="RightArea" Visibility="Collapsed" 
                            Background="#10FFFFFF" CornerRadius="12" Margin="10,0,0,0" BorderBrush="#20FFFFFF" BorderThickness="1">
                         <Grid x:Name="RightContentArea"/>
                    </Border>

                    <!-- SETTINGS OVERLAY (Black GlassDark) -->
                    <Border x:Name="SettingsOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" 
                            Background="#F5080E14" CornerRadius="16" Margin="150,40"
                            BorderBrush="#44FFFFFF" BorderThickness="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.9" ShadowDepth="0"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="60"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="60"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="TERMINAL CUSTOMIZER" Foreground="#00D4FF" FontWeight="Bold" FontSize="18" 
                                       Margin="30,0" VerticalAlignment="Center" Padding="2"/>
                            
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="30,10">
                                <TextBlock Text="Appearance" Foreground="#88FFFFFF" FontSize="12" Margin="0,10,0,15" FontWeight="Bold"/>
                                
                                <!-- Font Family -->
                                <Grid Margin="0,5">
                                    <TextBlock Text="Font Family" Foreground="#88FFFFFF" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="FontCombo" HorizontalAlignment="Right" Width="200" 
                                              Background="#11FFFFFF" BorderThickness="1" BorderBrush="#33FFFFFF">
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="Background" Value="#1A1A1A"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Padding" Value="10,5"/>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                </Grid>

                                <!-- Font Size -->
                                <Grid Margin="0,15">
                                    <TextBlock Text="Font Size" Foreground="#EEEEEE" VerticalAlignment="Center"/>
                                    <Slider x:Name="FontSizeSlider" HorizontalAlignment="Right" Width="200" Minimum="10" Maximum="30" Value="14"/>
                                </Grid>

                                <!-- Background Opacity -->
                                <Grid Margin="0,5">
                                    <TextBlock Text="Background Opacity" Foreground="#EEEEEE" VerticalAlignment="Center"/>
                                    <Slider x:Name="OpacitySlider" HorizontalAlignment="Right" Width="200" Minimum="0.1" Maximum="1.0" Value="0.95"/>
                                </Grid>

                                <Border Height="1" Background="#11FFFFFF" Margin="0,20"/>
                                
                                <TextBlock Text="Cursor Style" Foreground="#88FFFFFF" FontSize="12" Margin="0,0,0,15" FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="CurBlock" Content="Block" Foreground="White" IsChecked="True" Margin="0,0,20,0"/>
                                    <RadioButton x:Name="CurLine" Content="Line" Foreground="White" Margin="0,0,20,0"/>
                                    <RadioButton x:Name="CurUnder" Content="Underline" Foreground="White"/>
                                </StackPanel>

                                <Border Height="1" Background="#11FFFFFF" Margin="0,20"/>

                                <TextBlock Text="Terminal Wallpaper (Premium)" Foreground="#00D4FF" FontSize="12" Margin="0,0,0,10" FontWeight="Bold"/>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="WallpaperPathText" Text="No Image Selected" Foreground="#88FFFFFF" 
                                               FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,10,0" IsHitTestVisible="False"/>
                                    <Button Grid.Column="1" Content="BROWSE" Click="BrowseWallpaper_Click" Padding="15,5" 
                                            Background="#22FFFFFF" Foreground="White" BorderThickness="1" BorderBrush="#33FFFFFF">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>

                                <Border Height="1" Background="#11FFFFFF" Margin="0,20"/>

                            </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="2" Background="#08FFFFFF" CornerRadius="0,0,16,16">
                                <Button Content="SAVE &amp; APPLY" Width="140" Height="32" Background="#00D4FF" Foreground="Black" 
                                        FontWeight="Bold" BorderThickness="0" Click="SaveSettings_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="16"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Border>

                            <!-- Close Cross -->
                            <TextBlock Text="✕" Foreground="#44FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" 
                                       Margin="20" Cursor="Hand" MouseLeftButtonDown="GearBtn_Click"/>
                        </Grid>
                    </Border>

                    <!-- SELECTION OVERLAY (FLOATING CENTER) -->
                    <Border x:Name="SelectionOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" 
                            Background="#F0101820" CornerRadius="16" Margin="60,20" Padding="50,30"
                            BorderBrush="#FF6BDDFF" BorderThickness="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.8" ShadowDepth="0"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock x:Name="SelectionTitle" Text="SETTING" Foreground="#FFFFDA6B" FontWeight="Bold" FontSize="20" Margin="0,0,0,25" HorizontalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="10" Color="#FFFFDA6B" Opacity="0.3" ShadowDepth="0"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock x:Name="SelectionItems" Text="Loading..." Foreground="#EEEEEE" FontFamily="Consolas" FontSize="16" LineHeight="32" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Text="[ ↑ ↓ Pilih  |  Enter OK  |  Esc Batal ]" Foreground="#55FFFFFF" FontSize="12" Margin="0,25,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- INPUT AREA (Transparent) -->
                <Border Grid.Row="4" x:Name="InputBorder" Background="#08FFFFFF" CornerRadius="0,0,24,24" BorderBrush="#15FFFFFF" BorderThickness="0,1,0,0">
                    <Grid Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Segmented Linux Style Prompt (Powerline) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                             <!-- USER SEGMENT -->
                             <Border Background="#00D4FF" CornerRadius="4,0,0,4" Padding="10,4">
                                  <StackPanel Orientation="Horizontal">
                                      <TextBlock Text="&#xE77B; " FontFamily="Segoe MDL2 Assets" Foreground="Black" FontSize="10" VerticalAlignment="Center"/>
                                      <TextBlock x:Name="PromptUserText" Text=" Sayang " Foreground="Black" FontSize="11" FontWeight="ExtraBold"/>
                                  </StackPanel>
                             </Border>
                             <!-- CHEVRON -->
                             <TextBlock Text="&#xE974;" FontFamily="Segoe MDL2 Assets" Foreground="#00D4FF" FontSize="18" VerticalAlignment="Center" Margin="-1,0"/>
                             
                             <!-- PATH SEGMENT -->
                             <Border Background="#25FFFFFF" CornerRadius="0,4,4,0" Padding="12,4">
                                  <StackPanel Orientation="Horizontal">
                                      <TextBlock Text="&#xED25; " FontFamily="Segoe MDL2 Assets" Foreground="#00D4FF" FontSize="10" VerticalAlignment="Center"/>
                                      <TextBlock x:Name="PromptText" Text=" ~/Documents " Foreground="#00D4FF" FontSize="11" FontWeight="Bold"/>
                                  </StackPanel>
                             </Border>
                             <!-- END ARROW -->
                             <TextBlock Text=" ❯ " Foreground="#00D4FF" VerticalAlignment="Center" Margin="5,0" FontWeight="ExtraBold"/>
                        </StackPanel>
                        
                        <TextBox Grid.Column="1" x:Name="TerminalInput" 
                                 Background="Transparent" BorderThickness="0" 
                                 Foreground="#EEEEEE" FontSize="14" FontFamily="JetBrains Mono" FontWeight="Bold"
                                 VerticalContentAlignment="Center" CaretBrush="#00D4FF"
                                 PreviewKeyDown="TerminalInput_PreviewKeyDown"
                                 KeyDown="TerminalInput_KeyDown"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
