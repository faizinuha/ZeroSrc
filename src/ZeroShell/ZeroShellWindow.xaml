<ui:FluentWindow x:Class="ZeroMix.ZeroShell.ZeroShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="ZeroShell" Height="700" Width="1200"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Acrylic"
        WindowCornerPreference="Round"
        Background="#0D1117"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged">

    <Border x:Name="MainBorder" Background="#0D1117" CornerRadius="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>   <!-- Title bar -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="48"/>   <!-- Input -->
        </Grid.RowDefinitions>

        <!-- ── TITLE BAR ── -->
        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- macOS-style traffic lights + tabs -->
            <Border Grid.Column="0" Background="#18FFFFFF" CornerRadius="10" Margin="10,6,0,6" Padding="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#FF5F56" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="CloseButton_Click"/>
                    <Ellipse Width="10" Height="10" Fill="#FFBD2E" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="MinimizeButton_Click"/>
                    <Ellipse Width="10" Height="10" Fill="#27C93F" Margin="0,0,12,0" Cursor="Hand" MouseLeftButtonDown="MaximizeButton_Click"/>
                    <StackPanel x:Name="TabBar" Orientation="Horizontal"/>
                </StackPanel>
            </Border>

            <!-- Clock + stats pill -->
            <Border Grid.Column="1" HorizontalAlignment="Center" Background="#18FFFFFF" CornerRadius="10" Margin="8,6" Padding="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentTimeText" Text="00:00" Foreground="#CCE0E0E0" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusPathText" Text=" ~ " Foreground="#8800D4FF" FontSize="10" VerticalAlignment="Center" Margin="10,0"/>
                </StackPanel>
            </Border>

            <!-- Gear -->
            <Border Grid.Column="2" Background="#18FFFFFF" CornerRadius="10" Margin="0,6,10,6" Padding="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon x:Name="GearBtn" Symbol="Settings32" Foreground="#88E0E0E0"
                                   FontSize="14" VerticalAlignment="Center" Cursor="Hand"
                                   MouseLeftButtonDown="GearBtn_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── MAIN CONTENT ── -->
        <Grid Grid.Row="1" x:Name="MainContentArea" Margin="12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition x:Name="ClockRow" Height="0"/>
                </Grid.RowDefinitions>

                <!-- Terminal -->
                <ui:Card x:Name="TermBorder" Grid.Row="0" Margin="0,0,0,4" Padding="0">
                    <Grid x:Name="TerminalsContainer" Margin="10"/>
                </ui:Card>

                <!-- Clock (hidden by default) -->
                <ui:Card x:Name="ClockArea" Grid.Row="1" Visibility="Collapsed" Margin="0,4,0,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="BigClockText" Text="00:00" Foreground="#27C93F"
                                   FontSize="80" FontFamily="JetBrains Mono, Consolas"
                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="BigDateText" Text="2026-01-01" Foreground="#88E0E0E0"
                                   FontSize="14" HorizontalAlignment="Center" Margin="0,-10,0,0"/>
                    </StackPanel>
                </ui:Card>
            </Grid>

            <!-- Right panel (ASCII art, toggleable) -->
            <ui:Card Grid.Column="1" x:Name="RightArea" Visibility="Collapsed" Margin="8,0,0,0" Padding="0">
                <Grid x:Name="RightContentArea"/>
            </ui:Card>

            <!-- Settings overlay -->
            <Border x:Name="SettingsOverlay" Grid.ColumnSpan="2" Visibility="Collapsed"
                    Background="#F0101820" CornerRadius="14" Margin="120,30"
                    BorderBrush="#44E0E0E0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="56"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1">
                        <TextBlock Text="TERMINAL SETTINGS" Foreground="#00D4FF" FontWeight="Bold"
                                   FontSize="15" Margin="24,0" VerticalAlignment="Center"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,12">
                        <StackPanel>
                            <TextBlock Text="Font Family" Foreground="#88E0E0E0" FontSize="11" Margin="0,0,0,6"/>
                            <ComboBox x:Name="FontCombo" Margin="0,0,0,14"/>

                            <TextBlock Text="Font Size" Foreground="#88E0E0E0" FontSize="11" Margin="0,0,0,6"/>
                            <Slider x:Name="FontSizeSlider" Minimum="10" Maximum="30" Value="14"
                                    Foreground="#00D4FF" Margin="0,0,0,14"/>

                            <TextBlock Text="Background Opacity" Foreground="#88E0E0E0" FontSize="11" Margin="0,0,0,6"/>
                            <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1.0" Value="0.95"
                                    Foreground="#00D4FF" Margin="0,0,0,14"/>

                            <Separator Background="#22FFFFFF" Margin="0,8,0,14"/>

                            <TextBlock Text="Cursor Style" Foreground="#88E0E0E0" FontSize="11" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="CurBlock"  Content="Block"     Foreground="#E0E0E0" IsChecked="True" Margin="0,0,16,0"/>
                                <RadioButton x:Name="CurLine"   Content="Line"      Foreground="#E0E0E0" Margin="0,0,16,0"/>
                                <RadioButton x:Name="CurUnder"  Content="Underline" Foreground="#E0E0E0"/>
                            </StackPanel>

                            <Separator Background="#22FFFFFF" Margin="0,14,0,14"/>

                            <TextBlock Text="Terminal Wallpaper" Foreground="#00D4FF" FontSize="11" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="WallpaperPathText" Text="No image selected"
                                           Foreground="#88E0E0E0" FontSize="11" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                <ui:Button Grid.Column="1" Content="Browse" Appearance="Secondary"
                                           Click="BrowseWallpaper_Click"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0" VerticalAlignment="Center">
                            <ui:Button Content="Cancel" Appearance="Secondary" Margin="0,0,8,0" Click="GearBtn_Click"/>
                            <ui:Button Content="Save &amp; Apply" Appearance="Primary" Click="SaveSettings_Click"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="✕" Foreground="#44E0E0E0" HorizontalAlignment="Right" VerticalAlignment="Top"
                               Margin="16" Cursor="Hand" MouseLeftButtonDown="GearBtn_Click"/>
                </Grid>
            </Border>

            <!-- Selection overlay -->
            <Border x:Name="SelectionOverlay" Grid.ColumnSpan="2" Visibility="Collapsed"
                    Background="#F0101820" CornerRadius="14" Margin="60,20" Padding="40,24"
                    BorderBrush="#FF6BDDFF" BorderThickness="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="SelectionTitle" Text="SELECT" Foreground="#FFFFDA6B"
                               FontWeight="Bold" FontSize="18" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SelectionItems" Text="Loading..." Foreground="#E0E0E0"
                               FontFamily="Consolas" FontSize="15" LineHeight="30"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="[ ↑↓ Navigate  |  Enter OK  |  Esc Cancel ]"
                               Foreground="#55E0E0E0" FontSize="11" Margin="0,20,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── INPUT BAR ── -->
        <Border Grid.Row="2" x:Name="InputBorder"
                Background="#0AFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Powerline prompt -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#00D4FF" CornerRadius="4,0,0,4" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Person32" Foreground="Black" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="PromptUserText" Text="user" Foreground="Black" FontSize="11" FontWeight="ExtraBold"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="❯" Foreground="#00D4FF" FontSize="14" VerticalAlignment="Center" Margin="4,0"/>
                    <Border Background="#20FFFFFF" CornerRadius="0,4,4,0" Padding="10,4">
                        <TextBlock x:Name="PromptText" Text="~" Foreground="#00D4FF" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text=" ❯ " Foreground="#00D4FF" VerticalAlignment="Center" Margin="4,0" FontWeight="ExtraBold"/>
                </StackPanel>

                <TextBox Grid.Column="1" x:Name="TerminalInput"
                         Background="Transparent" BorderThickness="0"
                         Foreground="#E0E0E0" FontSize="14"
                         FontFamily="JetBrains Mono, Consolas" FontWeight="Bold"
                         VerticalContentAlignment="Center" CaretBrush="#00D4FF"
                         PreviewKeyDown="TerminalInput_PreviewKeyDown"
                         KeyDown="TerminalInput_KeyDown"/>
            </Grid>
        </Border>

        <!-- Unused named elements kept for code-behind compatibility -->
        <Grid Visibility="Collapsed">
            <Grid x:Name="RootLayout"/>
            <TextBlock x:Name="StatusBarRow" Visibility="Collapsed"/>
            <TextBlock x:Name="MainContentRow" Visibility="Collapsed"/>
        </Grid>

    </Grid>
    </Border>
</ui:FluentWindow>
