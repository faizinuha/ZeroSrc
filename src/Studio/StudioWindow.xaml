<ui:FluentWindow x:Class="ZeroMix.Studio.StudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="ZeroMix Studio" 
        Height="720" 
        Width="1280"
        MinHeight="600" 
        MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowCornerPreference="Round"
        Background="#000000">

    <Window.Resources>
        <ResourceDictionary>
            <!-- Pure Black Theme -->
            <SolidColorBrush x:Key="BgPureBlack" Color="#000000"/>
            <SolidColorBrush x:Key="BgDark" Color="#0A0A0A"/>
            <SolidColorBrush x:Key="BgPanel" Color="#141414"/>
            <SolidColorBrush x:Key="AccentCyan" Color="#00FFA3"/>
            <SolidColorBrush x:Key="AccentYellow" Color="#FFD700"/>
            <SolidColorBrush x:Key="BorderDark" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="TextWhite" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextGray" Color="#999999"/>
            
            <!-- Icon Button Style -->
            <Style x:Key="IconBtn" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextGray}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="Width" Value="50"/>
                <Setter Property="Height" Value="50"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1A1A1A"/>
                        <Setter Property="Foreground" Value="{StaticResource AccentCyan}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Primary Button Style -->
            <Style x:Key="PrimaryBtn" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentYellow}"/>
                <Setter Property="Foreground" Value="#000000"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="20,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FFC700"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="#333333"/>
                        <Setter Property="Foreground" Value="#666666"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Context Menu for Timeline Items -->
            <ContextMenu x:Key="TimelineItemMenu">
                <MenuItem Header="Duplicate Clip" Click="Copy_Click"/>
                <Separator/>
                <MenuItem Header="Remove from Timeline" Click="RemoveFromIcons_Click" Foreground="#FF5555"/>
            </ContextMenu>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BgPureBlack}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>      <!-- Icon Sidebar -->
            <ColumnDefinition Width="*"/>       <!-- Main Content -->
        </Grid.ColumnDefinitions>

        <!-- LEFT ICON SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0">
            <StackPanel>
                <Button x:Name="FileBtn" Content="📁" Style="{StaticResource IconBtn}" Click="ShowFile_Click" ToolTip="File"/>
                <Button x:Name="MediaBtn" Content="🎬" Style="{StaticResource IconBtn}" Click="ShowMedia_Click" ToolTip="Media Library"/>
                <Button x:Name="EditBtn" Content="✂️" Style="{StaticResource IconBtn}" Click="ShowEdit_Click" ToolTip="Edit Tools"/>
                <Button x:Name="EffectsBtn" Content="🎨" Style="{StaticResource IconBtn}" Click="ShowEffects_Click" ToolTip="Effects and Filters"/>
                <Button x:Name="MusicBtn" Content="🎵" Style="{StaticResource IconBtn}" Click="ShowMusic_Click" ToolTip="Music and Audio"/>
                <Button x:Name="CaptionBtn" Content="📝" Style="{StaticResource IconBtn}" Click="ShowCaption_Click" ToolTip="Auto Captions"/>
                <Button x:Name="ExportBtn" Content="📤" Style="{StaticResource IconBtn}" Click="ShowExport_Click" ToolTip="Export Settings"/>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>     <!-- Preview + Side Panel -->
                <RowDefinition Height="5"/>     <!-- Splitter -->
                <RowDefinition Height="200"/>   <!-- Timeline -->
            </Grid.RowDefinitions>

            <!-- PREVIEW + SIDE PANEL -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>       <!-- Preview -->
                    <ColumnDefinition Width="Auto"/>    <!-- Side Panel (collapsible) -->
                </Grid.ColumnDefinitions>

                <!-- PREVIEW AREA -->
                <Border Grid.Column="0" Background="{StaticResource BgPureBlack}" Margin="20">
                    <Grid>
                        <!-- Video Preview with Border -->
                        <Border BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="0" ClipToBounds="True">
                            <Grid x:Name="PreviewContainer">
                                <MediaElement x:Name="VideoPreview" LoadedBehavior="Manual" ScrubbingEnabled="True" Volume="0.5" 
                                            MediaOpened="OnMediaOpened" MediaEnded="VideoPreview_MediaEnded" Stretch="Uniform"/>
                                <MediaElement x:Name="MusicPreview" LoadedBehavior="Manual" Volume="0.5" Visibility="Collapsed"/>
                                <MediaElement x:Name="PixabayPreviewInternal" LoadedBehavior="Manual" Volume="0.5" Visibility="Collapsed"/>
                                
                                <!-- Caption Overlay -->
                                <TextBlock x:Name="CaptionOverlay" 
                                          Text="" 
                                          Foreground="White" 
                                          FontSize="24" 
                                          FontWeight="Bold"
                                          TextAlignment="Center"
                                          TextWrapping="Wrap"
                                          VerticalAlignment="Bottom"
                                          HorizontalAlignment="Center"
                                          Margin="40,0,40,50"
                                          MaxWidth="800">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.8"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- Floating Controls Overlay -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15">
                            <Button x:Name="FullscreenBtn" Content="⛶" Style="{StaticResource IconBtn}" Width="40" Height="40" 
                                    Click="Fullscreen_Click" ToolTip="Fullscreen (F11)" Opacity="0.7"/>
                        </StackPanel>
                        
                        <!-- Timeline Scrubber (Playhead) -->
                        <Grid VerticalAlignment="Bottom" Margin="10,0,10,10">
                            <Border Background="#33000000" Height="40" CornerRadius="6">
                                <Grid Margin="10,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Time Display -->
                                    <TextBlock x:Name="ScrubberTimeText" Text="00:00 / 00:00" 
                                              Foreground="White" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    
                                    <!-- Scrubber Slider -->
                                    <Slider x:Name="TimelineScrubber" Grid.Row="1" 
                                           Minimum="0" Maximum="100" Value="0"
                                           VerticalAlignment="Center"
                                           ValueChanged="TimelineScrubber_ValueChanged"
                                           PreviewMouseDown="TimelineScrubber_MouseDown"
                                           PreviewMouseUp="TimelineScrubber_MouseUp"
                                           Foreground="{StaticResource AccentCyan}"
                                           Background="#333333"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- SIDE PANEL (Collapsible) -->
                <Border x:Name="SidePanel" Grid.Column="1" Width="300" Background="{StaticResource BgPanel}" 
                        BorderBrush="{StaticResource BorderDark}" BorderThickness="1,0,0,0" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15">
                            <!-- File Panel -->
                            <Grid x:Name="PanelFile" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="IMPORT" FontSize="10" FontWeight="Black" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,15"/>
                                    <Button Content="📁 IMPORT VIDEO" Style="{StaticResource PrimaryBtn}" Height="40" Click="ImportVideo_Click" Margin="0,0,0,10"/>
                                    <Button Content="🎵 IMPORT AUDIO" Style="{StaticResource PrimaryBtn}" Height="40" Click="SelectMusic_Click"/>
                                    
                                    <TextBlock Text="TIPS" FontSize="8" Foreground="{StaticResource TextGray}" Margin="0,20,0,5"/>
                                    <TextBlock Text="• Video langsung masuk timeline" FontSize="8" Foreground="{StaticResource TextGray}" Margin="0,0,0,3" TextWrapping="Wrap"/>
                                    <TextBlock Text="• Drag timeline untuk cut video" FontSize="8" Foreground="{StaticResource TextGray}" Margin="0,0,0,3" TextWrapping="Wrap"/>
                                    <TextBlock Text="• Klik video card untuk edit" FontSize="8" Foreground="{StaticResource TextGray}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <!-- Media Library Panel - REMOVED, langsung ke timeline -->
                            <Grid x:Name="PanelMedia" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="TIMELINE CLIPS" FontSize="10" FontWeight="Black" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,15"/>
                                    <TextBlock Text="Semua video yang di-import akan langsung muncul di timeline di bawah." 
                                              FontSize="9" Foreground="{StaticResource TextGray}" TextWrapping="Wrap" Margin="0,0,0,15"/>
                                    <TextBlock Text="Klik video card di timeline untuk:" FontSize="9" Foreground="White" Margin="0,0,0,10"/>
                                    <TextBlock Text="• Edit fade effects" FontSize="8" Foreground="{StaticResource TextGray}" Margin="10,0,0,3"/>
                                    <TextBlock Text="• Apply filters" FontSize="8" Foreground="{StaticResource TextGray}" Margin="10,0,0,3"/>
                                    <TextBlock Text="• Cut/trim video" FontSize="8" Foreground="{StaticResource TextGray}" Margin="10,0,0,3"/>
                                    <TextBlock Text="• Duplicate/remove" FontSize="8" Foreground="{StaticResource TextGray}" Margin="10,0,0,3"/>
                                </StackPanel>
                            </Grid>

                            <!-- Edit Tools Panel -->
                            <Grid x:Name="PanelEdit" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="EDIT TOOLS" FontSize="10" FontWeight="Black" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,15"/>
                                    <TextBlock Text="FADE EFFECTS" FontSize="8" Foreground="{StaticResource TextGray}" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="FadeInCheck" Content="Fade In (1s)" Foreground="White" Margin="0,0,0,8" Click="ClipSetting_Changed"/>
                                    <CheckBox x:Name="FadeOutCheck" Content="Fade Out (1s)" Foreground="White" Click="ClipSetting_Changed"/>
                                </StackPanel>
                            </Grid>

                            <!-- Effects Panel -->
                            <Grid x:Name="PanelEffects" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="VISUAL FILTERS" FontSize="10" FontWeight="Black" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Applied at export via FFmpeg. Preview shows active filter." 
                                               FontSize="8" Foreground="{StaticResource TextGray}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                    <ListBox x:Name="FilterList" Background="Transparent" BorderThickness="0" SelectionChanged="FilterList_SelectionChanged">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="filterBorder" Background="{StaticResource BgDark}" CornerRadius="6" 
                                                        Margin="0,0,0,8" Padding="10,8" Cursor="Hand"
                                                        BorderBrush="Transparent" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="White"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="9" 
                                                                   Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Content="✕ Clear Filter" FontSize="9" Padding="8,4" Margin="0,4,0,0"
                                            Background="{StaticResource BgDark}" Foreground="{StaticResource TextGray}" 
                                            BorderThickness="0" Cursor="Hand" Click="ClearFilter_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Music Panel (Pixabay) -->
                            <Grid x:Name="PanelMusic" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="PIXABAY MEDIA" FontSize="10" FontWeight="Black" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,10"/>
                                    
                                    <!-- Mode Toggle: Video / Music -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="🎬 Video" FontSize="9" Height="26"
                                                Background="#1A58A6FF" Foreground="#58A6FF" BorderBrush="#58A6FF" BorderThickness="1"
                                                Cursor="Hand" Click="PixabayModeVideo_Click" Margin="0,0,4,0">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                        <Button Grid.Column="1" Content="🎵 Music" FontSize="9" Height="26"
                                                Background="{StaticResource BgDark}" Foreground="{StaticResource TextGray}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1"
                                                Cursor="Hand" Click="PixabayModeMusic_Click" Margin="4,0,0,0">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                        </Button>
                                    </Grid>
                                    
                                    <Grid Margin="0,0,0,10">
                                        <TextBox x:Name="PixabaySearchBox" Height="32" Padding="10,0" VerticalContentAlignment="Center" 
                                                Background="{StaticResource BgDark}" Foreground="White" BorderBrush="{StaticResource BorderDark}" 
                                                KeyDown="PixabaySearchBox_KeyDown"/>
                                        <Button Content="🔍" HorizontalAlignment="Right" Width="32" Height="32" Background="Transparent" 
                                                BorderThickness="0" Click="PixabaySearch_Click" Foreground="{StaticResource TextGray}"/>
                                    </Grid>
                                    <WrapPanel Margin="0,0,0,10">
                                        <Button Content="Lo-fi" FontSize="8" Padding="8,4" Margin="0,0,5,5" Click="PixabayCategory_Click" Tag="lofi chill" 
                                                Background="{StaticResource BgDark}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                        <Button Content="Happy" FontSize="8" Padding="8,4" Margin="0,0,5,5" Click="PixabayCategory_Click" Tag="happy" 
                                                Background="{StaticResource BgDark}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                        <Button Content="Jazz" FontSize="8" Padding="8,4" Margin="0,0,5,5" Click="PixabayCategory_Click" Tag="jazz" 
                                                Background="{StaticResource BgDark}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                        <Button Content="Cinematic" FontSize="8" Padding="8,4" Margin="0,0,5,5" Click="PixabayCategory_Click" Tag="cinematic" 
                                                Background="{StaticResource BgDark}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                        <Button Content="Nature" FontSize="8" Padding="8,4" Margin="0,0,5,5" Click="PixabayCategory_Click" Tag="nature" 
                                                Background="{StaticResource BgDark}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                                    </WrapPanel>
                                    <ListBox x:Name="PixabayResultsList" Background="Transparent" BorderThickness="0" MaxHeight="300">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BgDark}" CornerRadius="6" Margin="0,0,0,8" Padding="8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button Content="▶" Width="24" Height="24" Background="Transparent" BorderThickness="0" 
                                                                Click="PixabayPreview_Click" Tag="{Binding}" Foreground="{StaticResource AccentCyan}"/>
                                                        <StackPanel Grid.Column="1" Margin="8,0">
                                                            <TextBlock Text="{Binding Title}" FontSize="9" Foreground="White" 
                                                                      TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding DurationStr}" FontSize="8" Foreground="{StaticResource TextGray}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding User}" FontSize="8" 
                                                                   Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Content="ADD TO TRACK" Style="{StaticResource PrimaryBtn}" Margin="0,10,0,0" Click="PixabayAdd_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Caption Panel -->
                            <Grid x:Name="PanelCaption" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="AUTO CAPTIONS" FontSize="10" FontWeight="Black" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,15"/>
                                    
                                    <TextBlock Text="CAPTION STYLE" FontSize="8" Foreground="{StaticResource TextGray}" Margin="0,0,0,10"/>
                                    <ComboBox x:Name="CaptionStyleCombo" Height="32" Margin="0,0,0,15" SelectionChanged="CaptionStyle_Changed">
                                        <ComboBoxItem Content="Bottom Classic" IsSelected="True"/>
                                        <ComboBoxItem Content="Center Modern"/>
                                        <ComboBoxItem Content="Minimal"/>
                                        <ComboBoxItem Content="Bold"/>
                                    </ComboBox>
                                    
                                    <TextBlock Text="LANGUAGE" FontSize="8" Foreground="{StaticResource TextGray}" Margin="0,0,0,10"/>
                                    <ComboBox x:Name="CaptionLangCombo" Height="32" Margin="0,0,0,20">
                                        <ComboBoxItem Content="English" Tag="en" IsSelected="True"/>
                                        <ComboBoxItem Content="Indonesian" Tag="id"/>
                                        <ComboBoxItem Content="Japanese" Tag="ja"/>
                                        <ComboBoxItem Content="Korean" Tag="ko"/>
                                        <ComboBoxItem Content="Chinese" Tag="zh"/>
                                    </ComboBox>
                                    
                                    <Button x:Name="GenerateCaptionsBtn" Content="🎬 GENERATE CAPTIONS" Style="{StaticResource PrimaryBtn}" 
                                            Height="35" Click="GenerateCaptions_Click"/>
                                    
                                    <TextBlock x:Name="CaptionStatusText" Text="" FontSize="8" Foreground="{StaticResource AccentCyan}" 
                                              Margin="0,10,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <!-- Export Panel -->
                            <Grid x:Name="PanelExport" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="EXPORT SETTINGS" FontSize="10" FontWeight="Black" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,15"/>
                                    <TextBlock Text="RESOLUTION" FontSize="8" Foreground="{StaticResource TextGray}" Margin="0,0,0,10"/>
                                    <ComboBox x:Name="ResolutionCombo" Height="32" Margin="0,0,0,15">
                                        <ComboBoxItem Content="1920x1080 (Full HD)" Tag="1080" IsSelected="True"/>
                                        <ComboBoxItem Content="1280x720 (HD)" Tag="720"/>
                                        <ComboBoxItem Content="854x480 (SD)" Tag="480"/>
                                        <ComboBoxItem Content="3840x2160 (4K)" Tag="2160"/>
                                    </ComboBox>
                                    
                                    <TextBlock Text="FRAME RATE" FontSize="8" Foreground="{StaticResource TextGray}" Margin="0,0,0,10"/>
                                    <ComboBox x:Name="FPSCombo" Height="32" Margin="0,0,0,20">
                                        <ComboBoxItem Content="30 FPS" Tag="30" IsSelected="True"/>
                                        <ComboBoxItem Content="60 FPS" Tag="60"/>
                                        <ComboBoxItem Content="24 FPS (Cinematic)" Tag="24"/>
                                    </ComboBox>
                                    
                                    <CheckBox x:Name="BurnCaptionsCheck" Content="Burn Captions to Video" Foreground="White" Margin="0,0,0,20"/>
                                    
                                    <Button x:Name="ExportButton" Content="EXPORT VIDEO" Style="{StaticResource PrimaryBtn}" 
                                            Height="40" Click="ExportButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- SPLITTER -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="{StaticResource BgDark}" 
                         ResizeDirection="Rows" ShowsPreview="True" Cursor="SizeNS"/>

            <!-- TIMELINE AREA -->
            <Border Grid.Row="2" Background="{StaticResource BgDark}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Timeline Tracks -->
                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="10">
                        <StackPanel Orientation="Horizontal">
                            <!-- Track Label -->
                            <Border Width="50" Background="{StaticResource BgPanel}" CornerRadius="4" Margin="0,0,10,0" 
                                   BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                <TextBlock Text="VIDEO" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextGray}" 
                                          VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock.LayoutTransform>
                                        <RotateTransform Angle="-90"/>
                                    </TextBlock.LayoutTransform>
                                </TextBlock>
                            </Border>

                            <!-- Timeline Clips - PANJANG untuk mudah cut -->
                            <ItemsControl x:Name="TimelineList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Card PANJANG: Width berdasarkan durasi video (min 200px, max 800px) -->
                                        <Border x:Name="ClipCard" MinWidth="200" MaxWidth="800" Height="60" Margin="0,0,5,0" 
                                               Background="{StaticResource BgPanel}" 
                                               CornerRadius="6" BorderBrush="{StaticResource AccentCyan}" BorderThickness="2" 
                                               MouseLeftButtonDown="TimelineItem_MouseLeftButtonDown" 
                                               ContextMenu="{StaticResource TimelineItemMenu}" ClipToBounds="True"
                                               ToolTip="{Binding FileName}">
                                            <Grid>
                                                <!-- Thumbnail Background -->
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Opacity="0.3" HorizontalAlignment="Left"/>
                                                
                                                <!-- Gradient Overlay -->
                                                <Border>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#AA000000" Offset="0"/>
                                                            <GradientStop Color="#00000000" Offset="0.3"/>
                                                            <GradientStop Color="#00000000" Offset="0.7"/>
                                                            <GradientStop Color="#AA000000" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                
                                                <!-- Content -->
                                                <Grid Margin="10,5">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    
                                                    <!-- File Name -->
                                                    <TextBlock Text="{Binding FileName}" FontSize="9" FontWeight="Bold" 
                                                              Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                                    
                                                    <!-- Thumbnail Preview -->
                                                    <Image Grid.Row="1" Source="{Binding Thumbnail}" Width="60" Height="35" 
                                                          Stretch="UniformToFill" HorizontalAlignment="Left" Margin="0,3"/>
                                                    
                                                    <!-- Duration & Controls -->
                                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding DurationStr}" FontSize="8" Foreground="{StaticResource AccentCyan}" 
                                                                  FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <Button Content="◀" FontSize="8" Width="20" Height="20" 
                                                               Style="{StaticResource IconBtn}" Click="MoveClipLeft_Click" Tag="{Binding}" 
                                                               ToolTip="Move Left" Margin="0,0,2,0"/>
                                                        <Button Content="▶" FontSize="8" Width="20" Height="20" 
                                                               Style="{StaticResource IconBtn}" Click="MoveClipRight_Click" Tag="{Binding}" 
                                                               ToolTip="Move Right"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Control Bar -->
                    <Border Grid.Row="1" Background="{StaticResource BgPureBlack}" Padding="15,10" 
                           BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="⏮" Style="{StaticResource IconBtn}" Width="35" Height="35" Click="JumpStart_Click"/>
                                <Button x:Name="PlayToggleBtn" Content="▶" Style="{StaticResource IconBtn}" Width="45" Height="35" 
                                       Click="TogglePlay_Click" Margin="5,0"/>
                                <Button Content="⏭" Style="{StaticResource IconBtn}" Width="35" Height="35" Click="JumpEnd_Click"/>
                                <TextBlock x:Name="DurationText" Text="00:00 / 00:00" Foreground="{StaticResource TextGray}" 
                                          VerticalAlignment="Center" Margin="15,0" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="QuickMuteBtn" Content="🔊" Style="{StaticResource IconBtn}" Width="35" Height="35" Click="Mute_Click"/>
                                <Slider x:Name="VolumeSlider" Width="100" VerticalAlignment="Center" Minimum="0" Maximum="100" 
                                       Value="50" Margin="10,0,0,0" ValueChanged="Volume_Changed"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- EXPORT PROGRESS OVERLAY -->
            <Border x:Name="ExportProgressPanel" Grid.RowSpan="3" Background="#DD000000" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">
                    <TextBlock x:Name="ExportStatusText" Text="EXPORTING..." Foreground="{StaticResource AccentYellow}" 
                              FontSize="16" FontWeight="Black" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="ExportProgressBar" Height="6" Foreground="{StaticResource AccentYellow}" 
                                Background="{StaticResource BgPanel}" BorderThickness="0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
