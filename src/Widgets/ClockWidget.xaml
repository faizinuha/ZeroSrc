<Window x:Class="ZeroMix.Widgets.ClockWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeroMix Clock"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="520"
        Height="320"
        Topmost="True"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush"  Color="#8BE9FD"/>
        <SolidColorBrush x:Key="WeatherBrush" Color="#FFD580"/>
        <SolidColorBrush x:Key="MutedBrush"   Color="#88FFFFFF"/>

        <Style x:Key="GlowText" TargetType="TextBlock">
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#8BE9FD" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainContainer">

        <!-- Time -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock x:Name="TimeDisplay"
                       Text="00:00"
                       FontSize="96"
                       FontWeight="Thin"
                       Foreground="White"
                       TextAlignment="Center"
                       Style="{StaticResource GlowText}"
                       FontFamily="Segoe UI Variable Display, Segoe UI Light"/>

            <TextBlock x:Name="DateDisplay"
                       Text="—"
                       FontSize="15"
                       FontWeight="Light"
                       Foreground="{StaticResource AccentBrush}"
                       TextAlignment="Center"
                       Opacity="0.85"
                       Margin="0,-6,0,0"
                       FontFamily="Segoe UI Variable Display, Segoe UI Light"/>

            <!-- Weather + UTC row -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,14,0,0" Opacity="0.7">

                <TextBlock x:Name="WeatherDisplay"
                           Text="⟳ Loading weather..."
                           Foreground="{StaticResource WeatherBrush}"
                           FontSize="12" Margin="0,0,18,0"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="UtcDisplay"
                           Text="UTC+00:00"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>

        </StackPanel>

        <!-- Hint -->
        <TextBlock Text="Double-click to close"
                   VerticalAlignment="Bottom" HorizontalAlignment="Center"
                   Foreground="White" Opacity="0.08" FontSize="10"
                   Margin="0,0,0,14">
            <TextBlock.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.25"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.25"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </TextBlock.Triggers>
        </TextBlock>

    </Grid>
</Window>
