<Window x:Class="ZeroMix.Widgets.DesktopWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeroMix Desktop"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="False"
        IsHitTestVisible="True"
        Loaded="Window_Loaded">

    <Grid x:Name="RootGrid">

        <!-- TOP RIGHT: Clock + Date (macOS style) -->
        <StackPanel x:Name="ClockPanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,40,40,0">

            <!-- Time -->
            <TextBlock x:Name="ClockText"
                       Text="00:00"
                       FontSize="72"
                       FontWeight="Thin"
                       FontFamily="Segoe UI Variable Display, Segoe UI Light"
                       Foreground="White"
                       HorizontalAlignment="Right"
                       Opacity="0.92">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#000000" Opacity="0.5"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- Date -->
            <TextBlock x:Name="DateText"
                       Text="Monday, January 1"
                       FontSize="16"
                       FontWeight="Light"
                       FontFamily="Segoe UI Variable Display, Segoe UI Light"
                       Foreground="White"
                       HorizontalAlignment="Right"
                       Opacity="0.65"
                       Margin="0,-6,0,0"/>

            <!-- Thin separator line -->
            <Border Height="1" Background="White" Opacity="0.15"
                    Margin="0,14,0,14" HorizontalAlignment="Stretch"/>

            <!-- System info pills -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Border x:Name="CpuPill" CornerRadius="10" Padding="10,4"
                        Background="#22FFFFFF" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CPU " Foreground="#88FFFFFF" FontSize="10"/>
                        <TextBlock x:Name="CpuText" Text="0%" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border x:Name="RamPill" CornerRadius="10" Padding="10,4"
                        Background="#22FFFFFF" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="RAM " Foreground="#88FFFFFF" FontSize="10"/>
                        <TextBlock x:Name="RamText" Text="0%" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border x:Name="BatPill" CornerRadius="10" Padding="10,4"
                        Background="#22FFFFFF">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="BAT " Foreground="#88FFFFFF" FontSize="10"/>
                        <TextBlock x:Name="BatText" Text="—" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- BOTTOM LEFT: macOS-style greeting + uptime -->
        <StackPanel x:Name="GreetPanel"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="40,0,0,80">

            <TextBlock x:Name="GreetText"
                       Text="Good morning"
                       FontSize="28"
                       FontWeight="Light"
                       FontFamily="Segoe UI Variable Display, Segoe UI Light"
                       Foreground="White"
                       Opacity="0.75">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#000000" Opacity="0.6"/>
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock x:Name="UptimeText"
                       Text="Uptime: —"
                       FontSize="11"
                       FontFamily="Segoe UI"
                       Foreground="White"
                       Opacity="0.35"
                       Margin="0,4,0,0"/>
        </StackPanel>

    </Grid>
</Window>
