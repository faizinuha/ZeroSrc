<Application x:Class="ZeroMix.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Central Design Tokens & Styles -->
                <ResourceDictionary Source="pack://application:,,,/Tools/Plugins/Styles.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Assets/Resources/Locales/en-US.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
