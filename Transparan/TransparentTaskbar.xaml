<Window x:Class="ZeroMix.TransparentTaskbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeroMix Taskbar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Height="60"
        Width="{Binding SystemParameters.PrimaryScreenWidth}"
        ResizeMode="NoResize"
        Topmost="True"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Colors for Glass Morphism -->
        <Color x:Key="GlassBackground">#0F0F0F</Color>
        <Color x:Key="GlassOverlay">#1A1A2E</Color>
        <Color x:Key="TextColor">#E0E0E0</Color>
        <Color x:Key="AccentColor">#00D9FF</Color>
        <Color x:Key="HoverColor">#2A2A3E</Color>

        <SolidColorBrush x:Key="GlassBrush" Color="#0A0D14" Opacity="0.95"/>
        <SolidColorBrush x:Key="TextBrush" Color="#EEF2F7"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00D9FF"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#303846" Opacity="0.8"/>

        <!-- Button Style -->
        <Style x:Key="TaskbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource GlassBrush}" 
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="0,0,0,2">
        <Border.Effect>
            <DropShadowEffect Color="#00D9FF" BlurRadius="10" ShadowDepth="1" Opacity="0.2"/>
        </Border.Effect>

        <Grid Margin="20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo Section -->
            <StackPanel Grid.Column="0" 
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Margin="0,0,30,0">
                <Grid>
                    <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="1" Width="24" Height="24"/>
                    <TextBlock Text="Z" 
                               FontSize="14" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="ZeroMix Bar"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{StaticResource TextBrush}"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Opacity="0.9"/>
            </StackPanel>

            <!-- Center Navigation -->
            <StackPanel Grid.Column="1" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left">
                <Button Style="{StaticResource TaskbarButton}" Content="Dashboard" Name="HomeTaskbarBtn" Click="HomeTaskbarBtn_Click" Margin="0,0,10,0"/>
                <Button Style="{StaticResource TaskbarButton}" Content="Statistics" Name="DashboardTaskbarBtn" Click="DashboardTaskbarBtn_Click" Margin="0,0,10,0"/>
                <Button Style="{StaticResource TaskbarButton}" Content="Plugins" Name="LauncherTaskbarBtn" Click="LauncherTaskbarBtn_Click" Margin="0,0,10,0"/>
                <Button Style="{StaticResource TaskbarButton}" Content="Settings" Name="SettingsTaskbarBtn" Click="SettingsTaskbarBtn_Click"/>
            </StackPanel>

            <!-- Stats & Clock Section -->
            <StackPanel Grid.Column="2" 
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="30,0,10,0">
                
                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,20,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CPU" FontSize="9" Foreground="{StaticResource TextBrush}" Opacity="0.6" Margin="0,0,5,0"/>
                        <TextBlock Name="CpuDisplay" Text="0%" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <ProgressBar Height="2" IsIndeterminate="False" Maximum="100" Name="CpuProgress" Value="0" Width="40" Background="#20FFFFFF" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,20,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="RAM" FontSize="9" Foreground="{StaticResource TextBrush}" Opacity="0.6" Margin="0,0,5,0"/>
                        <TextBlock Name="RamDisplay" Text="0%" FontSize="10" Foreground="LimeGreen" FontWeight="SemiBold"/>
                    </StackPanel>
                    <ProgressBar Height="2" IsIndeterminate="False" Maximum="100" Name="RamProgress" Value="0" Width="40" Background="#20FFFFFF" Foreground="LimeGreen" Margin="0,2,0,0"/>
                </StackPanel>

                <Border Width="1" Height="20" Background="#30FFFFFF" Margin="0,0,20,0"/>

                <TextBlock Name="TimeDisplay"
                           Text="00:00"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center"
                           FontFamily="Inter, Segoe UI"/>
            </StackPanel>

            <!-- Control Buttons -->
            <StackPanel Grid.Column="3" 
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource TaskbarButton}" Content="📌" Name="PinButton" Click="PinButton_Click" Margin="0,0,5,0"/>
                <Button Style="{StaticResource TaskbarButton}" Content="✕" Click="CloseTaskbarBtn_Click" Foreground="#FF5555"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
