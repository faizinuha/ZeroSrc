<Window
    x:Class="ZeroMix.Wallpapers"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Wallpaper Settings"
    Width="950"
    Height="700"
    AllowsTransparency="True"
    Background="Transparent"
    Loaded="Window_Loaded"
    MouseLeftButtonDown="Window_MouseLeftButtonDown"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Window.Resources>
        <!--  Updated Resources dengan UI/UX improvements  -->
        <ResourceDictionary>
            <Color x:Key="AccentColor">#0078D4</Color>
            <Color x:Key="ControlHoverColor">#E0E0E0</Color>
            <Color x:Key="ForegroundColor">#1C1C1C</Color>
            <Color x:Key="BackgroundColor">#F0F0F0</Color>
            <Color x:Key="SelectedColor">#00D9FF</Color>
            
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="ControlHoverBrush" Color="{StaticResource ControlHoverColor}" />
            <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
            <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
            <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}" />

            <Style x:Key="BaseButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.9" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.7" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FilterButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="FontSize" Value="11" />
            </Style>

            <Style x:Key="SecondaryButton" BasedOn="{StaticResource BaseButton}" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource ControlHoverBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
            </Style>

            <Style x:Key="CloseButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#888888" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="Transparent">
                                <Path x:Name="xpath" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L10,10 M10,0 L0,10" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#E81123" />
                                    <Setter TargetName="xpath" Property="Stroke" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="WallpaperImageStyle" TargetType="Image">
                <Setter Property="Width" Value="160" />
                <Setter Property="Height" Value="100" />
                <Setter Property="Stretch" Value="UniformToFill" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
                <Setter Property="RenderOptions.EdgeMode" Value="Aliased" />
            </Style>

            <Style x:Key="WallpaperBorderStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="#CCC" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Margin" Value="6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="White" />
                <Setter Property="Opacity" Value="0" />
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.95" ScaleY="0.95" CenterX="85" CenterY="55" />
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        <Setter Property="Background" Value="#F5F5F5" />
                    </Trigger>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.95" To="1" Duration="0:0:0.2" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.95" To="1" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SelectedBorderStyle" TargetType="Border" BasedOn="{StaticResource WallpaperBorderStyle}">
                <Setter Property="BorderBrush" Value="{StaticResource SelectedBrush}" />
                <Setter Property="BorderThickness" Value="3" />
                <Setter Property="Background" Value="#E0F7FF" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="10" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Opacity="0.15" ShadowDepth="1" Color="Black" />
        </Border.Effect>
        <Border Background="#FAFAFA" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Border Grid.Row="0" Background="#F8F8F8" BorderBrush="#DDD" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Margin="20,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="#1C1C1C" Text="🖼️ Wallpaper Manager" />
                        <Button Name="CloseButton" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,15,0" Click="CloseButton_Click" Style="{StaticResource CloseButton}" ToolTip="Close" />
                    </Grid>
                </Border>

                <!-- Search & Filter Bar -->
                <Border Grid.Row="1" Background="White" BorderBrush="#EEE" BorderThickness="0,0,0,1" Margin="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                        <!-- Search Box -->
                        <Border Width="180" Height="32" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Margin="0,0,15,0">
                            <TextBox Name="SearchBox" Padding="10,8" TextChanged="SearchBox_TextChanged" Foreground="#666" ToolTip="Search wallpapers by name" Background="Transparent" BorderThickness="0" />
                        </Border>

                        <!-- Filter Buttons -->
                        <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11" Foreground="#666" FontWeight="SemiBold"/>
                        <Button Name="FilterAllBtn" Content="📋 All" Click="FilterBtn_Click" Style="{StaticResource FilterButton}" Margin="0,0,5,0" />
                        <Button Name="FilterImagesBtn" Content="🖼️ Images" Click="FilterBtn_Click" Style="{StaticResource FilterButton}" Margin="0,0,5,0" />
                        <Button Name="FilterVideosBtn" Content="🎬 Videos" Click="FilterBtn_Click" Style="{StaticResource FilterButton}" Margin="0,0,5,0" />
                        <Button Name="FilterAnimatedBtn" Content="✨ Animated" Click="FilterBtn_Click" Style="{StaticResource FilterButton}" Margin="0,0,15,0" />

                        <!-- Random Button -->
                        <Button Name="RandomBtn" Content="🎲 Random" Click="RandomBtn_Click" Style="{StaticResource BaseButton}" Margin="0,0,5,0" Width="90" />
                        
                        <!-- Count Label -->
                        <TextBlock Name="CountLabel" Text="0 items" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11" Foreground="#999" />
                    </StackPanel>
                </Border>

                <!-- Wallpaper Grid (Virtualized) -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl Name="WallpaperListPanel">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource WallpaperBorderStyle}" MouseLeftButtonUp="WallpaperBorder_MouseLeftButtonUp">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}" Style="{StaticResource WallpaperImageStyle}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8" Foreground="White" FontSize="10" FontWeight="SemiBold" Background="#00000088" Padding="4" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" Margin="15" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Action Footer -->
                <Border Grid.Row="3" Background="#F8F8F8" BorderBrush="#DDD" BorderThickness="0,1,0,0" Margin="0" Padding="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Status Label -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Name="StatusLabel" Text="Select a wallpaper to preview" FontSize="12" Foreground="#666" />
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Name="BrowseButton" Content="📂 Browse..." Click="BrowseButton_Click" Style="{StaticResource SecondaryButton}" Width="110" Margin="0,0,10,0"/>
                            <Button Name="SetWallpaperButton" Content="✓ Set as Wallpaper" Click="SetWallpaperButton_Click" Style="{StaticResource BaseButton}" Width="150" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
